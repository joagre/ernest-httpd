#!/bin/sh
# The launcher: ern run on the program named as this file is (docs/design.md
# §13). Its root is ../lib/NAME/ where NAME's compiled form stands there,
# beside an installed launcher, and .. otherwise, a checkout or an unpacked
# release. The root is the run's root package, so the packages its
# package.conf names are on the load path (report §11.9), and so is the
# program's own Erlang: its ebin/ in an installation and an unpacked release,
# and each application under erl/ in a checkout, through --libs-dir. A
# leading --config-dir dir, the one option an operator gives, goes to ern run
# (report §11.2, §8.3); everything after it goes to the program. The working
# directory stays the caller's.
here=$(cd "$(dirname "$0")/.." && pwd) || exit 1
name=$(basename "$0")
root=$here
[ -f "$here/lib/$name/build/$name.erc" ] && root=$here/lib/$name
config=
if [ "$1" = "--config-dir" ]; then
    config=$2
    shift 2
fi
set -- --package-dir "$root" "$root/build/$name.erc" "$@"
[ -d "$root/erl" ] && set -- --libs-dir "$root/erl" "$@"
[ -d "$root/ebin" ] && set -- --load-path "$root/ebin" "$@"
[ -n "$config" ] && set -- --config-dir "$config" "$@"
exec "${ERN:-ern}" run "$@"
