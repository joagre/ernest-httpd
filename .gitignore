# What ern build writes, for each source root
build/
*.erc

# The packages package.conf names, each archive and what ern unpack made of it
lib/

# What make xterm fills: the example site's terminal, fetched
examples/site/root/xterm/

# What make release stages its archive in
stage/

# A node's private key, in its configuration directory
private-key.pem

# Editors
*~
\#*\#
.\#*
*.swp
.DS_Store
