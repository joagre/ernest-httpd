# What ern build writes, for each source root
build/
test/build/
tools/build/
examples/build/
*.erc

# What make lib fills: each dependency unpacked, each Erlang application linked
lib/

# What make xterm fills: the example site's terminal, fetched
examples/site/root/xterm/

# A node's configuration directory holds a private key
.ernest/

# Editors
*~
\#*\#
.\#*
.swp
.DS_Store
