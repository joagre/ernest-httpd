/// The smoke test: the checks run against a deployed site, each said on
/// standard output as a line, and the program's status whether every one
/// passed (design §13).
///
/// `main` takes the site's canonical host and the path of its
/// configuration, `deploy/config.json` for the deployed site, and runs the
/// checks the configuration takes against the host over TLS on the port of
/// its first `tls` listener, the far end's certificate verified against the
/// host's bundle, `/etc/ssl/certs/ca-certificates.crt`, and over plain HTTP
/// on the port of its first `redirect` listener, the shell's where the
/// configuration has a `shell`, at its path, from the origin a page of the
/// site sends, `https://` and the host, with `:` and the port where it is
/// not 443. It prints each check's line, the check's name and `: ok`, or
/// `: failed: ` and what came, and exits with the status 0 where every
/// check passed and 1 otherwise. It refuses another count of arguments
/// with `usage: smoke host config.json` on standard error and the status 2,
/// and a configuration it cannot read, whose text `Config.parse` refuses,
/// that has no redirect host, or that lacks a `tls` or a `redirect`
/// listener, with `smoke: `, the path, `: ` and `Config.reason` on standard
/// error and the status 2, the last two as
/// `redirect-hosts must not be empty: []` and
/// `listeners must hold a tls listener and a redirect listener`; the rules
/// of the file system's are not checked, since the files they name are the
/// machine's.
///
/// `checks` runs the same checks against any site, over the scheme its port
/// takes, `https` or `http`: `/` answered 200; `/` on the redirect port,
/// and `/` for the redirect host it is given, the configuration's first,
/// each answered 301 to `https://`, the host and `/`; `/` for a host that
/// is neither, `elsewhere`, answered 421; and where it is given the shell's
/// path and its client's, the client answered 200 as
/// `text/javascript; charset=utf-8` (design §14), and the shell's path
/// upgraded from the origin, a resize of 24 rows by 80
/// columns attaching a new session, `{"attached": "new"}`, `1 + 2` and a
/// line feed typed as keys answering output that holds `3 : Int` within
/// 5000 milliseconds, its type dimmed as the shell writes it at a terminal
/// or plain where `NO_COLOR` is set, and a stop closing with 4004. Each
/// check opens a connection of its own, so that one that fails says what
/// came and the next runs as any.
///
/// The checks' requests are the end-to-end tests' too: a GET's response,
/// `get`; an upgrade's, `upgrade`; a message framed as a client frames it,
/// `masked`; and a shell's attach and its output read until a test passes,
/// `readOutput`. So is the server they run against, started by its
/// launcher on a configuration, `launch`, and ended by the termination
/// signal, `terminate`.
///
/// ## Examples
///
/// Against the deployed site, from a checkout or an unpacked release:
///
/// ```sh
/// make smoke HOST=ernest-lang.org
/// ```
///
/// which runs `ern run build/smoke.erc ernest-lang.org deploy/config.json`.

//
// Types
//

/// A check run: its name, and `Right(Unit)` where it passed or what came
/// where it failed.
export type Check = Check(name : String, result : Either(String, Unit))

//
// Program
//

/// The checks the configuration the second argument names takes, run
/// against the site of the host the first names, over TLS on the port of
/// its first `tls` listener and plain HTTP on its first `redirect`
/// listener's, each check's line printed, and the status 0 where every one
/// passed and 1 otherwise.
export fn main() : Unit =
    match Os.arguments {
        [host, path] ->
            match configured(path) {
                Right(#(config, redirectHost, port, redirectPort)) -> {
                    let paths = Optional.map(config.shell, fn(shell) = #(shell.path, shell.client));
                    let checked =
                        checks("https",
                               host,
                               port,
                               redirectPort,
                               redirectHost,
                               paths,
                               origin(host, port));
                    List.forEach(checked, fn(check) = Io.println(line(check)));
                    Os.exit(if List.all(checked, passed) then 0 else 1)
                }
              | Left(error) -> {
                    Io.printlnError("smoke: " <> path <> ": " <> Config.reason(error));
                    Os.exit(2)
                }
            }
      | _ -> {
            Io.printlnError("usage: smoke host config.json");
            Os.exit(2)
        }
    }

// The configuration of the file's text, read within fileMs, every rule but
// the file system's checked: the files those rules name are the deployed
// machine's, not the smoke test's; its first redirect host, whose check it
// takes, refused as an Invalid where it has none; and the ports of its
// first tls listener and its first redirect listener, which the checks run
// on, refused as an Invalid where it lacks either.
fn configured(path : String) : Either(Config.Error, #(Config.Config, String, Int, Int)) = {
    let bytes <- Either.mapLeft(Fs.read(Path(path), fileMs), Config.Unreadable);
    let text <- Either.fromOptional(String.fromUtf8(bytes), Config.Unreadable(Io.NotUtf8(bytes)));
    let config <- Config.parse(text);
    let redirectHost <- match config.redirectHosts {
        first :: _ ->
            Right(first)
      | [] ->
            Left(Config.Invalid(field = "redirect-hosts",
                                rule = "not be empty",
                                value = Some("[]")))
    };
    match #(firstPort(config, isTls), firstPort(config, isRedirect)) {
        #(Some(port), Some(redirectPort)) ->
            Right(#(config, redirectHost, port, redirectPort))
      | _ ->
            Left(Config.Invalid(field = "listeners",
                                rule = "must hold a tls listener and a redirect listener",
                                value = None))
    }
}

// The port of the configuration's first listener whose kind passes the
// test, where it has one.
fn firstPort(config : Config.Config, test : (Config.Kind) -> Bool) : Optional(Int) =
    Optional.map(List.find(config.listeners, fn(listener) = test(listener.kind)),
                 fn(listener) = listener.port)

fn isTls(kind : Config.Kind) : Bool =
    match kind {
        Config.Tls() -> true
      | _ -> false
    }

fn isRedirect(kind : Config.Kind) : Bool =
    match kind {
        Config.Redirect() -> true
      | _ -> false
    }

// The origin a page of the site on the port sends: `https://` and the
// host, and `:` and the port where it is not HTTPS's own, 443.
fn origin(host : String, port : Int) : String =
    if port == 443 then "https://" <> host else "https://" <> host <> ":" <> Int.toString(port)

// The milliseconds the configuration's file is read within.
let fileMs : Int = 5000

// A check's line: its name, and `: ok` where it passed or `: failed: ` and
// what came where it failed.
fn line(check : Check) : String =
    match check.result {
        Right(Unit) -> check.name <> ": ok"
      | Left(came) -> check.name <> ": failed: " <> came
    }

fn passed(check : Check) : Bool =
    check.result == Right(Unit)

//
// The checks
//

// The host's bundle of the certificate authorities, which a site's
// certificate is verified against over TLS.
let bundle : Path = Path("/etc/ssl/certs/ca-certificates.crt")

// The milliseconds each connect, write and read of a check waits.
let socketMs : Int = 5000

// The milliseconds the shell has, from the keys written, to answer them
// with output that holds `3 : Int`: a session started and its program's
// answer.
let answerMs : Int = 5000

/// The checks run against the site of the host on the port, over the
/// scheme, `https` or `http`, on the redirect port over plain HTTP, and for
/// the redirect host, and, where the shell's path and its client's are
/// given, the client's response and the shell's upgrade from the origin,
/// each with its name and what came where it failed, in the order the
/// module's documentation gives them.
export fn checks(scheme : String,
                 host : String,
                 port : Int,
                 redirectPort : Int,
                 redirectHost : String,
                 shell : Optional(#(String, String)),
                 origin : String) : List(Check) = {
    let canonical = "https://" <> host <> "/";
    let site = scheme <> "://" <> host <> ":" <> Int.toString(port);
    let redirect = "http://" <> host <> ":" <> Int.toString(redirectPort);
    [Check(name = site <> "/ answers 200",
           result = answered(opened(scheme, host, port), host, "200")),
     Check(name = redirect <> "/ answers 301 to " <> canonical,
           result = answered(opened("http", host, redirectPort), host, "301 " <> canonical)),
     Check(name = site <> "/ for " <> redirectHost <> " answers 301 to " <> canonical,
           result = answered(opened(scheme, host, port), redirectHost, "301 " <> canonical)),
     Check(name = site <> "/ for elsewhere answers 421",
           result = answered(opened(scheme, host, port), "elsewhere", "421"))]
        <> match shell {
            Some(#(path, client)) ->
                [Check(name = site <> client <> " answers 200 as " <> javascript,
                       result = clientAnswered(opened(scheme, host, port), client, host)),
                 Check(name = site <> path <> " runs 1 + 2 and closes with 4004 at a stop",
                       result = shellAnswered(opened(scheme, host, port), path, host, origin))]
          | None ->
                []
        }
}

// The client's content type, which a module's import requires.
let javascript : String = "text/javascript; charset=utf-8"

// A connection to the host's port: over TLS, the far end's certificate
// verified against the bundle, for https, and plain for http; another
// scheme is refused.
fn opened(scheme : String, host : String, port : Int) : Either(String, Address(Tcp.SocketMsg)) =
    match scheme {
        "https" ->
            Either.mapLeft(Tcp.connectTls(host, port, Tcp.Verified(bundle), socketMs), Io.show)
      | "http" ->
            Either.mapLeft(Tcp.connect(host, port, socketMs), Io.show)
      | _ ->
            Left("the scheme " <> scheme <> " is neither https nor http")
    }

// What a GET of / naming the host answers over the connection, which is
// then closed, compared with what is wanted: its status, and its Location
// after a space where it has one.
fn answered(connection : Either(String, Address(Tcp.SocketMsg)),
            host : String,
            wanted : String) : Either(String, Unit) = {
    let socket <- connection;
    let got = Either.map(get(socket, "/", host, socketMs), shown);
    Tcp.close(socket);
    let came <- Either.mapLeft(got, Io.show);
    if came == wanted then Right(Unit) else Left(came)
}

// What a GET of the client's path naming the host answers over the
// connection, which is then closed: its status and its Content-Type, 200
// and JavaScript wanted.
fn clientAnswered(connection : Either(String, Address(Tcp.SocketMsg)),
                  client : String,
                  host : String) : Either(String, Unit) = {
    let socket <- connection;
    let got = get(socket, client, host, socketMs);
    Tcp.close(socket);
    let #(response, _) <- Either.mapLeft(got, Io.show);
    let came =
        Int.toString(response.status)
            <> " "
            <> Optional.withDefault(Http.header(response.headers, "Content-Type"), "with no type");
    if came == "200 " <> javascript then Right(Unit) else Left(came)
}

// A response as a check compares it: its status, and its Location after a
// space where it has one.
fn shown(#(response, _) : #(Http.Response, Bytes)) : String =
    match Http.header(response.headers, "Location") {
        Some(location) -> Int.toString(response.status) <> " " <> location
      | None -> Int.toString(response.status)
    }

// The shell's check at the path over the connection, which is then
// closed.
fn shellAnswered(connection : Either(String, Address(Tcp.SocketMsg)),
                 path : String,
                 host : String,
                 origin : String) : Either(String, Unit) = {
    let socket <- connection;
    let result = shellOver(socket, path, host, origin);
    Tcp.close(socket);
    result
}

// The shell's path upgraded from the origin, answered 101; the terminal
// resized to 24 by 80 and `1 + 2` and a line feed typed, answered within
// answerMs by the attach of a new session and output that holds `3 : Int`;
// and a stop, answered by a close of 4004, the output before it passed
// over.
fn shellOver(socket : Address(Tcp.SocketMsg),
             path : String,
             host : String,
             origin : String) : Either(String, Unit) = {
    let #(response, carried) <-
        Either.mapLeft(upgrade(socket, path, host, origin, socketMs), Io.show);
    let _ <- if response.status == 101 then Right(Unit) else Left(shown(#(response, <<>>)));
    let typed =
        masked(WebSocket.Text("{\"resize\": [24, 80]}"))
            <> masked(WebSocket.Binary(String.toUtf8("1 + 2\n")));
    let _ <- Either.mapLeft(Tcp.write(socket, typed, socketMs), Io.show);
    // the server's messages, a piece of the terminal's output each, of at
    // most 1 MiB
    let decoder = WebSocket.decoder(WebSocket.FromServer, 1048576);
    let #(attached, _, rest) <- readOutput(socket, decoder, carried, holdsTheAnswer, answerMs);
    let _ <- if attached == "new" then
        Right(Unit)
    else
        Left("attached " <> attached <> ", not new");
    let _ <-
        Either.mapLeft(Tcp.write(socket, masked(WebSocket.Text("{\"stop\": true}")), socketMs),
                       Io.show);
    let code <- closeCode(socket, rest, <<>>);
    if code == 4004 then Right(Unit) else Left("Close(" <> Int.toString(code) <> ")")
}

// Whether the output holds `3 : Int` as the shell writes it at a terminal,
// its type dimmed, or plain where the environment's NO_COLOR is set.
fn holdsTheAnswer(output : Bytes) : Bool =
    List.any(["3" <> Ansi.styled(" : Int", Ansi.Dim), "3 : Int"],
             fn(text) = Bytes.contains(output, String.toUtf8(text)))

// The code of the next close the socket carries, the bytes carried first
// and the binary messages before it passed over; what came instead where
// another message, an error or the connection's end comes first.
fn closeCode(socket : Address(Tcp.SocketMsg),
             decoder : WebSocket.Decoder,
             carried : Bytes) : Either(String, Int) = {
    let #(messages, rest) <- Either.mapLeft(WebSocket.decode(decoder, carried), Io.show);
    match List.filter(messages, fn(message) = !isBinary(message)) {
        WebSocket.Close(code = Some(code)) :: _ ->
            Right(code)
      | message :: _ ->
            Left(Io.show(message))
      | [] ->
            match Tcp.read(socket, socketMs) {
                Right(bytes) -> closeCode(socket, rest, bytes)
              | Left(Io.Closed) -> Left("closed")
              | Left(error) -> Left(Io.show(error))
            }
    }
}

fn isBinary(message : WebSocket.Message) : Bool =
    match message {
        WebSocket.Binary(_) -> true
      | _ -> false
    }

//
// The requests
//

/// The response to a GET of the target naming the host, written to the
/// socket, and its body, of at most 16 MiB; the write, the head and the
/// body each within the milliseconds. A response that is no HTTP/1.1
/// answers `Other` and what is wrong with it.
export fn get(socket : Address(Tcp.SocketMsg),
              target : String,
              host : String,
              ms : Int) : Either(Io.Error, #(Http.Response, Bytes)) = {
    let request = requested(target, [Http.Header(name = "Host", value = host)]);
    let _ <- Either.mapLeft(Http.writeRequest(socket, request, <<>>, ms), ioError);
    let #(response, rest) <-
        Either.mapLeft(Http.readResponse(socket, <<>>, Http.defaultLimits, ms), ioError);
    let #(body, _) <-
        Either.mapLeft(Http.readResponseBody(socket, rest, response, 16777216, ms), ioError);
    Right(#(response, body))
}

/// The response to an upgrade of the target to a WebSocket, naming the
/// host and from the origin, its key 16 bytes of its own, written to the
/// socket, and the bytes after the response's head; the write and the head
/// each within the milliseconds. A response that is no HTTP/1.1 answers
/// `Other` and what is wrong with it.
export fn upgrade(socket : Address(Tcp.SocketMsg),
                  target : String,
                  host : String,
                  origin : String,
                  ms : Int) : Either(Io.Error, #(Http.Response, Bytes)) = {
    let request =
        requested(target,
                  [Http.Header(name = "Host", value = host),
                   Http.Header(name = "Upgrade", value = "websocket"),
                   Http.Header(name = "Connection", value = "Upgrade"),
                   Http.Header(name = "Sec-WebSocket-Version", value = "13"),
                   Http.Header(name = "Origin", value = origin),
                   Http.Header(name = "Sec-WebSocket-Key",
                               value = Base64.encode(Crypto.randomBytes(16)))]);
    let _ <- Either.mapLeft(Http.writeRequest(socket, request, <<>>, ms), ioError);
    Either.mapLeft(Http.readResponse(socket, <<>>, Http.defaultLimits, ms), ioError)
}

/// The message as a client sends it: one frame masked with a key of its
/// own, `Crypto.randomBytes(4)`.
export fn masked(message : WebSocket.Message) : Bytes =
    Optional.withDefault(WebSocket.encodeMasked(message, Crypto.randomBytes(4)), <<>>)

/// A shell's attach and its output, the messages the socket carries after
/// a resize that attaches it, the bytes carried first, decoded with the
/// decoder: the text of the attach's completion, `{"attached": word}`,
/// first, and then binary messages until the test passes of what they hold
/// together, read within the milliseconds. It answers the word, `new` or
/// `joined`, what the binary messages hold and the decoder after them, or
/// what came instead, the output shown and then the message, the error or
/// the time that came before the test passed.
export fn readOutput(socket : Address(Tcp.SocketMsg),
                     decoder : WebSocket.Decoder,
                     carried : Bytes,
                     test : (Bytes) -> Bool,
                     ms : Int) : Either(String, #(String, Bytes, WebSocket.Decoder)) =
    outputUntil(socket, decoder, carried, test, None, <<>>, Clock.monotonic() + ms)

// The attach's word and the output read on until the test passes or the
// time, a monotonic one, comes.
fn outputUntil(socket : Address(Tcp.SocketMsg),
               decoder : WebSocket.Decoder,
               carried : Bytes,
               test : (Bytes) -> Bool,
               attached : Optional(String),
               acc : Bytes,
               time : Int) : Either(String, #(String, Bytes, WebSocket.Decoder)) = {
    let #(messages, rest) <-
        Either.mapLeft(WebSocket.decode(decoder, carried),
                       fn(error) = following(acc, Io.show(error)));
    let #(word, output) <- List.tryFold(messages, #(attached, acc), taken);
    let left = time - Clock.monotonic();
    match word {
        Some(said) when test(output) ->
            Right(#(said, output, rest))
      | _ when left <= 0 ->
            Left(following(output, "nothing more within the time"))
      | _ ->
            match Tcp.read(socket, left) {
                Right(bytes) -> outputUntil(socket, rest, bytes, test, word, output, time)
              | Left(Io.Timeout) -> Left(following(output, "nothing more within the time"))
              | Left(error) -> Left(following(output, Io.show(error)))
            }
    }
}

// A message taken after the attach's word and the output before it: the
// attach's text first, and then binary messages; any other message is what
// came instead.
fn taken(#(attached, output) : #(Optional(String), Bytes),
         message : WebSocket.Message) : Either(String, #(Optional(String), Bytes)) =
    match #(attached, message) {
        #(None, WebSocket.Text(text)) ->
            match attachedWord(text) {
                Some(word) -> Right(#(Some(word), output))
              | None -> Left(following(output, Io.show(message)))
            }
      | #(Some(_), WebSocket.Binary(bytes)) ->
            Right(#(attached, output <> bytes))
      | _ ->
            Left(following(output, Io.show(message)))
    }

// The word of the text `{"attached": word}`, read through Json.
fn attachedWord(text : String) : Optional(String) =
    match Json.parse(text) {
        Right(Json.Object(members)) ->
            match Map.toList(members) {
                [#("attached", Json.Text(word))] -> Some(word)
              | _ -> None
            }
      | _ ->
            None
    }

// The output shown, as text where it is UTF-8, and what came after it.
fn following(output : Bytes, came : String) : String = {
    let text = match String.fromUtf8(output) {
        Some(written) -> Io.show(written)
      | None -> Io.show(output)
    };
    "output " <> text <> " then " <> came
}

// A request of HTTP/1.1 for the target with the headers.
fn requested(target : String, headers : List(Http.Header)) : Http.Request =
    Http.Request(method = "GET", =target, version = Http.http11, =headers)

// An error over the socket as the socket's, a response that is no HTTP/1.1
// written as `Other`.
fn ioError(error : Http.SocketError) : Io.Error =
    match error {
        Http.Socket(cause) -> cause
      | Http.Protocol(cause) -> Io.Other("the response is " <> Io.show(cause))
    }

//
// The server under test
//

/// The server started by its launcher, `bin/ernest_httpd` from the
/// repository's root, on the configuration at the path, whose listeners,
/// the count of them, are on `127.0.0.1`, each line read within 30000
/// milliseconds. It answers the running program, for `terminate`, and the
/// port each listener says it listens on, in the configuration's order. A
/// line that is not `listening on 127.0.0.1:` and a port answers `Other`
/// naming it, and a program that exits first `Other` with its status and
/// what it said.
export fn launch(path : String,
                 count : Int) : Either(Io.Error, #(Address(Os.ProgramMsg), List(Int))) = {
    let program <- Os.start(Os.command("bin/ernest_httpd", [path]));
    let out <- said(program, "", count);
    let ports <- List.tryMap(String.lines(out), portSaid);
    Right(#(program, ports))
}

// What the running program writes to standard output until its lines are
// the count.
fn said(program : Address(Os.ProgramMsg), acc : String, count : Int) : Either(Io.Error, String) =
    if List.size(String.lines(acc)) >= count && String.endsWith(acc, "\n") then
        Right(acc)
    else match Os.read(program, 30000) {
        Right(Os.Stdout(bytes)) ->
            said(program, acc <> Optional.withDefault(String.fromUtf8(bytes), "?"), count)
      | Right(Os.Stderr(_)) ->
            said(program, acc, count)
      | Right(Os.Exited(status)) ->
            Left(Io.Other("exited with " <> Int.toString(status) <> " after " <> acc))
      | Left(error) ->
            Left(error)
    }

// The port of a line `listening on 127.0.0.1:` and the port, as the
// launcher says it and nothing else.
fn portSaid(line : String) : Either(Io.Error, Int) = {
    let prefix = "listening on 127.0.0.1:";
    match String.toInt(String.replace(line, prefix, "")) {
        Some(port) when prefix <> Int.toString(port) == line -> Right(port)
      | _ -> Left(Io.Other("said " <> Io.show(line)))
    }
}

/// The server `launch` started told to end by the termination signal, and
/// its status once it has exited, read within 30000 milliseconds, what it
/// writes before left unread; a server that exited before it was told
/// answers its status the same way.
export fn terminate(program : Address(Os.ProgramMsg)) : Either(Io.Error, Int) =
    match Os.signal(program, Os.Termination) {
        Right(Unit) or Left(Io.Closed) -> exited(program)
      | Left(error) -> Left(error)
    }

// The running program's status once it has exited.
fn exited(program : Address(Os.ProgramMsg)) : Either(Io.Error, Int) =
    match Os.read(program, 30000) {
        Right(Os.Exited(status)) -> Right(status)
      | Right(_) -> exited(program)
      | Left(error) -> Left(error)
    }

//
// Tests
//

// The scratch directory the tests write their site and configuration
// under, from the repository's root, where make test runs them.
let scratch : String = "build/scratch/smoke"

// The scratch site's configuration: a plain and a redirect listener on the
// loopback, ports the host picks, the host localhost and its redirect host
// www.localhost, and a shell on the site's path from http://localhost,
// whose command answers the first line typed with `3 : Int` and then
// copies the terminal, as a stand-in for `ern shell`.
let configuration : String =
    "{\"listeners\": [{\"kind\": \"plain\", \"address\": \"127.0.0.1\", \"port\": 0},\n"
        <> "  {\"kind\": \"redirect\", \"address\": \"127.0.0.1\", \"port\": 0, \"acme-challenge\": \""
        <> scratch
        <> "/acme\"}],\n"
        <> " \"root\": \""
        <> scratch
        <> "/site\", \"canonical-host\": \"localhost\", \"redirect-hosts\": [\"www.localhost\"],\n"
        <> " \"timeouts\": {\"head\": 5000, \"idle\": 60000, \"write\": 5000, \"file\": 5000},\n"
        <> " \"limits\": {\"request-line\": 1024, \"headers\": 4096,\n"
        <> "            \"connections\": 16, \"connections-per-address\": 16},\n"
        <> " \"content-types\": {}, \"headers\": {}, \"access-log\": \""
        <> scratch
        <> "/access.log\",\n"
        <> " \"shell\": {\"path\": \"/shell/session\", \"client\": \"/shell/client.js\",\n"
        <> "           \"origins\": [\"http://localhost\"],\n"
        <> "           \"command\": [\"sh\", \"-c\", \"read line && echo '3 : Int' && exec cat\"],\n"
        <> "           \"most-at-once\": 2, \"starts\": {\"count\": 10, \"within\": 60000},\n"
        <> "           \"lifetime\": 60000, \"warning\": 30000,\n"
        <> "           \"message-limit\": 1024, \"hangup\": 1000}}\n"

// The scratch site written, its page, the challenge's directory and the
// configuration, and the configuration's path.
fn written() : Either(Io.Error, String) = {
    let path = scratch <> "/config.json";
    let _ <- Fs.makeDir(Path(scratch <> "/site"), 5000);
    let _ <- Fs.makeDir(Path(scratch <> "/acme"), 5000);
    let _ <- Fs.write(Path(scratch <> "/site/index.html"), String.toUtf8("<p>smoke</p>\n"), 5000);
    let _ <- Fs.write(Path(path), String.toUtf8(configuration), 5000);
    Right(path)
}

// design §13: the checks against a site, the scratch site served by the
// launcher over plain HTTP: every check passes and says `: ok` against the
// site whose host, redirect host, listeners and shell they check, the
// client answered as JavaScript, the shell's stand-in answering the keys
// typed and the stop closing with 4004; given no shell's paths, the four
// checks of the rest alone pass; against the same site from an origin it
// does not take, the shell's check fails and says what came, the 403,
// while the rest pass, the client's among them; given a redirect
// host the site does not have, its check fails with the 421, the check
// asking for the host it is given; and against a port where nothing
// listens every check fails and says `Io.Refused`, each in a connection of
// its own. get, upgrade, masked and readOutput are the
// requests they run with, and launch and terminate start and end the server
// they run against.
let checksASite = Test.Case(name = "checks a site and says what came", run = fn() = {
    let result = {
        let path <- written();
        let #(program, ports) <- launch(path, 2);
        let #(plainPort, redirectPort) = match ports {
            [one, two] -> #(one, two)
          | _ -> #(0, 0)
        };
        let shell = Some(#("/shell/session", "/shell/client.js"));
        let redirectHost = "www.localhost";
        let passing =
            checks("http",
                   "localhost",
                   plainPort,
                   redirectPort,
                   redirectHost,
                   shell,
                   "http://localhost");
        let withoutShell =
            checks("http",
                   "localhost",
                   plainPort,
                   redirectPort,
                   redirectHost,
                   None,
                   "http://localhost");
        let refused =
            checks("http",
                   "localhost",
                   plainPort,
                   redirectPort,
                   redirectHost,
                   shell,
                   "http://elsewhere");
        let elsewhere =
            checks("http",
                   "localhost",
                   plainPort,
                   redirectPort,
                   "elsewhere",
                   None,
                   "http://localhost");
        let closed <- Tcp.listen("127.0.0.1", 0);
        let nothing <- Tcp.port(closed);
        Tcp.closeListener(closed);
        let unanswered =
            checks("http", "localhost", nothing, nothing, redirectHost, shell, "http://localhost");
        let status <- terminate(program);
        Right(#(List.map(passing, line),
                List.map(withoutShell, line),
                List.map(refused, line),
                List.map(elsewhere, line),
                List.map(unanswered, line),
                status,
                plainPort,
                redirectPort,
                nothing))
    };
    match result {
        Right(#(passing,
                withoutShell,
                refused,
                elsewhere,
                unanswered,
                status,
                plainPort,
                redirectPort,
                nothing)) -> {
            let named = fn(port, redirect) = {
                let site = "http://localhost:" <> Int.toString(port);
                [site <> "/ answers 200",
                 "http://localhost:"
                     <> Int.toString(redirect)
                     <> "/ answers 301 to https://localhost/",
                 site <> "/ for www.localhost answers 301 to https://localhost/",
                 site <> "/ for elsewhere answers 421",
                 site <> "/shell/client.js answers 200 as text/javascript; charset=utf-8",
                 site <> "/shell/session runs 1 + 2 and closes with 4004 at a stop"]
            };
            let ok = List.map(named(plainPort, redirectPort), fn(name) = name <> ": ok");
            let shellName =
                "http://localhost:"
                    <> Int.toString(plainPort)
                    <> "/shell/session runs 1 + 2 and closes with 4004 at a stop";
            let site = "http://localhost:" <> Int.toString(plainPort);
            let misdirected =
                List.take(ok, 2)
                    <> [site <> "/ for elsewhere answers 301 to https://localhost/: failed: 421"]
                    <> List.take(List.drop(ok, 3), 1);
            Test.equal(#(passing, withoutShell, refused, elsewhere, unanswered, status),
                       #(ok,
                         List.take(ok, 4),
                         List.take(ok, 5) <> [shellName <> ": failed: 403"],
                         misdirected,
                         List.map(named(nothing, nothing),
                                  fn(name) = name <> ": failed: Io.Refused"),
                         143))
        }
      | Left(error) ->
            Test.Failed(Io.show(error))
    }
})

// design §13: the end of a program that exited before it was told, its
// status read as a told one's is. A regression test, written after
// `terminate` sent the signal by `Os.signal`: it tells no server, which
// the case above ends.
let answersAnEndedProgram =
    Test.Case(name = "answers the status of a program ended first", run = fn() = {
        let result = {
            let program <- Os.start(Os.command("sh", ["-c", "exit 3"]));
            let first <- exited(program);
            let status <- terminate(program);
            Right(#(first, status))
        };
        Test.equal(result, Right(#(3, 3)))
    })

// design §13: the checks run on the ports of the configuration's first tls
// listener and its first redirect listener, 443 and 80 for the deployed
// one and 8443 and 8080 for the deployed one moved there, its first
// redirect host the deployed one's in both; and the shell's from the origin
// a page on the tls port sends, the port written where it is not 443. A
// regression test, written after `main` had run the checks on 443 and 80
// whatever the configuration's listeners: it does not run the checks
// themselves over TLS, which a certificate the host's bundle verifies
// needs.
let takesThePortsOfTheConfiguration =
    Test.Case(name = "takes the ports of the configuration", run = fn() = {
        let directory = "build/scratch/smoke-ports";
        let moved = directory <> "/moved.json";
        let deployed = text("deploy/config.json");
        let movedText =
            String.replace(String.replace(deployed, "\"port\": 443", "\"port\": 8443"),
                           "\"port\": 80",
                           "\"port\": 8080");
        let ports =
            fn(path) =
                Either.map(configured(path),
                           fn(#(_, redirectHost, port, redirectPort)) =
                               #(redirectHost, port, redirectPort));
        let result = {
            let _ <- Fs.makeDir(Path(directory), 5000);
            let _ <- Fs.write(Path(moved), String.toUtf8(movedText), 5000);
            Right(#(ports("deploy/config.json"), ports(moved)))
        };
        Test.equal(#(result, origin("ernest-lang.org", 443), origin("ernest-lang.org", 8443)),
                   #(Right(#(Right(#("www.ernest-lang.org", 443, 80)),
                             Right(#("www.ernest-lang.org", 8443, 8080)))),
                     "https://ernest-lang.org",
                     "https://ernest-lang.org:8443"))
    })

// What a test's process takes: a run of `ern run` on this module's
// compiled form, by the index of its arguments.
type Ran = Ran(index : Int, outcome : Either(Io.Error, Os.Finished))

// design §13: the program refuses a command line of another count of
// arguments than two, none, one and three, with the usage on standard
// error, nothing on standard output, and the status 2; and a configuration
// it cannot take, a file that is not there, one whose text breaks a rule,
// `{}`, one with no redirect host, the deployed one's emptied, and one
// without a tls listener, the example site's, with `smoke: `, the path,
// `: ` and the reason on standard error, nothing on standard output, and
// the status 2, before any check runs; each is run by `ern run` on the
// module's own compiled form, as make smoke runs it, at once.
let refusesTheCommandLine = Test.Case(name = "refuses a command line it cannot take", run = fn() = {
    let directory = "build/scratch/smoke-refusal";
    let missing = directory <> "/missing.json";
    let empty = directory <> "/empty.json";
    let unredirected = directory <> "/unredirected.json";
    let deployed = text("deploy/config.json");
    let hosts = "[\"www.ernest-lang.org\", \"ernest-lang.se\", \"www.ernest-lang.se\"]";
    let result = {
        let _ <- Fs.makeDir(Path(directory), 5000);
        let _ <- Fs.write(Path(empty), String.toUtf8("{}\n"), 5000);
        let _ <-
            Fs.write(Path(unredirected),
                     String.toUtf8(String.replace(deployed, hosts, "[]")),
                     5000);
        Right(#(String.contains(deployed, hosts),
                ranSmoke([[],
                          ["ernest-lang.org"],
                          ["ernest-lang.org", "deploy/config.json", "www.ernest-lang.org"],
                          ["ernest-lang.org", missing],
                          ["ernest-lang.org", empty],
                          ["ernest-lang.org", unredirected],
                          ["ernest-lang.org", "examples/site/config.json"]])))
    };
    let refusal = Right(#(2, Some(""), Some("usage: smoke host config.json\n")));
    let refused = fn(said) = Right(#(2, Some(""), Some("smoke: " <> said <> "\n")));
    Test.equal(result,
               Right(#(true,
                       [refusal,
                        refusal,
                        refusal,
                        refused(missing <> ": cannot read the file: Io.NotFound"),
                        refused(empty <> ": listeners is required"),
                        refused(unredirected <> ": redirect-hosts must not be empty: []"),
                        refused("examples/site/config.json: listeners must hold a tls listener and a redirect listener")])))
})

// Each command line run by `ern run` on the module's compiled form, at
// once, each in a process of its own: its status, its standard output and
// its standard error, in the order of the command lines.
fn ranSmoke(runs : List(List(String))) : List(Either(Io.Error,
                                                     #(Int,
                                                       Optional(String),
                                                       Optional(String)))) receiving Ran = {
    let me = self();
    List.forEach(List.indexed(runs), fn(#(index, arguments)) = {
        let _ =
            spawn(fn() =
                      send(me,
                           Ran(=index,
                               outcome = Os.run(Os.command("ern",
                                                           ["run", "build/smoke.erc"] <> arguments),
                                                30000))));
        Unit
    });
    List.map(List.indexed(runs), fn(#(wanted, _)) = receive {
        Ran(=index, =outcome) when index == wanted ->
            Either.map(outcome,
                       fn(finished) =
                           #(finished.status,
                             String.fromUtf8(finished.stdout),
                             String.fromUtf8(finished.stderr)))
      | after 60000 ->
            Left(Io.Timeout)
    })
}

// The text of a file of the repository, by its path; "" where it cannot be
// read.
fn text(path : String) : String =
    match Fs.read(Path(path), 5000) {
        Right(bytes) -> Optional.withDefault(String.fromUtf8(bytes), "")
      | Left(_) -> ""
    }

// The lines of the file's text that it lacks, each with the file's path.
fn lacked(path : String, wanted : List(String)) : List(String) = {
    let lines = List.map(String.lines(text(path)), String.trim);
    List.filterMap(wanted,
                   fn(line) =
                       if List.contains(lines, line) then None else Some(path <> " lacks " <> line))
}

// The seconds of the unit's TimeoutStopSec, where it has one.
fn stopSeconds(unit : String) : Optional(Int) =
    List.map(String.lines(unit), String.trim)
        |> List.filter(fn(line) = String.startsWith(line, "TimeoutStopSec="))
        |> List.filterMap(fn(line) = String.toInt(String.replace(line, "TimeoutStopSec=", "")))
        |> List.get(0)

// What the deployed configuration holds against design §13, each field
// that differs named: a tls listener on 443 and a redirect listener on 80
// on each of 0.0.0.0 and ::, the tls ones naming node/'s certificate and
// key and the redirect ones acme/; the root site/; the canonical host; the
// three headers, the policy's connect-src naming wss:// and the canonical
// host; the access log log/access.log; the caps the log's measurement
// sized, 80 connections a listener and 16 an address; the idle deadline of
// 15000 milliseconds; and no shell.
fn differences(config : Config.Config, home : String) : List(String) = {
    let node = home <> "/node";
    let tls =
        Config.Tls(certificate = Path(node <> "/fullchain.pem"),
                   key = Path(node <> "/privkey.pem"));
    let redirect = Config.Redirect(acmeChallenge = Path(home <> "/acme"));
    let listeners =
        [Config.Listener(kind = tls, address = "0.0.0.0", port = 443),
         Config.Listener(kind = tls, address = "::", port = 443),
         Config.Listener(kind = redirect, address = "0.0.0.0", port = 80),
         Config.Listener(kind = redirect, address = "::", port = 80)];
    let policy =
        "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' wss://"
            <> config.canonicalHost;
    let headers =
        [Http.Header(name = "Content-Security-Policy", value = policy),
         Http.Header(name = "Strict-Transport-Security", value = "max-age=31536000"),
         Http.Header(name = "X-Content-Type-Options", value = "nosniff")];
    let limits = config.limits;
    List.filterMap([#("listeners", config.listeners == listeners),
                    #("root", config.root == Path(home <> "/site")),
                    #("canonical-host", config.canonicalHost == "ernest-lang.org"),
                    #("headers", config.headers == headers),
                    #("access-log", config.accessLog == Path(home <> "/log/access.log")),
                    #("limits", limits.connections == 80 && limits.connectionsPerAddress == 16),
                    #("timeouts.idle", config.timeouts.idle == 15000),
                    #("shell", config.shell == None)],
                   fn(#(field, holds)) =
                       if holds then
                           None
                       else
                           Some("deploy/config.json's " <> field <> " is not design §13's"))
}

// design §13: the files of deploy/ as they are installed: config.json
// passes Config.parse, every rule but the file system's, and holds what the
// design says, its listeners, root, canonical host, headers, log, caps and
// idle deadline, and no shell; the unit holds each line the design names,
// Type=exec, User=httpd, the working directory, the PATH with the prefix's
// bin first, the installed launcher's ExecStart with node/ and its
// config.json, the migrate in ExecStartPre, the prefix's ern in ExecReload,
// Restart=on-failure, KillMode=mixed,
// AmbientCapabilities=CAP_NET_BIND_SERVICE, ProtectSystem=strict,
// PrivateTmp=yes and the ReadWritePaths, and a TimeoutStopSec above
// timeouts.write and timeouts.file of config.json and, where it has a
// shell, shell.hangup together; the shell's wrapper makes its directory
// under /run/user, traps HUP and TERM, runs podman run with --cidfile, and
// removes the container by its id with podman rm -f -t 0; the shell's start
// copies a and foo into the home, keeping their modes, starts foo as a bare
// node and reads its lines through a fifo until it listens, says `foo did
// not start` where it ends first, and then runs ern shell on a in its
// place; the image makes the share directory the user's, installs the
// start, makes the two nodes listing each other, foo on 127.0.0.1:8655,
// writes the limits into each ernest.conf, and runs the start as its
// command; the deploy hook copies fullchain.pem and privkey.pem into node/,
// owned by httpd, the key's mode 0600, and restarts the unit; and logrotate
// rotates log/'s access.log as httpd. A line that is missing is named.
let holdsTheDeployment = Test.Case(name = "holds the files of deploy/", run = fn() = {
    let unit = "deploy/ernest-httpd.service";
    let parsed = Config.parse(text("deploy/config.json"));
    let home = "/home/httpd/ernest-httpd";
    let stop = match #(parsed, stopSeconds(text(unit))) {
        #(Right(config), Some(seconds)) -> {
            // the design's deployed configuration has no shell; the rule
            // counts shell.hangup where one has
            let timeouts = config.timeouts;
            let hangup =
                Optional.withDefault(Optional.map(config.shell, fn(shell) = shell.hangup), 0);
            let above = if seconds * 1000 > timeouts.write + timeouts.file + hangup then
                []
            else
                [unit
                     <> "'s TimeoutStopSec is not above timeouts.write, timeouts.file and shell.hangup together"];
            differences(config, home) <> above
        }
      | #(_, None) ->
            [unit <> " lacks TimeoutStopSec"]
      | #(Left(error), _) ->
            ["deploy/config.json: " <> Config.reason(error)]
    };
    let prefix = "/home/httpd/opt/local";
    let node = home <> "/node";
    let live = "/etc/letsencrypt/live/ernest-lang.org";
    Test.equal(lacked(unit,
                      ["Type=exec",
                       "User=httpd",
                       "WorkingDirectory=/home/httpd",
                       "Environment=PATH=" <> prefix <> "/bin:/usr/local/bin:/usr/bin:/bin",
                       "ExecStartPre=/usr/bin/podman system migrate",
                       "ExecStart="
                           <> prefix
                           <> "/bin/ernest_httpd --config-dir "
                           <> node
                           <> " "
                           <> node
                           <> "/config.json",
                       "ExecReload=" <> prefix <> "/bin/ern reload --config-dir " <> node,
                       "Restart=on-failure",
                       "KillMode=mixed",
                       "AmbientCapabilities=CAP_NET_BIND_SERVICE",
                       "ProtectSystem=strict",
                       "PrivateTmp=yes",
                       "ReadWritePaths="
                           <> home
                           <> "/log "
                           <> node
                           <> " /home/httpd/.local/share/containers /run/user"])
                   <> stop
                   <> lacked("deploy/certbot-deploy.sh",
                             ["install -o httpd -g httpd -m 0644 "
                                  <> live
                                  <> "/fullchain.pem "
                                  <> node
                                  <> "/fullchain.pem",
                              "install -o httpd -g httpd -m 0600 "
                                  <> live
                                  <> "/privkey.pem "
                                  <> node
                                  <> "/privkey.pem",
                              "systemctl restart ernest-httpd.service"])
                   <> lacked("deploy/shell.sh",
                             ["dir=$(mktemp -d -p \"/run/user/$(id -u)\") || exit 1",
                              "trap 'end; exit 129' HUP",
                              "trap 'end; exit 143' TERM",
                              "podman run --cidfile \"$dir/cid\" \"$@\" <&3 &",
                              "podman rm -f -t 0 --cidfile \"$dir/cid\" > /dev/null 2>&1"])
                   <> lacked("deploy/shell-start.sh",
                             ["share=/usr/local/share/ernest-shell",
                              "cp -Rp \"$share/a\" \"$share/foo\" \"$HOME/\" || exit 1",
                              "mkfifo -m 0600 \"$fifo\" || exit 1",
                              "ern run --config-dir \"$HOME/foo\" 2>&1 | {",
                              "no*\"listening on\"*)",
                              "[ \"$told\" = yes ] || echo ended > \"$fifo\"",
                              "read -r said < \"$fifo\"",
                              "echo \"foo did not start\" >&2",
                              "exec ern shell --config-dir \"$HOME/a\""])
                   <> lacked("deploy/Containerfile",
                             ["&& install -d -o shell -g shell -m 0755 /usr/local/share/ernest-shell",
                              "COPY --chmod=0755 shell-start.sh /usr/local/bin/shell-start",
                              "USER shell",
                              "&& ern config --config-dir a > /dev/null \\",
                              "&& ern config --config-dir foo --listen 127.0.0.1:8655 > /dev/null \\",
                              "&& ern config --config-dir a --peer-dir foo \\",
                              "&& ern config --config-dir foo --peer-dir a \\",
                              "sed -i '1s/^{$/&\\n  \"limits\": {\"processes\": 65536, \"ports\": 4096},/' \"$node/ernest.conf\" \\",
                              "CMD [\"shell-start\"]"])
                   <> lacked("deploy/logrotate", [home <> "/log/access.log {", "su httpd httpd"]),
               [])
})
