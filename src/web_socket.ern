/// RFC 6455's frames and its handshake's accept value: a WebSocket's messages
/// decoded from bytes and encoded as frames, knowing no socket (design §10).
///
/// A server uses it on a connection it has upgraded: `accept` answers the
/// handshake's `Sec-WebSocket-Accept` for the client's `Sec-WebSocket-Key`,
/// a decoder of `FromClient` frames takes what the socket reads, the bytes
/// after the handshake's head first, and `encode` writes each message the
/// server sends. A client, a test's among them, decodes `FromServer` frames
/// and writes each message with `encodeMasked` and a key of its own for the
/// frame, `Crypto.randomBytes(4)`.
///
/// A decoder is a value: `decode` takes it with the bytes read and answers
/// the messages they complete and the decoder that holds the rest, a frame
/// whose bytes have not all come and a message whose final frame has not.
/// A decoder that answered an error is not used again: the connection closes
/// with the error's `closeCode`.
///
/// A message is whole: a text or a binary message's fragments are joined,
/// and a ping, a pong and a close are answered where they come, between two
/// fragments among them. No extension is read and no subprotocol: a frame
/// with a reserved bit set is refused.
///
/// ## Examples
///
/// A client's text message decoded, RFC 6455's masked frame of §5.7:
///
/// ```ernest
/// let decoder = WebSocket.decoder(WebSocket.FromClient, 65536);
/// let frame = <<0x81, 0x85, 0x37, 0xfa, 0x21, 0x3d, 0x7f, 0x9f, 0x4d, 0x51, 0x58>>;
/// Either.map(WebSocket.decode(decoder, frame), fn(#(messages, _)) = messages)
/// // => Right([WebSocket.Text("Hello")])
/// ```
///
/// The server's text message encoded, the RFC's unmasked frame of §5.7:
///
/// ```ernest
/// Bytes.toHex(WebSocket.encode(WebSocket.Text("Hello")))
/// // => "810548656C6C6F"
/// ```

//
// Types
//

/// A WebSocket's message, what one side sends whole: a text message, a
/// binary message, a ping and a pong with their payloads, and a close with
/// its code and its reason, `None` and `""` where the close carries
/// neither.
///
/// A ping, a pong and a close carry at most 125 bytes, a close's two bytes
/// of code among them, and a close carries a code of 1000 to 1003, 1007 to
/// 1014 or 3000 to 4999 (RFC 6455's §5.5, and its §7.4 with IANA's
/// registry).
///
/// ### Examples
///
/// ```ernest
/// Bytes.toHex(WebSocket.encode(WebSocket.Close(code = Some(1000), reason = "done")))
/// // => "880603E8646F6E65"
/// ```
export type Message =
    Text(String)
  | Binary(Bytes)
  | Ping(Bytes)
  | Pong(Bytes)
  | Close(code : Optional(Int), reason : String)

/// The side whose frames a decoder takes: `FromClient`, a client's, each
/// masked, or `FromServer`, a server's, none masked.
///
/// ### Examples
///
/// A decoder of a server's frames given a client's masked frame:
///
/// ```ernest
/// let decoder = WebSocket.decoder(WebSocket.FromServer, 65536);
/// let frame = <<0x81, 0x85, 0x37, 0xfa, 0x21, 0x3d, 0x7f, 0x9f, 0x4d, 0x51, 0x58>>;
/// Either.map(WebSocket.decode(decoder, frame), fn(#(messages, _)) = messages)
/// // => Left(WebSocket.ProtocolError)
/// ```
export type Role = FromClient | FromServer

/// What a decoder refuses: `ProtocolError`, a frame RFC 6455 forbids;
/// `TooBig`, a message past the decoder's limit; and `NotUtf8`, a text
/// message or a close's reason that is not UTF-8.
///
/// ### Examples
///
/// ```ernest
/// let decoder = WebSocket.decoder(WebSocket.FromServer, 4);
/// let frame = <<0x81, 0x05, 0x48, 0x65, 0x6c, 0x6c, 0x6f>>;
/// Either.map(WebSocket.decode(decoder, frame), fn(#(messages, _)) = messages)
/// // => Left(WebSocket.TooBig)
/// ```
export type Error = ProtocolError | TooBig | NotUtf8

/// The frames one role sends, with what has come of a frame or a message
/// whose end has not: `decoder` makes one, and `decode` takes it with the
/// bytes read and answers the next.
///
/// ### Examples
///
/// A text message of two frames, RFC 6455's `Hel` and `lo` of §5.7, across
/// two reads:
///
/// ```ernest
/// let decoder = WebSocket.decoder(WebSocket.FromServer, 65536);
/// {
///     let #(first, decoder) <- WebSocket.decode(decoder, <<0x01, 0x03, 0x48, 0x65, 0x6c>>);
///     let #(second, _) <- WebSocket.decode(decoder, <<0x80, 0x02, 0x6c, 0x6f>>);
///     Right(#(first, second))
/// }
/// // => Right(#([], [WebSocket.Text("Hello")]))
/// ```
export abstract type Decoder =
    Decoder(role : Role, limit : Int, carried : Bytes, message : Optional(Fragments))

// A message under way: whether it is a text or a binary message, and its
// fragments so far, joined.
type Fragments = Fragments(kind : Kind, payload : Bytes)

type Kind = TextMessage | BinaryMessage

// A frame's header as the bytes write it: its final bit, its reserved bits,
// its opcode, its mask bit, its length's seven bits, and its payload's
// length, which the seven bits are below 126, and the 16 or the 64 bits
// after them at 126 and 127.
type Header =
    Header(isFinal : Bool, reserved : Int, opcode : Int, isMasked : Bool, form : Int, length : Int)

// What a frame is, read from its opcode after the message under way: a
// control frame, or a fragment of a message, the message's fragments before
// it given.
type Frame = CloseFrame | PingFrame | PongFrame | Fragment(Fragments)

// A frame placed: the message it answers, where it is a control frame or a
// message's final frame, and the message under way after it.
type Placed = Placed(answered : Optional(Message), message : Optional(Fragments))

//
// The accept value
//

/// The value of `Sec-WebSocket-Accept` for a request's `Sec-WebSocket-Key`:
/// the SHA-1 digest of the key and `258EAFA5-E914-47DA-95CA-C5AB0DC85B11`,
/// written in base64 (RFC 6455, §4.2.2).
///
/// The key is taken as written; whether it is 16 bytes in base64 is the
/// handshake's to check.
///
/// ### Examples
///
/// RFC 6455's key of §4.2.2:
///
/// ```ernest
/// WebSocket.accept("dGhlIHNhbXBsZSBub25jZQ==")
/// // => "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="
/// ```
export fn accept(key : String) : String =
    Base64.encode(Crypto.sha1(String.toUtf8(key <> acceptGuid)))

// The text RFC 6455 appends to a key before its digest, §1.3.
let acceptGuid : String = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"

//
// Decoding
//

/// A decoder of the role's frames that takes a message of at most `limit`
/// bytes, with no frame and no message under way.
///
/// The limit counts a text or a binary message's payload, its fragments'
/// together, a text message's in UTF-8; a ping, a pong and a close are held
/// to 125 bytes by the RFC, and the limit does not count them. A limit below
/// 0 is 0 (report §7.4).
export fn decoder(role : Role, limit : Int) : Decoder =
    Decoder(=role, limit = Int.max(limit, 0), carried = <<>>, message = None)

/// The messages the bytes complete, in order, and the decoder that holds
/// the rest; the bytes the decoder held come before them.
///
/// A frame is refused as soon as its bytes show what it breaks. A header
/// RFC 6455 forbids is `ProtocolError`, and a fragment's header that takes
/// its message past the decoder's limit is `TooBig`, each before the
/// payload has come; a close's code is read with its payload, and its
/// reason as UTF-8, else `NotUtf8`; and a text message is read as UTF-8 at
/// its final frame, its fragments joined, else `NotUtf8`. Bytes that
/// complete no message answer none, and bytes that hold an error answer the
/// error alone, the messages before it dropped.
///
/// The frames refused as `ProtocolError`: one masked for a `FromServer`
/// decoder, or not masked for a `FromClient` one; one with a reserved bit
/// set or a reserved opcode; one whose length is not written in the
/// shortest of the three forms, or whose 64 bits have the highest set; a
/// control frame that is not final, or whose payload passes 125 bytes; a
/// continuation with no message under way, and a text or a binary message's
/// first frame inside one; and a close whose payload is one byte, or whose
/// code is not 1000 to 1003, 1007 to 1014 or 3000 to 4999.
///
/// A frame after a close is decoded as any other.
///
/// ### Examples
///
/// A ping between a text message's two fragments, answered in its place:
///
/// ```ernest
/// let decoder = WebSocket.decoder(WebSocket.FromServer, 65536);
/// let frames = <<0x01, 0x03, 0x48, 0x65, 0x6c, 0x89, 0x00, 0x80, 0x02, 0x6c, 0x6f>>;
/// Either.map(WebSocket.decode(decoder, frames), fn(#(messages, _)) = messages)
/// // => Right([WebSocket.Ping(<<>>), WebSocket.Text("Hello")])
/// ```
///
/// A frame whose header says it passes the limit, refused before its
/// payload has come:
///
/// ```ernest
/// let decoder = WebSocket.decoder(WebSocket.FromServer, 65536);
/// let header = <<0x82, 0x7F, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01, 0x00, 0x01>>;
/// Either.map(WebSocket.decode(decoder, header), fn(#(messages, _)) = messages)
/// // => Left(WebSocket.TooBig)
/// ```
export fn decode(decoder : Decoder, bytes : Bytes) : Either(Error, #(List(Message), Decoder)) =
    decodedFrom(Decoder(..decoder, carried = decoder.carried <> bytes), [])

// The messages of the frames the decoder carries, after those of acc, which
// are in reverse, and the decoder holding the rest: a frame is read once its
// header has come, refused at once where it breaks a rule, and placed once
// its payload has come.
fn decodedFrom(decoder : Decoder, acc : List(Message)) : Either(Error, #(List(Message), Decoder)) =
    match header(decoder.carried) {
        None ->
            Right(#(List.reverse(acc), decoder))
      | Some(#(header, rest)) -> {
            let frame <- taken(decoder, header);
            match payload(header, rest) {
                None ->
                    Right(#(List.reverse(acc), decoder))
              | Some(#(payload, next)) -> {
                    let Placed(=answered, =message) <-
                        placed(frame, header.isFinal, payload, decoder.message);
                    let messages = match answered {
                        Some(whole) -> whole :: acc
                      | None -> acc
                    };
                    decodedFrom(Decoder(..decoder, carried = next, =message), messages)
                }
            }
        }
    }

// The header the bytes begin with, and the bytes after it; None where they
// hold less than the header.
fn header(bytes : Bytes) : Optional(#(Header, Bytes)) =
    match bytes {
        <<final:size(1),
          reserved:size(3),
          opcode:size(4),
          masked:size(1),
          form:size(7),
          rest:bytes>> -> {
            let #(length, next) <- lengthOf(form, rest);
            Some(#(Header(isFinal = final == 1,
                          =reserved,
                          =opcode,
                          isMasked = masked == 1,
                          =form,
                          =length),
                   next))
        }
      | _ ->
            None
    }

// The payload's length: the seven bits below 126, and the 16 or the 64 bits
// the bytes begin with at 126 and 127; and the bytes after it. None where
// those bits have not come.
fn lengthOf(form : Int, bytes : Bytes) : Optional(#(Int, Bytes)) =
    match #(form, bytes) {
        #(126, <<length:size(16), rest:bytes>>) -> Some(#(length, rest))
      | #(127, <<length:size(64), rest:bytes>>) -> Some(#(length, rest))
      | #(length, _) when length < 126 -> Some(#(length, bytes))
      | _ -> None
    }

// What the header's frame is to the decoder, or the error it makes: a frame
// the RFC forbids is a ProtocolError, and a fragment that takes its message
// past the limit TooBig.
fn taken(decoder : Decoder, header : Header) : Either(Error, Frame) = {
    let isWellFormed =
        header.reserved == 0
            && header.isMasked == (decoder.role == FromClient)
            && isShortest(header);
    match framed(header.opcode, decoder.message) {
        Some(frame) when isWellFormed -> limited(decoder, header, frame)
      | _ -> Left(ProtocolError)
    }
}

// What a frame of the opcode is after the message under way, where the RFC
// allows it there: a control frame anywhere, a continuation inside a
// message, and a text or a binary message's first frame outside one; None
// for a reserved opcode, and for a frame where it is not allowed. The
// opcodes are RFC 6455's, §5.2.
fn framed(opcode : Int, message : Optional(Fragments)) : Optional(Frame) =
    match #(opcode, message) {
        #(0, Some(fragments)) -> Some(Fragment(fragments))
      | #(1, None) -> Some(Fragment(Fragments(kind = TextMessage, payload = <<>>)))
      | #(2, None) -> Some(Fragment(Fragments(kind = BinaryMessage, payload = <<>>)))
      | #(8, _) -> Some(CloseFrame)
      | #(9, _) -> Some(PingFrame)
      | #(10, _) -> Some(PongFrame)
      | _ -> None
    }

// Whether the header writes its length in the shortest of the three forms,
// and in 63 bits where it uses 64, as the RFC asks, §5.2.
fn isShortest(header : Header) : Bool =
    match header.form {
        126 -> header.length >= 126
      | 127 -> header.length >= 65536 && header.length <= longestLength
      | _ -> true
    }

// The largest length a frame writes, 2 to the 63rd less 1.
let longestLength : Int = 9223372036854775807

// The frame where it keeps its limits: a control frame final and of at most
// 125 bytes, else a ProtocolError, and a fragment whose message stays within
// the decoder's limit with it, else TooBig.
fn limited(decoder : Decoder, header : Header, frame : Frame) : Either(Error, Frame) =
    match frame {
        Fragment(fragments) ->
            if Bytes.size(fragments.payload) + header.length > decoder.limit then
                Left(TooBig)
            else
                Right(frame)
      | _ ->
            if header.isFinal && header.length <= 125 then Right(frame) else Left(ProtocolError)
    }

// The payload of the header's frame, unmasked with the key before it where
// the frame is masked, and the bytes after it; None where it has not all
// come.
fn payload(header : Header, bytes : Bytes) : Optional(#(Bytes, Bytes)) = {
    let length = header.length;
    match #(header.isMasked, bytes) {
        #(true, <<key:size(4)-bytes, payload:size(length)-bytes, rest:bytes>>) ->
            Some(#(masked(payload, key), rest))
      | #(false, <<payload:size(length)-bytes, rest:bytes>>) ->
            Some(#(payload, rest))
      | _ ->
            None
    }
}

// The frame's payload placed: a control frame's message answered, and a
// fragment joined to the fragments before it, its message answered at its
// final frame and kept under way before it.
fn placed(frame : Frame,
          isFinal : Bool,
          payload : Bytes,
          message : Optional(Fragments)) : Either(Error, Placed) =
    match frame {
        CloseFrame ->
            Either.map(closed(payload), fn(close) = Placed(answered = Some(close), =message))
      | PingFrame ->
            Right(Placed(answered = Some(Ping(payload)), =message))
      | PongFrame ->
            Right(Placed(answered = Some(Pong(payload)), =message))
      | Fragment(fragments) -> {
            let joined = Fragments(..fragments, payload = fragments.payload <> payload);
            if isFinal then
                Either.map(completed(joined),
                           fn(whole) = Placed(answered = Some(whole), message = None))
            else
                Right(Placed(answered = None, message = Some(joined)))
        }
    }

// A close's message: no code and no reason for an empty payload, and
// otherwise its code, the first two bytes, and its reason, the rest, as
// UTF-8.
fn closed(payload : Bytes) : Either(Error, Message) =
    match payload {
        <<>> ->
            Right(Close(code = None, reason = ""))
      | <<code:size(16), rest:bytes>> when isCloseCode(code) ->
            match String.fromUtf8(rest) {
                Some(reason) -> Right(Close(code = Some(code), =reason))
              | None -> Left(NotUtf8)
            }
      | _ ->
            Left(ProtocolError) // one byte, or a code a close may not carry
    }

// Whether a close may carry the code: RFC 6455's and IANA's, but those an
// endpoint may not send, and the range for applications.
fn isCloseCode(code : Int) : Bool =
    code >= 1000 && code <= 1003 || code >= 1007 && code <= 1014 || code >= 3000 && code <= 4999

// The message the fragments make whole: a text message's must be UTF-8.
fn completed(fragments : Fragments) : Either(Error, Message) =
    match fragments.kind {
        TextMessage ->
            Either.fromOptional(Optional.map(String.fromUtf8(fragments.payload), Text), NotUtf8)
      | BinaryMessage ->
            Right(Binary(fragments.payload))
    }

/// The close code RFC 6455 gives an error, which a connection closes with:
/// 1002 for `ProtocolError`, 1009 for `TooBig` and 1007 for `NotUtf8`.
///
/// ### Examples
///
/// ```ernest
/// WebSocket.closeCode(WebSocket.TooBig)
/// // => 1009
/// ```
export fn closeCode(error : Error) : Int =
    match error {
        ProtocolError -> 1002
      | TooBig -> 1009
      | NotUtf8 -> 1007
    }

//
// Encoding
//

/// One frame of the message, unmasked, as a server sends it: final, its
/// payload's length in the shortest of the three forms, a text message's
/// payload its UTF-8, and a close's its code in two bytes and its reason, or
/// none where it has no code, its reason dropped.
///
/// The message is written as given: a ping, a pong or a close past 125
/// bytes, or a close whose code the RFC does not allow, is a frame a decoder
/// refuses.
///
/// ### Errors
///
/// A close whose code is below 0 or above 65535 faults, as a bitstring
/// faults on a value that does not fit its 16 bits: `segment overflow: 70000
/// does not fit 16 bits` (report §7.4).
///
/// ### Examples
///
/// RFC 6455's unmasked ping of §5.7:
///
/// ```ernest
/// Bytes.toHex(WebSocket.encode(WebSocket.Ping(String.toUtf8("Hello"))))
/// // => "890548656C6C6F"
/// ```
///
/// The header of the RFC's binary message of 256 bytes, its length in 16
/// bits, and of 64 KiB, in 64:
///
/// ```ernest
/// let header = fn(count) = {
///     let frame = WebSocket.encode(WebSocket.Binary(Bytes.repeat(<<0>>, count)));
///     Bytes.toHex(Bytes.slice(frame, 0, Bytes.size(frame) - count))
/// };
/// [header(256), header(65536)]
/// // => ["827E0100", "827F0000000000010000"]
/// ```
export fn encode(message : Message) : Bytes = {
    let #(opcode, payload) = opcodeAndPayload(message);
    <<(frameHead(opcode, 0, Bytes.size(payload))):bytes, payload:bytes>>
}

/// One frame of the message masked with the four-byte key, as a client sends
/// it: the frame `encode` writes, its mask bit set, the key after its
/// length, and its payload masked with the key; `None` for a key of another
/// size.
///
/// A client draws the key afresh for each frame, `Crypto.randomBytes(4)`.
///
/// ### Errors
///
/// A close whose code is below 0 or above 65535 faults, as `encode` does.
///
/// ### Examples
///
/// RFC 6455's masked text message of §5.7, and a key of three bytes:
///
/// ```ernest
/// let key = <<0x37, 0xfa, 0x21, 0x3d>>;
/// [Optional.map(WebSocket.encodeMasked(WebSocket.Text("Hello"), key), Bytes.toHex),
///  Optional.map(WebSocket.encodeMasked(WebSocket.Text("Hello"), <<1, 2, 3>>), Bytes.toHex)]
/// // => [Some("818537FA213D7F9F4D5158"), None]
/// ```
export fn encodeMasked(message : Message, key : Bytes) : Optional(Bytes) =
    if Bytes.size(key) == 4 then {
        let #(opcode, payload) = opcodeAndPayload(message);
        Some(<<(frameHead(opcode, 1, Bytes.size(payload))):bytes,
               key:bytes,
               (masked(payload, key)):bytes>>)
    } else
        None

// A message's opcode and its payload, a close's its code and reason where
// it has a code.
fn opcodeAndPayload(message : Message) : #(Int, Bytes) =
    match message {
        Text(text) -> #(1, String.toUtf8(text))
      | Binary(bytes) -> #(2, bytes)
      | Close(code = None) -> #(8, <<>>)
      | Close(code = Some(code), =reason) -> #(8, <<code:size(16), (String.toUtf8(reason)):bytes>>)
      | Ping(bytes) -> #(9, bytes)
      | Pong(bytes) -> #(10, bytes)
    }

// A frame's bytes before its key and payload: final, no reserved bit, the
// opcode, the mask bit, and the payload's length in the shortest of the
// three forms.
fn frameHead(opcode : Int, mask : Int, length : Int) : Bytes =
    if length < 126 then
        <<1:size(1), 0:size(3), opcode:size(4), mask:size(1), length:size(7)>>
    else if length < 65536 then
        <<1:size(1), 0:size(3), opcode:size(4), mask:size(1), 126:size(7), length:size(16)>>
    else
        <<1:size(1), 0:size(3), opcode:size(4), mask:size(1), 127:size(7), length:size(64)>>

//
// Masking
//

// The bytes masked with the four-byte key, each byte XORed with the key's
// byte at its index modulo 4, RFC 6455's §5.3, which unmasks them too: four
// bytes at a time, and the last one at a time, the key turned past each.
fn masked(bytes : Bytes, key : Bytes) : Bytes =
    maskedFrom(bytes, key, <<>>)

fn maskedFrom(bytes : Bytes, key : Bytes, acc : Bytes) : Bytes =
    match #(bytes, key) {
        #(<<word:size(32), rest:bytes>>, <<keyWord:size(32)>>) ->
            maskedFrom(rest, key, <<acc:bytes, Int.bitXor(word, keyWord):size(32)>>)
      | #(<<byte, rest:bytes>>, <<keyByte, keyRest:bytes>>) ->
            maskedFrom(rest, <<keyRest:bytes, keyByte>>, <<acc:bytes, Int.bitXor(byte, keyByte)>>)
      | _ ->
            acc // the end of the bytes
    }

//
// Tests
//

// RFC 6455's frames of §5.7: "Hello" in one unmasked frame, in one masked
// with the RFC's key, and in two unmasked fragments, `Hel` and `lo`; and an
// unmasked ping and a masked pong of "Hello".
let rfcKey : Bytes = <<0x37, 0xfa, 0x21, 0x3d>>

let unmaskedHello : Bytes = <<0x81, 0x05, 0x48, 0x65, 0x6c, 0x6c, 0x6f>>

let maskedHello : Bytes = <<0x81, 0x85, 0x37, 0xfa, 0x21, 0x3d, 0x7f, 0x9f, 0x4d, 0x51, 0x58>>

let fragmentHel : Bytes = <<0x01, 0x03, 0x48, 0x65, 0x6c>>

let fragmentLo : Bytes = <<0x80, 0x02, 0x6c, 0x6f>>

let unmaskedPing : Bytes = <<0x89, 0x05, 0x48, 0x65, 0x6c, 0x6c, 0x6f>>

let maskedPong : Bytes = <<0x8a, 0x85, 0x37, 0xfa, 0x21, 0x3d, 0x7f, 0x9f, 0x4d, 0x51, 0x58>>

let hello : Bytes = String.toUtf8("Hello")

// The RFC's binary messages of §5.7, of 256 bytes and of 64 KiB.
let bytes256 : Bytes = Bytes.repeat(<<0x5a>>, 256)

let bytes64k : Bytes = Bytes.repeat(<<0xa5>>, 65536)

// The limit of the tests' decoders where a test names none.
let testLimit : Int = 1048576

// The messages one call of decode answers, the bytes given to a new decoder
// of the role, or its error.
fn decoded(role : Role, bytes : Bytes) : Either(Error, List(Message)) =
    Either.map(decode(decoder(role, testLimit), bytes), fn(#(messages, _)) = messages)

// What each call of decode answers, the chunks given one a call to a decoder
// of the role and the limit; the calls end at the first error.
fn answers(role : Role, limit : Int, chunks : List(Bytes)) : List(Either(Error, List(Message))) =
    answersFrom(decoder(role, limit), chunks, [])

fn answersFrom(decoder : Decoder,
               chunks : List(Bytes),
               acc : List(Either(Error, List(Message)))) : List(Either(Error, List(Message))) =
    match chunks {
        [] ->
            List.reverse(acc)
      | chunk :: rest ->
            match decode(decoder, chunk) {
                Right(#(messages, next)) -> answersFrom(next, rest, Right(messages) :: acc)
              | Left(error) -> List.reverse(Left(error) :: acc)
            }
    }

// A frame of the first byte, its final bit, its reserved bits and its
// opcode, and of the payload, of at most 125 bytes: unmasked, and masked
// with the RFC's key.
fn unmaskedFrame(first : Int, payload : Bytes) : Bytes =
    <<first, 0:size(1), (Bytes.size(payload)):size(7), payload:bytes>>

fn maskedFrame(first : Int, payload : Bytes) : Bytes =
    <<first,
      1:size(1),
      (Bytes.size(payload)):size(7),
      rfcKey:bytes,
      (masked(payload, rfcKey)):bytes>>

// design §10: accept is the SHA-1 of the key and
// 258EAFA5-E914-47DA-95CA-C5AB0DC85B11 in base64: RFC 6455's key of
// §4.2.2, and another.
let acceptsKeys =
    Test.Case(name = "answers the accept value of a key",
              run = fn() =
                  Test.equal([accept("dGhlIHNhbXBsZSBub25jZQ=="),
                              accept("x3JJHMbDL1EzLkh9GBhXDw==")],
                             ["s3pPLMBiTxaQ9kYGzzhZRbK+xOo=", "HSmrc0sMlYUkAGmm5OPpG2HaGWk="]))

// design §10: RFC 6455's frames of §5.7 decode: "Hello" unmasked from a
// server and masked from a client, its two fragments joined, the ping, the
// pong, and the binary messages of 256 bytes and 64 KiB, their lengths in
// 16 and in 64 bits.
let decodesTheRfcFrames =
    Test.Case(name = "decodes RFC 6455's frames",
              run = fn() =
                  Test.equal([decoded(FromServer, unmaskedHello),
                              decoded(FromClient, maskedHello),
                              decoded(FromServer, fragmentHel <> fragmentLo),
                              decoded(FromServer, unmaskedPing),
                              decoded(FromClient, maskedPong),
                              decoded(FromServer, <<0x82, 0x7E, 0x01, 0x00, bytes256:bytes>>),
                              decoded(FromServer,
                                      <<0x82, 0x7F, 0, 0, 0, 0, 0, 1, 0, 0, bytes64k:bytes>>)],
                             [Right([Text("Hello")]),
                              Right([Text("Hello")]),
                              Right([Text("Hello")]),
                              Right([Ping(hello)]),
                              Right([Pong(hello)]),
                              Right([Binary(bytes256)]),
                              Right([Binary(bytes64k)])]))

// design §10: RFC 6455's frames of §5.7 encode: "Hello" unmasked and masked
// with the RFC's key, the ping unmasked, the pong masked, and the binary
// messages of 256 bytes and 64 KiB.
let encodesTheRfcFrames =
    Test.Case(name = "encodes RFC 6455's frames",
              run = fn() =
                  Test.equal([Some(encode(Text("Hello"))),
                              encodeMasked(Text("Hello"), rfcKey),
                              Some(encode(Ping(hello))),
                              encodeMasked(Pong(hello), rfcKey),
                              Some(encode(Binary(bytes256))),
                              Some(encode(Binary(bytes64k)))],
                             [Some(unmaskedHello),
                              Some(maskedHello),
                              Some(unmaskedPing),
                              Some(maskedPong),
                              Some(<<0x82, 0x7E, 0x01, 0x00, bytes256:bytes>>),
                              Some(<<0x82, 0x7F, 0, 0, 0, 0, 0, 1, 0, 0, bytes64k:bytes>>)]))

// design §10: encode writes a payload's length in the shortest of the three
// forms: in seven bits to 125, in 16 from 126 to 65535, and in 64 from
// 65536.
let writesTheShortestLength =
    Test.Case(name = "writes a length in its shortest form", run = fn() = {
        fn head(count : Int) : Bytes = {
            let frame = encode(Binary(Bytes.repeat(<<0>>, count)));
            Bytes.slice(frame, 0, Bytes.size(frame) - count)
        };
        Test.equal(List.map([0, 125, 126, 65535, 65536], head),
                   [<<0x82, 0>>,
                    <<0x82, 125>>,
                    <<0x82, 126, 0, 126>>,
                    <<0x82, 126, 0xff, 0xff>>,
                    <<0x82, 127, 0, 0, 0, 0, 0, 1, 0, 0>>])
    })

// design §10: a decoder of FromClient refuses a frame that is not masked,
// and one of FromServer a masked frame, a control frame's among them.
let refusesTheWrongMask =
    Test.Case(name = "refuses a frame masked for the other role",
              run = fn() =
                  Test.equal([decoded(FromClient, unmaskedHello),
                              decoded(FromClient, unmaskedPing),
                              decoded(FromServer, maskedHello),
                              decoded(FromServer, maskedPong)],
                             List.repeat(Left(ProtocolError), 4)))

// design §10: a frame with a reserved bit set is refused, each of the three,
// on a text frame and on a ping.
let refusesReservedBits =
    Test.Case(name = "refuses a reserved bit",
              run = fn() =
                  Test.equal(List.map([0xC1, 0xA1, 0x91, 0xC9, 0xA9, 0x99],
                                      fn(first) = decoded(FromClient, maskedFrame(first, hello))),
                             List.repeat(Left(ProtocolError), 6)))

// design §10: a frame of a reserved opcode is refused, 3 to 7 and 11 to 15,
// final or not.
let refusesReservedOpcodes = Test.Case(name = "refuses a reserved opcode", run = fn() = {
    let opcodes = List.range(3, 7) <> List.range(11, 15);
    let refused = fn(first) = decoded(FromClient, maskedFrame(first, hello));
    Test.equal(List.map(opcodes, fn(opcode) = refused(0x80 + opcode)) <> List.map(opcodes, refused),
               List.repeat(Left(ProtocolError), 20))
})

// design §10: a control frame that is not final is refused, a close, a ping
// and a pong.
let refusesFragmentedControlFrames =
    Test.Case(name = "refuses a control frame that is not final",
              run = fn() =
                  Test.equal([decoded(FromClient, maskedFrame(0x08, <<>>)),
                              decoded(FromClient, maskedFrame(0x09, hello)),
                              decoded(FromClient, maskedFrame(0x0A, hello))],
                             List.repeat(Left(ProtocolError), 3)))

// design §10: a control frame whose payload passes 125 bytes is refused, a
// ping, a pong and a close, at its header before its payload has come; one
// of 125 bytes is taken.
let refusesLongControlFrames =
    Test.Case(name = "refuses a control frame past 125 bytes", run = fn() = {
        let most = Bytes.repeat(<<0x5a>>, 125);
        let past = Bytes.repeat(<<0x5a>>, 126);
        Test.equal([decoded(FromServer, <<0x89, 125, most:bytes>>),
                    decoded(FromServer, <<0x89, 126, 0, 126, past:bytes>>),
                    decoded(FromServer, <<0x8A, 126, 0, 126, past:bytes>>),
                    decoded(FromServer,
                            <<0x88, 126, 0, 126, 0x03, 0xE8, (Bytes.slice(past, 0, 124)):bytes>>),
                    decoded(FromServer, <<0x89, 126, 0, 126>>)],
                   [Right([Ping(most)]),
                    Left(ProtocolError),
                    Left(ProtocolError),
                    Left(ProtocolError),
                    Left(ProtocolError)])
    })

// design §10: a continuation with no message under way is refused, at the
// start and after a message's final frame, final or not.
let refusesAStrayContinuation =
    Test.Case(name = "refuses a continuation with no message under way",
              run = fn() =
                  Test.equal([decoded(FromServer, fragmentLo),
                              decoded(FromServer, <<0x00, 0x00>>),
                              decoded(FromServer, unmaskedHello <> fragmentLo),
                              decoded(FromServer, fragmentHel <> fragmentLo <> fragmentLo)],
                             List.repeat(Left(ProtocolError), 4)))

// design §10: a text or a binary message's first frame inside a message
// under way is refused, final or not.
let refusesAMessageInsideOne =
    Test.Case(name = "refuses a message's first frame inside a message",
              run = fn() =
                  Test.equal([decoded(FromServer, fragmentHel <> unmaskedHello),
                              decoded(FromServer, fragmentHel <> fragmentHel),
                              decoded(FromServer, fragmentHel <> <<0x82, 0x00>>),
                              decoded(FromServer, <<0x02, 0x01, 0x00>> <> unmaskedHello)],
                             List.repeat(Left(ProtocolError), 4)))

// design §10: a close whose payload is one byte is refused, and one whose
// code is not 1000 to 1003, 1007 to 1014 or 3000 to 4999; a code in those
// ranges is taken, at each range's ends.
let refusesCloseCodes =
    Test.Case(name = "refuses a close's payload of one byte, and its codes", run = fn() = {
        let closing = fn(payload) = decoded(FromServer, unmaskedFrame(0x88, payload));
        let refused = [0, 999, 1004, 1005, 1006, 1015, 1016, 2999, 5000, 65535];
        let allowed = [1000, 1001, 1002, 1003, 1007, 1011, 1014, 3000, 4000, 4999];
        Test.equal([closing(<<0x03>>)]
                       <> List.map(refused <> allowed, fn(code) = closing(<<code:size(16)>>)),
                   List.repeat(Left(ProtocolError), 11)
                       <> List.map(allowed,
                                   fn(code) = Right([Close(code = Some(code), reason = "")])))
    })

// design §10: a length not written in the shortest of the three forms is a
// frame the RFC forbids, and so is a 64-bit length whose highest bit is
// set: each is refused at its header.
let refusesALongerLengthForm =
    Test.Case(name = "refuses a length in a longer form than it needs",
              run = fn() =
                  Test.equal([decoded(FromServer,
                                      <<0x82, 126, 0, 125, (Bytes.repeat(<<0>>, 125)):bytes>>),
                              decoded(FromServer, <<0x82, 126, 0, 0>>),
                              decoded(FromServer, <<0x82, 127, 0, 0, 0, 0, 0, 0, 0xff, 0xff>>),
                              decoded(FromServer, <<0x82, 127, 0x80, 0, 0, 0, 0, 0, 0, 0>>)],
                             List.repeat(Left(ProtocolError), 4)))

// design §10: a message whose fragments pass the limit is TooBig at the
// fragment that passes it, once that fragment's header has come and before
// its payload, and not before; a message of the limit is taken, and a
// control frame between its fragments is not counted; a limit below 0 is
// 0, which takes an empty message.
let refusesTooBigAtItsFragment =
    Test.Case(name = "refuses a message past the limit at its fragment", run = fn() = {
        let five = String.toUtf8("12345");
        let more = String.toUtf8("67890");
        Test.equal([answers(FromServer, 10, [unmaskedFrame(0x01, five), unmaskedFrame(0x80, more)]),
                    answers(FromServer,
                            10,
                            [unmaskedFrame(0x01, five),
                             unmaskedFrame(0x89, Bytes.repeat(<<0>>, 100)),
                             unmaskedFrame(0x80, more)]),
                    answers(FromServer, 10, [unmaskedFrame(0x01, five), <<0x80, 6>>]),
                    answers(FromServer,
                            10,
                            [unmaskedFrame(0x02, five), unmaskedFrame(0x00, <<1>>), <<0x80, 5>>]),
                    answers(FromServer, 10, [<<0x81, 11>>]),
                    answers(FromServer, -1, [<<0x81, 0>>, <<0x82, 1>>]),
                    answers(FromClient, 10, [<<0x82, 0xFE, 0x01, 0x00>>]),
                    answers(FromServer, 10, [<<0x82, 127, 0x40, 0, 0, 0, 0, 0, 0, 0>>])],
                   [[Right([]), Right([Text("1234567890")])],
                    [Right([]),
                     Right([Ping(Bytes.repeat(<<0>>, 100))]),
                     Right([Text("1234567890")])],
                    [Right([]), Left(TooBig)],
                    [Right([]), Right([]), Left(TooBig)],
                    [Left(TooBig)],
                    [Right([Text("")]), Left(TooBig)],
                    [Left(TooBig)],
                    [Left(TooBig)]])
    })

// design §10: a text message that is not UTF-8 is NotUtf8 at its final
// frame, its fragments joined first, so that a character split between two
// fragments is taken; and so is a close's reason; a binary message's bytes
// are not read as text.
let refusesTextThatIsNotUtf8 =
    Test.Case(name = "refuses a text or a close's reason that is not UTF-8",
              run = fn() =
                  Test.equal([[decoded(FromServer, unmaskedFrame(0x81, <<0xC0, 0xAF>>))],
                              answers(FromServer,
                                      testLimit,
                                      [unmaskedFrame(0x01, <<0xCE>>),
                                       unmaskedFrame(0x80, <<0xBA>>)]),
                              answers(FromServer,
                                      testLimit,
                                      [unmaskedFrame(0x01, <<0xCE>>),
                                       unmaskedFrame(0x80, <<0x41>>)]),
                              [decoded(FromServer,
                                       unmaskedFrame(0x88, <<0x03, 0xE8, 0xED, 0xA0, 0x80>>))],
                              [decoded(FromServer, unmaskedFrame(0x82, <<0xC0, 0xAF>>))]],
                             [[Left(NotUtf8)],
                              [Right([]), Right([Text("κ")])],
                              [Right([]), Left(NotUtf8)],
                              [Left(NotUtf8)],
                              [Right([Binary(<<0xC0, 0xAF>>)])]]))

// design §10: a ping, a pong and a close between two fragments are answered
// in their place, before the message they stand inside; and a frame after a
// close is decoded as any other.
let answersControlFramesInTheirPlace =
    Test.Case(name = "answers a control frame between two fragments in its place",
              run = fn() =
                  Test.equal([decoded(FromServer, fragmentHel <> unmaskedPing <> fragmentLo),
                              decoded(FromServer,
                                      fragmentHel
                                          <> unmaskedFrame(0x8A, <<>>)
                                          <> unmaskedFrame(0x88, <<0x03, 0xE8>>)
                                          <> fragmentLo),
                              decoded(FromClient,
                                      maskedFrame(0x01, String.toUtf8("Hel"))
                                          <> maskedPong
                                          <> maskedFrame(0x80, String.toUtf8("lo"))),
                              decoded(FromServer, unmaskedFrame(0x88, <<>>) <> unmaskedHello)],
                             [Right([Ping(hello), Text("Hello")]),
                              Right([Pong(<<>>),
                                     Close(code = Some(1000), reason = ""),
                                     Text("Hello")]),
                              Right([Pong(hello), Text("Hello")]),
                              Right([Close(code = None, reason = ""), Text("Hello")])]))

// design §10: RFC 6455's masked "Hello" split across two calls of decode at
// every byte boundary is answered once all of it has come, the decoder
// holding the frame's bytes so far; and so given a byte a call.
let decodesAFrameSplitAnywhere =
    Test.Case(name = "decodes a frame split at any byte", run = fn() = {
        let size = Bytes.size(maskedHello);
        let split =
            fn(index) =
                answers(FromClient,
                        testLimit,
                        [Bytes.slice(maskedHello, 0, index),
                         Bytes.slice(maskedHello, index, size)]);
        let expected =
            fn(index) =
                if index == size then
                    [Right([Text("Hello")]), Right([])]
                else
                    [Right([]), Right([Text("Hello")])];
        let bytewise = List.map(Bytes.toList(maskedHello), fn(byte) = <<byte>>);
        Test.equal(#(List.map(List.range(0, size), split),
                     answers(FromClient, testLimit, bytewise)),
                   #(List.map(List.range(0, size), expected),
                     List.repeat(Right([]), size - 1) <> [Right([Text("Hello")])]))
    })

// design §10: a message of two frames across two calls is answered at its
// final frame, the decoder holding its first fragment between them; bytes
// that end one message and begin the next answer the first and hold the
// rest; and no bytes answer no message.
let decodesAMessageAcrossCalls =
    Test.Case(name = "decodes a message across two calls",
              run = fn() =
                  Test.equal([answers(FromServer, testLimit, [fragmentHel, fragmentLo]),
                              answers(FromServer,
                                      testLimit,
                                      [unmaskedHello
                                           <> unmaskedPing
                                           <> Bytes.slice(fragmentHel, 0, 3),
                                       Bytes.slice(fragmentHel, 3, 5) <> fragmentLo]),
                              answers(FromServer, testLimit, [<<>>, <<>>])],
                             [[Right([]), Right([Text("Hello")])],
                              [Right([Text("Hello"), Ping(hello)]), Right([Text("Hello")])],
                              [Right([]), Right([])]]))

// design §10: closeCode is 1002 for ProtocolError, 1009 for TooBig and 1007
// for NotUtf8.
let givesCloseCodes =
    Test.Case(name = "gives each error its close code",
              run = fn() =
                  Test.equal(List.map([ProtocolError, TooBig, NotUtf8], closeCode),
                             [1002, 1009, 1007]))

// design §10: encode's frame decodes through a FromServer decoder to its
// message, and encodeMasked's through a FromClient decoder, at the edges of
// the three length forms, one frame a call and all in one; encodeMasked
// answers None for a key of another size.
let roundTrips = Test.Case(name = "decodes what it encodes", run = fn() = {
    let messages =
        [Text(""),
         Text("κόσμε"),
         Binary(<<>>),
         Binary(Bytes.repeat(<<1>>, 125)),
         Binary(Bytes.repeat(<<2>>, 126)),
         Binary(Bytes.repeat(<<3>>, 65535)),
         Binary(Bytes.repeat(<<4>>, 65536)),
         Ping(<<>>),
         Ping(Bytes.repeat(<<5>>, 125)),
         Pong(hello),
         Close(code = None, reason = ""),
         Close(code = Some(1000), reason = ""),
         Close(code = Some(4001), reason = "expired"),
         Close(code = Some(3000), reason = String.repeat("é", 61))];
    let key = <<1, 2, 3, 4>>;
    let unmasked = List.map(messages, encode);
    let maskedFrames = List.map(messages, fn(message) = encodeMasked(message, key));
    Test.equal(#(List.map(unmasked, fn(frame) = decoded(FromServer, frame)),
                 List.map(maskedFrames,
                          fn(frame) = Optional.map(frame, fn(bytes) = decoded(FromClient, bytes))),
                 decoded(FromServer, Bytes.join(unmasked, <<>>)),
                 decoded(FromClient,
                         Bytes.join(List.filterMap(maskedFrames, fn(frame) = frame), <<>>)),
                 List.map([<<>>, <<1, 2, 3>>, <<1, 2, 3, 4, 5>>],
                          fn(other) = encodeMasked(Text("Hello"), other))),
               #(List.map(messages, fn(message) = Right([message])),
                 List.map(messages, fn(message) = Some(Right([message]))),
                 Right(messages),
                 Right(messages),
                 [None, None, None]))
})

// design §10: a close with no code is written with no payload, its reason
// dropped, and read from an empty payload as no code and ""; one with a
// code is written as the code in two bytes and the reason, and read back.
let writesAndReadsCloses =
    Test.Case(name = "writes and reads a close with and without a code",
              run = fn() =
                  Test.equal(#([encode(Close(code = None, reason = "")),
                                encode(Close(code = None, reason = "dropped")),
                                encode(Close(code = Some(1000), reason = "")),
                                encode(Close(code = Some(1000), reason = "done"))],
                               [decoded(FromServer, <<0x88, 0x00>>),
                                decoded(FromServer, <<0x88, 0x02, 0x03, 0xE8>>),
                                decoded(FromServer,
                                        <<0x88, 0x06, 0x03, 0xE8, 0x64, 0x6F, 0x6E, 0x65>>)]),
                             #([<<0x88, 0x00>>,
                                <<0x88, 0x00>>,
                                <<0x88, 0x02, 0x03, 0xE8>>,
                                <<0x88, 0x06, 0x03, 0xE8, 0x64, 0x6F, 0x6E, 0x65>>],
                               [Right([Close(code = None, reason = "")]),
                                Right([Close(code = Some(1000), reason = "")]),
                                Right([Close(code = Some(1000), reason = "done")])])))

// design §10: encode writes a message as given, a control message past 125
// bytes and a close of a code the RFC does not allow among them, a frame a
// decoder refuses; a close code that does not fit two bytes faults.
let writesAsGiven = Test.Case(name = "writes a message as given", run = fn() = {
    let written =
        Test.equal([decoded(FromServer, encode(Ping(Bytes.repeat(<<0>>, 126)))),
                    decoded(FromServer, encode(Close(code = Some(1005), reason = "")))],
                   [Left(ProtocolError), Left(ProtocolError)]);
    match written {
        Test.Passed ->
            Test.faults(fn() = encode(Close(code = Some(70000), reason = "")),
                        "segment overflow: 70000 does not fit 16 bits")
      | failed ->
            failed
    }
})
