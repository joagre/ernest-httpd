/// The program's entry point: the server started from its configuration
/// and stopped in order at the program's end (design §2).
///
/// `main` takes the configuration's path, the one argument, and reads the
/// file; a file that breaks a rule is refused with the field named, before
/// anything listens. It then starts the access log and, where the
/// configuration has a `shell`, the sessions, and for each listener of the
/// configuration listens, over TLS with the certificate and the key for a
/// `tls` listener, says the port it got, and spawns the listener's process,
/// whose connections share the configuration, the site, the access log,
/// the sessions where there are any and, for the `redirect` listener, the
/// ACME challenge's site. At the program's end, a termination signal, it
/// stops the sessions first, which closes every shell with 1001 and ends
/// every session, and waits for them; then it tells each listener to stop,
/// waits for each to end its connections in order, has the access log
/// write what it holds, and lets the end go on.
///
/// The exit statuses are 2 for a command line of another count of
/// arguments, 1 for a configuration refused and a listen that fails, and
/// the signal's at the end. A listener's process that ends before the end
/// is a failure: the entry process stops the sessions and the other
/// listeners, as at the end, says so on standard error, and exits with the
/// status 1.
///
/// ## Examples
///
/// Run by its launcher, the configuration's path its argument:
///
/// ```sh
/// bin/ernest_httpd /etc/ernest-httpd/config.json
/// ```

//
// Types
//

/// What the entry process takes: the program's end, with the reply the end
/// waits for, and a listener's process ending.
export type MainMsg = Terminated(Reply(Unit)) | ListenerEnded(Down)

//
// Program
//

/// The program: the configuration read from the path its one argument
/// names, the listeners served, and the end taken in order.
export fn main() : Unit receiving MainMsg =
    match Os.arguments {
        [path] ->
            started(path)
      | _ -> {
            Io.printlnError("usage: ernest_httpd config.json");
            Os.exit(2)
        }
    }

// The configuration read within 5000 milliseconds and refused with the
// path where it breaks a rule.
fn started(path : String) : Unit receiving MainMsg =
    match Config.read(Path(path), 5000) {
        Left(error) -> refused(path, Config.reason(error))
      | Right(config) -> serving(config)
    }

fn refused(path : String, reason : String) : Unit = {
    Io.printlnError(path <> ": " <> reason);
    Os.exit(1)
}

// The site made, the access log started, the sessions started where the
// configuration has a shell, and each listener serving with its server,
// and then the wait for the program's end.
fn serving(config : Config.Config) : Unit receiving MainMsg = {
    let site = Static.site(config.root, config.contentTypes);
    let log = AccessLog.start(config.accessLog, config.timeouts.file);
    let sessions = Optional.map(config.shell, fn(shell) = Sessions.start(shell, config.timeouts));
    let listeners = List.map(config.listeners, fn(listener) = {
        let server =
            Connection.Server(=config,
                              =site,
                              challenge = challenge(config, listener),
                              =log,
                              =sessions);
        listening(listener, server)
    });
    Os.termination(Terminated);
    waiting(Started(=listeners, =log, =sessions))
}

// What the entry process started and stops at the end: the listeners, the
// access log, and the sessions where there are any.
type Started =
    Started(listeners : List(Address(Listener.ListenerMsg)),
            log : Address(AccessLog.LogMsg),
            sessions : Optional(Sessions.Sessions))

// The challenge site of a redirect listener: its directory's
// .well-known/acme-challenge, with the configuration's content types
// (design §9); None for another listener.
fn challenge(config : Config.Config, listener : Config.Listener) : Optional(Static.Site) =
    match listener.kind {
        Config.Redirect(=acmeChallenge) ->
            Some(Static.site(acmeChallenge <> Path(".well-known/acme-challenge"),
                             config.contentTypes))
      | Config.Plain or Config.Tls() ->
            None
    }

// A listener of the configuration listening, its address and port said on
// standard output, and its process spawned and monitored; a listen that
// fails is said on standard error and ends the program.
fn listening(listener : Config.Listener,
             server : Connection.Server) : Address(Listener.ListenerMsg) receiving MainMsg = {
    let opened = {
        let socket <- listened(listener);
        let port <- Tcp.port(socket);
        Right(#(socket, port))
    };
    match opened {
        Right(#(socket, port)) -> {
            Io.println("listening on " <> listener.address <> ":" <> Int.toString(port));
            spawnMonitored(fn() = Listener.serve(socket, server), ListenerEnded)
        }
      | Left(error) -> {
            Io.printlnError(listener.address
                                <> ":"
                                <> Int.toString(listener.port)
                                <> ": "
                                <> Io.show(error));
            Os.exit(1)
        }
    }
}

// The listening socket of the listener's kind: over TLS, with its
// certificate and its key, for a tls listener, and plain for another.
fn listened(listener : Config.Listener) : Either(Io.Error, Address(Tcp.ListenerMsg)) =
    match listener.kind {
        Config.Tls(=certificate, =key) ->
            Tcp.listenTls(listener.address, listener.port, certificate, key)
      | Config.Plain or Config.Redirect() ->
            Tcp.listen(listener.address, listener.port)
    }

// The wait for the program's end, which is taken in order before its
// reply is answered. A listener that ends before is a failure of the
// program: the sessions and the others are stopped and the log written as
// at the end, the listener's reason said on standard error, and the program
// ends with the status 1.
fn waiting(started : Started) : Unit receiving MainMsg =
    receive {
        Terminated(reply) -> {
            stopped(started, List.size(started.listeners));
            answer(reply, Unit)
        }
      | ListenerEnded(down) -> {
            stopped(started, List.size(started.listeners) - 1);
            Io.printlnError("a listener ended: " <> Io.show(down.reason));
            Os.exit(1)
        }
    }

// The sessions stopped where there are any, and waited for; then each
// listener told to stop, the count of them that live waited for to end,
// and the access log flushed.
fn stopped(started : Started, count : Int) : Unit receiving MainMsg = {
    match started.sessions {
        Some(sessions) -> Address.callForever(sessions.address, Sessions.Stop)
      | None -> Unit
    };
    List.forEach(started.listeners, fn(listener) = send(listener, Listener.Stop));
    ended(count);
    Address.callForever(started.log, AccessLog.Flush)
}

// Each of the count of listeners waited for to end.
fn ended(count : Int) : Unit receiving MainMsg =
    if count == 0 then
        Unit
    else receive {
        ListenerEnded(_) -> ended(count - 1)
    }

//
// Tests
//

// The scratch directory the tests write their configurations and site
// under; the tests run the launcher from the repository's root, where make
// test runs them.
let scratch : String = "build/scratch/ernest_httpd"

// A configuration of the scratch site, with the listeners given, as JSON,
// and a redirect host.
fn configuration(listeners : String) : String =
    "{\"listeners\": ["
        <> listeners
        <> "],\n"
        <> " \"root\": \""
        <> scratch
        <> "/site\", \"canonical-host\": \"localhost\", \"redirect-hosts\": [\"www.localhost\"],\n"
        <> " \"timeouts\": {\"head\": 5000, \"idle\": 60000, \"write\": 5000, \"file\": 5000},\n"
        <> " \"limits\": {\"request-line\": 1024, \"headers\": 4096,\n"
        <> "            \"connections\": 8, \"connections-per-address\": 8},\n"
        <> " \"content-types\": {}, \"headers\": {},\n"
        <> " \"access-log\": \""
        <> scratch
        <> "/access.log\"}\n"

fn plain(port : Int) : String =
    "{\"kind\": \"plain\", \"address\": \"127.0.0.1\", \"port\": " <> Int.toString(port) <> "}"

// A tls listener of the certificate's and the key's files, named under the
// scratch directory.
fn tls(certificate : String, key : String) : String =
    "{\"kind\": \"tls\", \"address\": \"127.0.0.1\", \"port\": 0, \"certificate\": \""
        <> scratch
        <> "/"
        <> certificate
        <> "\", \"key\": \""
        <> scratch
        <> "/"
        <> key
        <> "\"}"

// The redirect listener, its challenge's directory acme under the scratch
// directory.
let redirect : String =
    "{\"kind\": \"redirect\", \"address\": \"127.0.0.1\", \"port\": 0, \"acme-challenge\": \""
        <> scratch
        <> "/acme\"}"

// A self-signed certificate for localhost, EC P-256, made once with openssl
// for the tests and valid to 2126, and its key; no key's file stands in the
// repository, and the tests write both under the scratch directory.
let certificate : String =
    "-----BEGIN CERTIFICATE-----\n"
        <> "MIIBfzCCASWgAwIBAgIUdxJK52fcfMJzTDM31Jn/OzcH9NswCgYIKoZIzj0EAwIw\n"
        <> "FDESMBAGA1UEAwwJbG9jYWxob3N0MCAXDTI2MTEwMjA3NTA0OFoYDzIxMjYxMDA5\n"
        <> "MDc1MDQ4WjAUMRIwEAYDVQQDDAlsb2NhbGhvc3QwWTATBgcqhkjOPQIBBggqhkjO\n"
        <> "PQMBBwNCAAQMt4oqG4LxajICOU/uBLydvgc7gOX+w1ucQgmDDMsPcqC1wCSV36xr\n"
        <> "NvaLXsKeReEaTV1JLMUAEg3DqxZyrkrlo1MwUTAdBgNVHQ4EFgQU44TLdYD+nf7N\n"
        <> "LvvxGzX6VyciH0YwHwYDVR0jBBgwFoAU44TLdYD+nf7NLvvxGzX6VyciH0YwDwYD\n"
        <> "VR0TAQH/BAUwAwEB/zAKBggqhkjOPQQDAgNIADBFAiAw/M9xVbebHBwmrS92MLQz\n"
        <> "QB1TcfaEXpOyLfigR38+UAIhAL3E1cUqfnMQDGg+SKuhWudI7ZWl37Oy7QnP6U+B\n"
        <> "f4je\n"
        <> "-----END CERTIFICATE-----\n"

let key : String =
    "-----BEGIN PRIVATE KEY-----\n"
        <> "MIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgw7sj0Cj2DxBdjSns\n"
        <> "3K/PHxZXeLFzGE2JRWuRg4ITQaChRANCAAQMt4oqG4LxajICOU/uBLydvgc7gOX+\n"
        <> "w1ucQgmDDMsPcqC1wCSV36xrNvaLXsKeReEaTV1JLMUAEg3DqxZyrkrl\n"
        <> "-----END PRIVATE KEY-----\n"

// The configuration written to the scratch directory under the name, and
// its path; beside it the site, the test's certificate and key, the key
// the user's alone, an empty file the host refuses as either, also the
// user's alone, and the challenge's directory with a token's file.
fn written(name : String, text : String) : Either(Io.Error, String) = {
    let path = scratch <> "/" <> name;
    let challenges = scratch <> "/acme/.well-known/acme-challenge";
    let _ <- Fs.makeDir(Path(scratch <> "/site"), 5000);
    let _ <- Fs.makeDir(Path(challenges), 5000);
    let _ <- Fs.write(Path(scratch <> "/site/a.txt"), String.toUtf8("alpha"), 5000);
    let _ <- Fs.write(Path(challenges <> "/token-1"), String.toUtf8("token-1.key"), 5000);
    let _ <- Fs.write(Path(scratch <> "/certificate.pem"), String.toUtf8(certificate), 5000);
    let _ <- Fs.write(Path(scratch <> "/key.pem"), String.toUtf8(key), 5000);
    let _ <- Fs.setMode(Path(scratch <> "/key.pem"), 0o600, 5000);
    let _ <- Fs.write(Path(scratch <> "/empty.pem"), <<>>, 5000);
    let _ <- Fs.setMode(Path(scratch <> "/empty.pem"), 0o600, 5000);
    let _ <- Fs.write(Path(path), String.toUtf8(text), 5000);
    Right(path)
}

// What a test's process takes: a run of the launcher's outcome, by the
// index of its arguments.
type Ran = Ran(index : Int, outcome : Either(Io.Error, Os.Finished))

// The launcher run to its end with each list of arguments, the runs at
// once, each in a process of its own, since each starts a runtime: their
// outcomes, in the order given.
fn ran(runs : List(List(String))) : List(Either(Io.Error, Os.Finished)) receiving Ran = {
    let me = self();
    List.forEach(List.indexed(runs), fn(#(index, arguments)) = {
        let _ =
            spawn(fn() =
                      send(me,
                           Ran(=index,
                               outcome = Os.run(Os.Command(program = "bin/ernest_httpd",
                                                           =arguments,
                                                           input = <<>>),
                                                30000))));
        Unit
    });
    List.map(List.indexed(runs), fn(#(wanted, _)) = receive {
        Ran(=index, =outcome) when index == wanted -> outcome
      | after 60000 -> Left(Io.Timeout)
    })
}

// design §2: what the entry process refuses before it serves, each with its
// line on standard error and nothing on standard output: a command line of
// another count of arguments than one with the usage and the status 2; a
// configuration that breaks a rule with the path and the reason, and the
// status 1; and a listen that fails, its port taken, and a TLS listen whose
// certificate's file holds none, each with the address, the port and the
// error as Io.show writes it, the file's name and what is wrong for the
// certificate, and the status 1.
let refusesStarts = Test.Case(name = "refuses what it cannot serve", run = fn() = {
    let result = {
        let taken <- Tcp.listen("127.0.0.1", 0);
        let port <- Tcp.port(taken);
        let bad <- written("bad.json", "{}");
        let busy <- written("taken.json", configuration(plain(port)));
        let refusedCertificate <- written("tls.json", configuration(tls("empty.pem", "empty.pem")));
        let outcomes = ran([[], ["a.json", "b.json"], [bad], [busy], [refusedCertificate]]);
        Tcp.closeListener(taken);
        Right(#(outcomes, port))
    };
    // an outcome as the test compares it: the status, standard output and
    // standard error
    fn compared(outcome : Either(Io.Error,
                                 Os.Finished)) : Either(Io.Error, #(Int, String, String)) =
        Either.map(outcome, fn(finished) = {
            let text = fn(bytes) = Optional.withDefault(String.fromUtf8(bytes), "?");
            #(finished.status, text(finished.stdout), text(finished.stderr))
        });
    match result {
        Right(#(outcomes, port)) ->
            Test.equal(List.map(outcomes, compared),
                       [Right(#(2, "", "usage: ernest_httpd config.json\n")),
                        Right(#(2, "", "usage: ernest_httpd config.json\n")),
                        Right(#(1, "", scratch <> "/bad.json: listeners is required\n")),
                        Right(#(1,
                                "",
                                "127.0.0.1:"
                                    <> Int.toString(port)
                                    <> ": Other(\"address already in use\")\n")),
                        Right(#(1,
                                "",
                                "127.0.0.1:0: Other(\""
                                    <> scratch
                                    <> "/empty.pem: no certificate\")\n"))])
      | Left(error) ->
            Test.Failed(Io.show(error))
    }
})

// What a running program writes to standard output until its lines are
// the count, and the text so far.
fn lines(program : Address(Os.ProgramMsg), acc : String, count : Int) : Either(Io.Error, String) =
    if List.size(String.lines(acc)) >= count && String.endsWith(acc, "\n") then
        Right(acc)
    else match Os.read(program, 30000) {
        Right(Os.Stdout(bytes)) ->
            lines(program, acc <> Optional.withDefault(String.fromUtf8(bytes), "?"), count)
      | Right(Os.Stderr(_)) ->
            lines(program, acc, count)
      | Right(Os.Exited(status)) ->
            Left(Io.Other("exited with " <> Int.toString(status) <> " after " <> acc))
      | Left(error) ->
            Left(error)
    }

// A running program's status once it has exited, what it writes before
// left unread.
fn exited(program : Address(Os.ProgramMsg)) : Either(Io.Error, Int) =
    match Os.read(program, 30000) {
        Right(Os.Exited(status)) -> Right(status)
      | Right(_) -> exited(program)
      | Left(error) -> Left(error)
    }

// The response to a GET of the target naming the host, written to the
// socket: its status, and its Location where it has one or else its body
// as text.
fn got(socket : Address(Tcp.SocketMsg),
       target : String,
       host : String) : Either(Io.Error, String) = {
    let request =
        Http.Request(method = "GET",
                     =target,
                     version = Http.Version(major = 1, minor = 1),
                     headers = [Http.Header(name = "Host", value = host)]);
    let _ <- Tcp.write(socket, Http.renderRequest(request, <<>>), 5000);
    let limits = Http.Limits(line = 1024, headers = 4096);
    let #(response, rest) <-
        Either.mapLeft(Http.readResponse(socket, <<>>, limits, 5000), fn(_) = Io.Invalid);
    let #(body, _) <-
        Either.mapLeft(Http.readResponseBody(socket, rest, response, 4096, 5000),
                       fn(_) = Io.Invalid);
    let text =
        Http.header(response.headers, "Location")
            |> Optional.withDefault(Optional.withDefault(String.fromUtf8(body), "?"));
    Right(Int.toString(response.status) <> " " <> text)
}

// What the socket answers next: `closed` where the connection closed, and
// otherwise what came.
fn next(socket : Address(Tcp.SocketMsg)) : String =
    match Tcp.read(socket, 5000) {
        Left(Io.Closed) -> "closed"
      | other -> Io.show(other)
    }

// What a connect to the port answers: `connected`, or the error.
fn connecting(port : Int) : String =
    match Tcp.connect("127.0.0.1", port, 5000) {
        Right(_) -> "connected"
      | Left(error) -> Io.show(error)
    }

// The ports the program says it listens on, in its listeners' order.
fn ports(listening : List(String)) : List(Int) =
    List.filterMap(listening,
                   fn(line) = String.toInt(String.replace(line, "listening on 127.0.0.1:", "")))

// The program's answers on its plain, its TLS and its redirect listener,
// each over one connection kept alive: the site's file on the plain one,
// and a host that is neither; the file over TLS; a redirect to the
// canonical host and the challenge's file on the redirect listener. Then
// the three sockets, to be read at the end.
fn answered(plainPort : Int,
            tlsPort : Int,
            redirectPort : Int) : Either(Io.Error,
                                         #(List(String), List(Address(Tcp.SocketMsg)))) = {
    let plainSocket <- Tcp.connect("127.0.0.1", plainPort, 5000);
    let file <- got(plainSocket, "/a.txt", "localhost");
    let misdirected <- got(plainSocket, "/a.txt", "example.com");
    let tlsSocket <- Tcp.connectTls("localhost", tlsPort, Tcp.Unverified, 5000);
    let fileOverTls <- got(tlsSocket, "/a.txt", "localhost");
    let redirectSocket <- Tcp.connect("127.0.0.1", redirectPort, 5000);
    let moved <- got(redirectSocket, "/docs?page=2", "localhost");
    let challenge <- got(redirectSocket, "/.well-known/acme-challenge/token-1", "www.localhost");
    Right(#([file, misdirected, fileOverTls, moved, challenge],
            [plainSocket, tlsSocket, redirectSocket]))
}

// The access log's lines after the time each holds, sorted, since
// connections tell their entries in no order among them; and whether every
// line begins with the remote address and the time.
fn logged(text : String) : #(List(String), Bool) = {
    let lines = String.lines(text);
    let afterTime = fn(line) = Optional.map(String.splitOnce(line, "] "), fn(#(_, rest)) = rest);
    #(List.sort(List.filterMap(lines, afterTime)),
      List.all(lines, fn(line) = String.startsWith(line, "127.0.0.1 - - [")))
}

// The configuration of the listeners given with a shell on the path
// `/shell`, whose command is `cat`.
fn withShell(listeners : String) : String =
    String.replace(configuration(listeners),
                   "/access.log\"}\n",
                   "/access.log\",\n"
                       <> " \"shell\": {\"path\": \"/shell\", \"origins\": [\"http://localhost\"],\n"
                       <> "           \"command\": [\"cat\"], \"most-at-once\": 2,\n"
                       <> "           \"starts\": {\"count\": 10, \"within\": 60000},\n"
                       <> "           \"lifetime\": 60000, \"warning\": 30000,\n"
                       <> "           \"message-limit\": 1024, \"hangup\": 1000}}\n")

// A frame a client writes, masked with a key of its own.
fn masked(message : WebSocket.Message) : Bytes =
    Optional.withDefault(WebSocket.encodeMasked(message, Crypto.randomBytes(4)), <<>>)

// A shell's client on the port, its upgrade written without a cookie: the
// 101 and the bytes after its head, and the socket.
fn upgraded(port : Int) : Either(Io.Error, #(Http.Response, Bytes, Address(Tcp.SocketMsg))) = {
    let socket <- Tcp.connect("127.0.0.1", port, 5000);
    let request =
        Http.Request(method = "GET",
                     target = "/shell",
                     version = Http.Version(major = 1, minor = 1),
                     headers = [Http.Header(name = "Host", value = "localhost"),
                                Http.Header(name = "Upgrade", value = "websocket"),
                                Http.Header(name = "Connection", value = "Upgrade"),
                                Http.Header(name = "Sec-WebSocket-Version", value = "13"),
                                Http.Header(name = "Origin", value = "http://localhost"),
                                Http.Header(name = "Sec-WebSocket-Key",
                                            value = Base64.encode(Crypto.randomBytes(16)))]);
    let _ <- Tcp.write(socket, Http.renderRequest(request, <<>>), 5000);
    let #(response, rest) <-
        Either.mapLeft(Http.readResponse(socket,
                                         <<>>,
                                         Http.Limits(line = 1024, headers = 4096),
                                         5000),
                       fn(_) = Io.Invalid);
    Right(#(response, rest, socket))
}

// A shell's client on the port, upgraded, the terminal resized and a line
// typed, and the binary messages read until they hold the line twice, the
// terminal's echo and cat's: the 101's status, whether it set a cookie, the
// text read, and the socket and its decoder, to be read at the end.
fn shellClient(port : Int) : Either(Io.Error,
                                    #(Int,
                                      Bool,
                                      String,
                                      Address(Tcp.SocketMsg),
                                      WebSocket.Decoder)) = {
    let #(response, rest, socket) <- upgraded(port);
    let typed =
        masked(WebSocket.Text("{\"resize\": [24, 80]}"))
            <> masked(WebSocket.Binary(String.toUtf8("hello\n")));
    let _ <- Tcp.write(socket, typed, 5000);
    let #(text, decoder) <-
        echoed(socket,
               WebSocket.decoder(WebSocket.FromServer, 65536),
               rest,
               "",
               "hello\r\nhello\r\n");
    Right(#(response.status,
            Http.header(response.headers, "Set-Cookie") != None,
            text,
            socket,
            decoder))
}

// The binary messages the socket carries, the bytes carried first, as text
// until it holds the line; and the decoder after them.
fn echoed(socket : Address(Tcp.SocketMsg),
          decoder : WebSocket.Decoder,
          carried : Bytes,
          acc : String,
          line : String) : Either(Io.Error, #(String, WebSocket.Decoder)) =
    if String.contains(acc, line) then
        Right(#(acc, decoder))
    else {
        let #(messages, rest) <-
            Either.mapLeft(WebSocket.decode(decoder, carried), fn(_) = Io.Invalid);
        let text = List.foldLeft(messages, acc, fn(sofar, message) = match message {
            WebSocket.Binary(bytes) -> sofar <> Optional.withDefault(String.fromUtf8(bytes), "?")
          | other -> sofar <> Io.show(other)
        });
        if String.contains(text, line) then
            Right(#(text, rest))
        else {
            let bytes <- Tcp.read(socket, 5000);
            echoed(socket, rest, bytes, text, line)
        }
    }

// The next message the shell's socket carries, and what the socket answers
// after it.
fn closing(socket : Address(Tcp.SocketMsg), decoder : WebSocket.Decoder) : String =
    match Tcp.read(socket, 5000) {
        Right(bytes) ->
            match WebSocket.decode(decoder, bytes) {
                Right(#([WebSocket.Close(code = Some(code))], _)) ->
                    "Close(" <> Int.toString(code) <> "), " <> next(socket)
              | other ->
                    Io.show(other)
            }
      | Left(error) ->
            Io.show(error)
    }

// design §1, §2, §3, §9, §11, §12: the program, its modules together, says
// the port each of its listeners listens on, a plain, a tls and a redirect
// listener; serves a request for a file from the site over HTTP/1.1, plain
// and over TLS, answers a host that is neither with 421, redirects to the
// canonical host and serves the ACME challenge on the redirect listener,
// upgrades a request on the shell's path, setting its cookie, and carries
// the keys typed to `cat` under a terminal and its output back, and tells
// each response to the access log; at the termination signal it stops the
// sessions first, which closes the attached shell with 1001, then its
// listeners at once, which close the shell no session is attached to with
// 1001 and end the connections kept alive though the idle deadline is a
// minute, writes the log and ends by the signal, after which nothing is
// taken on the ports.
let servesAndEnds = Test.Case(name = "serves the site and ends in order", run = fn() = {
    let result = {
        let path <-
            written("serving.json",
                    withShell(plain(0)
                                  <> ", "
                                  <> tls("certificate.pem", "key.pem")
                                  <> ", "
                                  <> redirect));
        let _ <- match Fs.remove(Path(scratch <> "/access.log"), 5000) {
            Right(Unit) or Left(Io.NotFound) -> Right(Unit)
          | Left(error) -> Left(error)
        };
        // the shell's process number is the server's, the shell and the
        // launcher each running the next in its place
        let program <-
            Os.start(Os.Command(program = "sh",
                                arguments = ["-c", "echo $$; exec bin/ernest_httpd \"$0\"", path],
                                input = <<>>));
        let out <- lines(program, "", 4);
        let #(pid, listening) = match String.lines(out) {
            first :: rest -> #(first, rest)
          | [] -> #("", [])
        };
        let #(plainPort, tlsPort, redirectPort) = match ports(listening) {
            [one, two, three] -> #(one, two, three)
          | _ -> #(0, 0, 0)
        };
        let #(answers, sockets) <- answered(plainPort, tlsPort, redirectPort);
        let #(upgradeStatus, cookieSet, typed, shellSocket, decoder) <- shellClient(plainPort);
        let #(_, _, unattached) <- upgraded(plainPort);
        let start = Clock.monotonic();
        let _ <-
            Os.run(Os.Command(program = "kill", arguments = ["-TERM", pid], input = <<>>), 5000);
        let status <- exited(program);
        let took = Clock.monotonic() - start;
        let shellEnd = closing(shellSocket, decoder);
        let unattachedEnd = closing(unattached, WebSocket.decoder(WebSocket.FromServer, 65536));
        let kept = List.map(sockets, next);
        let later = List.map([plainPort, tlsPort, redirectPort], connecting);
        let text <- Fs.read(Path(scratch <> "/access.log"), 5000);
        Right(#(listening
                    == List.map([plainPort, tlsPort, redirectPort],
                                fn(port) = "listening on 127.0.0.1:" <> Int.toString(port)),
                answers,
                #(upgradeStatus, cookieSet, typed, shellEnd, unattachedEnd),
                status,
                took < 3000,
                kept,
                later,
                Optional.map(String.fromUtf8(text), logged)))
    };
    Test.equal(result,
               Right(#(true,
                       ["200 alpha",
                        "421 421 Misdirected Request\n",
                        "200 alpha",
                        "301 https://localhost/docs?page=2",
                        "200 token-1.key"],
                       #(101,
                         true,
                         "hello\r\nhello\r\n",
                         "Close(1001), closed",
                         "Close(1001), closed"),
                       143,
                       true,
                       ["closed", "closed", "closed"],
                       ["Refused", "Refused", "Refused"],
                       Some(#(["\"GET /.well-known/acme-challenge/token-1 HTTP/1.1\" 200 11",
                               "\"GET /a.txt HTTP/1.1\" 200 5",
                               "\"GET /a.txt HTTP/1.1\" 200 5",
                               "\"GET /a.txt HTTP/1.1\" 421 24",
                               "\"GET /docs?page=2 HTTP/1.1\" 301 0",
                               "\"GET /shell HTTP/1.1\" 101 0",
                               "\"GET /shell HTTP/1.1\" 101 0"],
                              true)))))
})
