/// The sessions: one process that holds every visitor's session by its
/// cookie, starts one within the caps, and ends them all at the program's
/// end (design §12).
///
/// A shell attaches with its cookie, `Attach`: a cookie that names a live
/// session is passed to it, and another starts a session of the page's
/// size where fewer than `most-at-once` live, fewer than `per-address` of
/// them were started from the shell's counted address, and that address
/// has made fewer than `starts.count` starts within the last
/// `starts.within` milliseconds; otherwise the shell is told `Unavailable`.
/// A visitor is so counted by its counted address, `Remote.counted` of its
/// remote address, which a cleared cookie does not change, nor another
/// address of the same IPv6 /64.
///
/// A session calls the sessions as its end begins, `SessionEnding`: its
/// cookie names it no more, and the call is then answered, so that every
/// attach passed to the session before stands in its mailbox, told its
/// end's code. The session is counted among the live until it has ended,
/// and an attach under its cookie meanwhile waits, held in order with any
/// other under that cookie, until it has ended, and is then taken as any
/// attach is, so that a visitor's restart starts its session in the place
/// of the one ending and never meets the cap, nor runs two programs at once.
///
/// `Stop` tells each attach waiting `Unavailable` and ends every session
/// with 1001, which closes every shell attached, and answers once each has
/// ended; after it every attach is told `Unavailable`.

//
// Types
//

/// The sessions, as a connection holds them: the shell's configuration, and
/// the address of the sessions' process.
export type Sessions = Sessions(shell : Config.Shell, address : Address(SessionsMsg))

/// What the sessions take: a shell's attach, with its cookie, its remote
/// address, the page's size and the shell's address; a session's call as
/// its end begins, and its end; and the request to stop, which the
/// program's end sends.
export type SessionsMsg =
    Attach(cookie : String, remote : String, size : Terminal.Size, shell : Address(Session.Told))
  | SessionEnding(Session.Ending)
  | SessionEnded(Down)
  | Stop(Reply(Unit))

// What the sessions hold: the shell's configuration and the deadlines each
// session is started with, the live sessions by their cookies, the ones
// whose end has begun with their cookies, counted among the live until they
// end, the attaches that wait for such a session's end by its cookie, in
// order, the counted address each session counted was started from, and
// the times of the starts within the window by counted address, as
// Clock.monotonic counts them.
type Held =
    Held(shell : Config.Shell,
         timeouts : Config.Timeouts,
         live : Map(String, Address(Session.SessionMsg)),
         ending : Map(Process, String),
         waiting : Map(String, List(Waiting)),
         startedFrom : Map(Process, String),
         starts : Map(String, List(Int)))

// An attach that waits for the end of the session under its cookie: the
// shell's remote address, the page's size and the shell's address.
type Waiting = Waiting(remote : String, size : Terminal.Size, shell : Address(Session.Told))

//
// Serving
//

/// The sessions' process started, with the shell's configuration and the
/// deadlines each session is started with, and answered as `Sessions`.
export fn start(shell : Config.Shell, timeouts : Config.Timeouts) : Sessions =
    Sessions(=shell,
             address = spawn(fn() =
                                 serving(Held(=shell,
                                              =timeouts,
                                              live = Map.empty,
                                              ending = Map.empty,
                                              waiting = Map.empty,
                                              startedFrom = Map.empty,
                                              starts = Map.empty))))

// The sessions waiting on their mailbox: each message taken as it comes,
// until the stop.
fn serving(held : Held) : Unit receiving SessionsMsg =
    receive {
        Attach(=cookie, =remote, =size, =shell) ->
            serving(attached(held, cookie, remote, size, shell))
      | SessionEnding(Session.Ending(=process, =reply)) -> {
            let counted = ending(held, process);
            answer(reply, Unit);
            serving(counted)
        }
      | SessionEnded(down) ->
            serving(ended(held, down.process))
      | Stop(reply) -> {
            Map.forEach(held.waiting,
                        fn(_, waiting) =
                            List.forEach(waiting,
                                         fn(attach) = send(attach.shell, Session.Unavailable)));
            Map.forEach(held.live, fn(_, session) = send(session, Session.End(1001)));
            stopping(Held(..held, waiting = Map.empty));
            answer(reply, Unit);
            stopped()
        }
    }

// An attach passed to the live session its cookie names; held, after any
// other held under the cookie, where the session under it has begun its
// end; or otherwise admitted within the caps.
fn attached(held : Held,
            cookie : String,
            remote : String,
            size : Terminal.Size,
            shell : Address(Session.Told)) : Held receiving SessionsMsg =
    match Map.get(held.live, cookie) {
        Some(session) -> {
            send(session, Session.Attach(shell));
            held
        }
      | None ->
            if Map.any(held.ending, fn(_, under) = under == cookie) then {
                let attach = Waiting(=remote, =size, =shell);
                Held(..held,
                     waiting = Map.update(held.waiting,
                                          cookie,
                                          fn(waiting) =
                                              Optional.withDefault(waiting, []) <> [attach]))
            } else
                admitted(held, cookie, remote, size, shell)
    }

// An attach under a cookie that names no session: a session started for it
// where fewer than `most-at-once` live, those whose end has begun among
// them, fewer than `per-address` of the sessions counted were started from
// the shell's counted address, and that address made fewer than
// `starts.count` starts within the window, the start then counted; or the
// shell told Unavailable.
fn admitted(held : Held,
            cookie : String,
            remote : String,
            size : Terminal.Size,
            shell : Address(Session.Told)) : Held receiving SessionsMsg = {
    let address = Remote.counted(remote);
    let now = Clock.monotonic();
    let window = now - held.shell.starts.within;
    let made =
        List.filter(Optional.withDefault(Map.get(held.starts, address), []),
                    fn(time) = time > window);
    let fromAddress = Map.filter(held.startedFrom, fn(_, from) = from == address);
    if Map.size(held.live) + Map.size(held.ending) < held.shell.mostAtOnce
        && Map.size(fromAddress) < held.shell.perAddress
        && List.size(made) < held.shell.starts.count then {
        let config = held.shell;
        let timeouts = held.timeouts;
        let sessions = adapted(self(), SessionEnding);
        let session =
            spawnMonitored(fn() = Session.serve(config, timeouts, size, sessions), SessionEnded);
        send(session, Session.Attach(shell));
        Held(..held,
             live = Map.put(held.live, cookie, session),
             startedFrom = Map.put(held.startedFrom, Process.fromAddress(session), address),
             starts = Map.put(pruned(held.starts, window), address, now :: made))
    } else {
        send(shell, Session.Unavailable);
        held
    }
}

// The starts within the window, every counted address's, and an address
// with none dropped, so that the starts held are those that count.
fn pruned(starts : Map(String, List(Int)), window : Int) : Map(String, List(Int)) =
    Map.filterMap(starts, fn(_, times) = match List.filter(times, fn(time) = time > window) {
        [] -> None
      | within -> Some(within)
    })

// A session whose end has begun dropped by its cookie and counted among
// the ending, with its cookie, before its call is answered; one that has
// already ended, its call gone past and its end come first (report §6.9),
// is not counted again.
fn ending(held : Held, process : Process) : Held =
    match Map.find(held.live, fn(_, session) = Process.fromAddress(session) == process) {
        Some(#(cookie, _)) ->
            Held(..held,
                 live = without(held.live, process),
                 ending = Map.put(held.ending, process, cookie))
      | None ->
            held
    }

// A session that has ended dropped; where its end had begun, the attaches
// that wait for it under its cookie are then taken in order, as any attach
// is, so that the first may start a session in its place and those after it
// join that one.
fn ended(held : Held, process : Process) : Held receiving SessionsMsg =
    match Map.get(held.ending, process) {
        Some(cookie) ->
            List.foldLeft(Optional.withDefault(Map.get(held.waiting, cookie), []),
                          Held(..dropped(held, process),
                               waiting = Map.remove(held.waiting, cookie)),
                          fn(acc, Waiting(=remote, =size, =shell)) =
                              attached(acc, cookie, remote, size, shell))
      | None ->
            dropped(held, process)
    }

// A session that has ended dropped, live or ending, and counted no more.
fn dropped(held : Held, process : Process) : Held =
    Held(..held,
         live = without(held.live, process),
         ending = Map.remove(held.ending, process),
         startedFrom = Map.remove(held.startedFrom, process))

fn without(live : Map(String, Address(Session.SessionMsg)),
           process : Process) : Map(String, Address(Session.SessionMsg)) =
    Map.filter(live, fn(_, session) = Process.fromAddress(session) != process)

// The wait for each session's end, live or ending, every attach meanwhile
// told Unavailable, none waiting.
fn stopping(held : Held) : Unit receiving SessionsMsg =
    if Map.isEmpty(held.live) && Map.isEmpty(held.ending) then
        Unit
    else receive {
        SessionEnding(Session.Ending(=process, =reply)) -> {
            let counted = ending(held, process);
            answer(reply, Unit);
            stopping(counted)
        }
      | SessionEnded(down) ->
            stopping(dropped(held, down.process))
      | Attach(=shell) -> {
            send(shell, Session.Unavailable);
            stopping(held)
        }
    }

// The sessions after the stop, none live: every attach told Unavailable,
// and a stop answered at once.
fn stopped() : Unit receiving SessionsMsg =
    receive {
        Attach(=shell) -> {
            send(shell, Session.Unavailable);
            stopped()
        }
      | Stop(reply) -> {
            answer(reply, Unit);
            stopped()
        }
    }

//
// Tests
//

// What a test's process takes: what a shell is told, by the shell's name;
// and whether a stop the test made in a process of its own was answered.
type Seen = Heard(shell : String, told : Session.Told) | Stopped(Bool)

// Sessions of `cat` with the caps given, the starts' window in
// milliseconds.
fn started(mostAtOnce : Int, perAddress : Int, count : Int, within : Int) : Sessions =
    startedWith(["cat"], 5000, mostAtOnce, perAddress, count, within)

// Sessions of the command and the hangup given, with the caps given.
fn startedWith(command : List(String),
               hangup : Int,
               mostAtOnce : Int,
               perAddress : Int,
               count : Int,
               within : Int) : Sessions =
    start(Config.Shell(path = "/shell",
                       client = "/shell/client.js",
                       origins = ["http://localhost"],
                       =command,
                       =mostAtOnce,
                       =perAddress,
                       starts = Config.Starts(=count, =within),
                       lifetime = 60000,
                       warning = 30000,
                       messageLimit = 65536,
                       =hangup),
          Config.Timeouts(head = 5000, idle = 60000, write = 5000, file = 5000))

// The session the shell, which tells the test under the name, is attached
// to with the cookie from the remote address, or None where it is told
// otherwise.
fn attachedTo(sessions : Sessions,
              shell : Address(Session.Told),
              name : String,
              cookie : String,
              remote : String) : Optional(Address(Session.SessionMsg)) receiving Seen = {
    send(sessions.address,
         Attach(=cookie, =remote, size = Terminal.Size(rows = 24, columns = 80), =shell));
    receive {
        Heard(shell = from, told = Session.Attached(=session)) when from == name -> Some(session)
      | Heard(shell = from) when from == name -> None
      | after 5000 -> None
    }
}

// The output the named shell is told, as text, until it holds the text,
// within 5000 milliseconds of each piece.
fn heard(name : String, text : String, acc : String) : String receiving Seen =
    if String.contains(acc, text) then
        acc
    else receive {
        Heard(shell = from, told = Session.Output(bytes)) when from == name ->
            heard(name, text, acc <> Optional.withDefault(String.fromUtf8(bytes), "?"))
      | after 5000 ->
            acc <> " and nothing more"
    }

// A shell of a process of its own, which tells the test's process what it
// is told under the name and tells its session Written after each Output,
// as a shell does once the output is on its socket, until it is told
// Unavailable or Ended, at which a shell closes.
fn shell(name : String) : Address(Session.Told) receiving Seen = {
    let me = self();
    spawn(fn() = writingShell(me, name, None))
}

fn writingShell(test : Address(Seen),
                name : String,
                session : Optional(Address(Session.SessionMsg))) : Unit receiving Session.Told =
    receive {
        Session.Attached(session = attachedTo) as told -> {
            send(test, Heard(shell = name, =told));
            writingShell(test, name, Some(attachedTo))
        }
      | Session.Output(_) as told -> {
            send(test, Heard(shell = name, =told));
            match session {
                Some(attachedTo) -> send(attachedTo, Session.Written(self()))
              | None -> Unit
            };
            writingShell(test, name, session)
        }
      | Session.Unavailable as told ->
            send(test, Heard(shell = name, =told))
      | Session.Ended(_) as told ->
            send(test, Heard(shell = name, =told))
      | told -> {
            send(test, Heard(shell = name, =told));
            writingShell(test, name, session)
        }
    }

// The shell of the name attached with the cookie from the remote address,
// and what it is told first, within 5000 milliseconds.
fn attach(sessions : Sessions,
          name : String,
          cookie : String,
          remote : String) : String receiving Seen = {
    send(sessions.address,
         Attach(=cookie,
                =remote,
                size = Terminal.Size(rows = 24, columns = 80),
                shell = shell(name)));
    next(name)
}

fn next(name : String) : String receiving Seen =
    receive {
        Heard(shell = from, =told) when from == name -> shown(told)
      | after 5000 -> "nothing"
    }

fn shown(told : Session.Told) : String =
    match told {
        Session.Attached(attachment = Session.New) ->
            "Attached(New)"
      | Session.Attached(attachment = Session.Joined) ->
            "Attached(Joined)"
      | Session.Unavailable ->
            "Unavailable"
      | Session.Output(bytes) ->
            "Output(" <> Optional.withDefault(String.fromUtf8(bytes), "?") <> ")"
      | Session.Resized ->
            "Resized"
      | Session.Warning(seconds) ->
            "Warning(" <> Int.toString(seconds) <> ")"
      | Session.Ended(code) ->
            "Ended(" <> Int.toString(code) <> ")"
    }

// The sessions stopped: whether the stop was answered within 5000
// milliseconds.
fn stop(sessions : Sessions) : Bool =
    Address.call(sessions.address, Stop, 5000) == Some(Unit)

// design §12: an attach whose cookie names a live session is passed to
// it, which takes it over; another cookie starts a session while fewer
// than `most-at-once` live, and past them the shell is told Unavailable,
// until a session that ends frees its place.
let startsWithinTheCap = Test.Case(name = "starts a session within the cap", run = fn() = {
    let sessions = started(2, 2, 10, 60000);
    let first = attach(sessions, "first", "a", "192.0.2.1");
    let againShell = shell("again");
    send(sessions.address,
         Attach(cookie = "a",
                remote = "192.0.2.1",
                size = Terminal.Size(rows = 24, columns = 80),
                shell = againShell));
    let again = receive {
        Heard(shell = "again", told = Session.Attached(=session)) -> Some(session)
      | after 5000 -> None
    };
    let takenOver = next("first");
    let second = attach(sessions, "second", "b", "192.0.2.1");
    let third = attach(sessions, "third", "c", "192.0.2.2");
    let freed = match again {
        Some(session) -> {
            send(session, Session.Stop(againShell));
            let stopped = next("again");
            let later = Test.until(fn() = match attach(sessions, "later", "c", "192.0.2.2") {
                                       "Attached(New)" -> Test.Passed
                                     | told -> Test.Failed(told)
                                   },
                                   5000);
            #(stopped, later)
        }
      | None ->
            #("not attached again", Test.Failed("no session"))
    };
    let stopped = stop(sessions);
    Test.equal(#(first, takenOver, second, third, freed, stopped),
               #("Attached(New)",
                 "Ended(4002)",
                 "Attached(New)",
                 "Unavailable",
                 #("Ended(4004)", Test.Passed),
                 true))
})

// design §12: a remote address makes `starts.count` starts within
// `starts.within` milliseconds, and its next attach is told Unavailable
// until the window has passed the first, while another remote address
// starts its own.
let capsStarts = Test.Case(name = "caps a remote address's starts within the window", run = fn() = {
    let sessions = started(10, 10, 2, 400);
    let begun = Clock.monotonic();
    let one = attach(sessions, "one", "a", "192.0.2.1");
    let two = attach(sessions, "two", "b", "192.0.2.1");
    let refused = attach(sessions, "three", "c", "192.0.2.1");
    let other = attach(sessions, "other", "d", "192.0.2.2");
    let later = Test.until(fn() = match attach(sessions, "later", "c", "192.0.2.1") {
                               "Attached(New)" -> Test.Passed
                             | told -> Test.Failed(told)
                           },
                           5000);
    let waited = Clock.monotonic() - begun;
    let stopped = stop(sessions);
    Test.equal(#(one, two, refused, other, later, waited >= 400, stopped),
               #("Attached(New)",
                 "Attached(New)",
                 "Unavailable",
                 "Attached(New)",
                 Test.Passed,
                 true,
                 true))
})

// design §12: with `per-address` 2, a counted address that started two
// sessions is told Unavailable at a third start, while another address
// starts its own, and two IPv6 addresses of one /64 share their count; a
// session that ends frees its address's place. The starts and
// `most-at-once` are set past the test's, so that only the cap by address
// refuses.
let capsAnAddress = Test.Case(name = "caps the sessions an address started", run = fn() = {
    let sessions = started(10, 2, 10, 60000);
    let oneShell = shell("one");
    let one = attachedTo(sessions, oneShell, "one", "a", "192.0.2.1");
    let two = attach(sessions, "two", "b", "192.0.2.1");
    let refused = attach(sessions, "three", "c", "192.0.2.1");
    let other = attach(sessions, "other", "d", "192.0.2.2");
    let first = attach(sessions, "first", "e", "2001:db8:0:1::1");
    let second = attach(sessions, "second", "f", "2001:DB8:0:1:FFFF::2");
    let third = attach(sessions, "third", "g", "2001:db8:0:1:0:0:0:3");
    let freed = match one {
        Some(session) -> {
            send(session, Session.Stop(oneShell));
            let stopped = next("one");
            let later = Test.until(fn() = match attach(sessions, "later", "c", "192.0.2.1") {
                                       "Attached(New)" -> Test.Passed
                                     | told -> Test.Failed(told)
                                   },
                                   5000);
            #(stopped, later)
        }
      | None ->
            #("not attached", Test.Failed("no session"))
    };
    Test.equal(#(Optional.isSome(one),
                 two,
                 refused,
                 other,
                 first,
                 second,
                 third,
                 freed,
                 stop(sessions)),
               #(true,
                 "Attached(New)",
                 "Unavailable",
                 "Attached(New)",
                 "Attached(New)",
                 "Attached(New)",
                 "Unavailable",
                 #("Ended(4004)", Test.Passed),
                 true))
})

// design §12: the starts are counted by the counted address, so that two
// IPv6 addresses of one /64 share `starts.count`, while an address of
// another /64 starts its own.
let capsStartsByThe64 = Test.Case(name = "counts the starts of one /64 together", run = fn() = {
    let sessions = started(10, 10, 2, 60000);
    let one = attach(sessions, "one", "a", "2001:db8::1");
    let two = attach(sessions, "two", "b", "2001:db8::2");
    let refused = attach(sessions, "three", "c", "2001:db8:0:0:ffff::3");
    let other = attach(sessions, "other", "d", "2001:db8:0:1::1");
    Test.equal(#(one, two, refused, other, stop(sessions)),
               #("Attached(New)", "Attached(New)", "Unavailable", "Attached(New)", true))
})

// design §12: the stop tells every live session End with 1001, which each
// tells its shell, and answers once each has ended; after it an attach is
// told Unavailable and a second stop is answered.
let stopsEverySession = Test.Case(name = "ends every session at the stop", run = fn() = {
    let sessions = started(4, 4, 10, 60000);
    let one = attach(sessions, "one", "a", "192.0.2.1");
    let two = attach(sessions, "two", "b", "192.0.2.2");
    let stopped = stop(sessions);
    let ends = #(next("one"), next("two"));
    let afterStop = attach(sessions, "after", "c", "192.0.2.3");
    Test.equal(#(one, two, stopped, ends, afterStop, stop(sessions)),
               #("Attached(New)",
                 "Attached(New)",
                 true,
                 #("Ended(1001)", "Ended(1001)"),
                 "Unavailable",
                 true))
})

// A program that says its process number and outlives the hangup of its
// terminal, ending at the termination the test sends it.
let outlivesItsHangup : List(String) = ["sh", "-c", "trap '' HUP; echo $$; exec sleep 30"]

// The program of the process number ended by the termination, through a
// shell's `kill`: whether the kill ran.
fn terminated(pid : String) : Bool =
    Either.isRight(Os.run(Os.command("sh", ["-c", "kill \"$1\"", "sh", pid]), 5000))

// The count of the sessions' processes that live, those the sessions
// spawned for a cookie.
fn sessionsLive() : Int =
    List.size(List.filter(Process.live(), fn(process) = match Process.status(process) {
        Some(status) -> String.startsWith(status.site, "Sessions.admitted:")
      | None -> false
    }))

// Whether the sessions have taken what came: waiting with nothing in their
// mailbox.
fn taken(sessions : Sessions) : Test.Result =
    match Process.status(Process.fromAddress(sessions.address)) {
        Some(Process.Status(queued = 0, activity = Process.Receiving)) -> Test.Passed
      | _ -> Test.Failed("the sessions have not taken what came")
    }

// What the named shell is told first, within 5000 milliseconds, and for an
// Attached whether the process had ended by then.
fn attachedOnceEnded(name : String, process : Process) : String receiving Seen =
    receive {
        Heard(shell = from, told = Session.Attached(attachment = Session.New)) when from == name ->
            if Process.status(process) == None then
                "Attached(New), the old session ended"
            else
                "Attached(New), the old session alive"
      | Heard(shell = from, =told) when from == name ->
            shown(told)
      | after 5000 ->
            "nothing"
    }

// design §12: a restart waits: under `most-at-once` 1, a session stopped,
// its program outliving the hangup of its terminal, counts among the live
// until it ends, an attach under its cookie waiting meanwhile, no session
// started for it, and another cookie told Unavailable; once the test ends
// the program, and with it the session, the attach that waits is told
// Attached(New), the old session's process having ended by then, and the
// new session counts in its place, another cookie told Unavailable after it
// too. The other cookie's attach, which the sessions take after the one
// that waits, shows they have taken that one before the count of sessions
// is read.
let startsAnew =
    Test.Case(name = "starts anew under a cookie once its session has ended", run = fn() = {
        let sessions = startedWith(outlivesItsHangup, 30000, 1, 1, 10, 60000);
        let oldShell = shell("old");
        let result = match attachedTo(sessions, oldShell, "old", "a", "192.0.2.1") {
            Some(old) -> {
                let oldPid = String.trim(heard("old", "\r\n", ""));
                send(old, Session.Stop(oldShell));
                let stoppedOld = next("old");
                send(sessions.address,
                     Attach(cookie = "a",
                            remote = "192.0.2.1",
                            size = Terminal.Size(rows = 24, columns = 80),
                            shell = shell("new")));
                let capped = attach(sessions, "other", "c", "192.0.2.3");
                let running = sessionsLive();
                let endedOld = terminated(oldPid);
                let renewed = attachedOnceEnded("new", Process.fromAddress(old));
                let cappedAfter = attach(sessions, "after", "d", "192.0.2.4");
                let newPid = String.trim(heard("new", "\r\n", ""));
                let endedNew = terminated(newPid);
                Right(#(stoppedOld,
                        capped,
                        running,
                        endedOld,
                        renewed,
                        cappedAfter,
                        endedNew,
                        next("new")))
            }
          | None ->
                Left("not attached")
        };
        Test.equal(#(result, stop(sessions)),
                   #(Right(#("Ended(4004)",
                             "Unavailable",
                             1,
                             true,
                             "Attached(New), the old session ended",
                             "Unavailable",
                             true,
                             "Ended(4004)")),
                     true))
    })

// design §12: the stop tells each attach waiting Unavailable: an attach
// under the cookie of a session stopped, whose program outlives the hangup
// of its terminal, waits, and a stop tells it Unavailable at once, while
// the stop waits for the session's end, which comes once the test ends the
// program; the stop is then answered.
let stopsAWaitingAttach =
    Test.Case(name = "tells an attach that waits Unavailable at the stop", run = fn() = {
        let sessions = startedWith(outlivesItsHangup, 30000, 1, 1, 10, 60000);
        let oneShell = shell("one");
        let result = match attachedTo(sessions, oneShell, "one", "a", "192.0.2.1") {
            Some(session) -> {
                let pid = String.trim(heard("one", "\r\n", ""));
                send(session, Session.Stop(oneShell));
                let stoppedOne = next("one");
                send(sessions.address,
                     Attach(cookie = "a",
                            remote = "192.0.2.1",
                            size = Terminal.Size(rows = 24, columns = 80),
                            shell = shell("waiting")));
                let held = Test.until(fn() = taken(sessions), 5000);
                let me = self();
                let _ = spawn(fn() = send(me, Stopped(stop(sessions))));
                let told = next("waiting");
                let ended = terminated(pid);
                let answered = receive {
                    Stopped(answered) -> answered
                  | after 5000 -> false
                };
                Right(#(stoppedOne, held, told, ended, answered))
            }
          | None ->
                Left("not attached")
        };
        Test.equal(result, Right(#("Ended(4004)", Test.Passed, "Unavailable", true, true)))
    })
