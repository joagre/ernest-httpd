/// The static site: a request for a file under the root answered with the
/// file, its content type and its modification time, or with an error
/// (design §5).
///
/// A connection makes the site once, with `site`, from the configuration's
/// root and content types, and answers each request with `serve`, whatever
/// its method and target; it adds `Date` and the configuration's headers to
/// the response before it writes it. `error` is the response of a status
/// the connection answers itself, `methodNotAllowed` the one of a method it
/// does not serve, and `withoutBody` makes either a `HEAD`'s.
/// `pathAndQuery` reads a target as `serve` reads it, for what a
/// request's host decides before the site serves it (design §9).
///
/// `serve` reads the file system for each request, each read bounded by the
/// milliseconds given, and keeps nothing between requests: a file changed
/// under the root is served as it is when the request comes.
///
/// ## Examples
///
/// A method other than `GET` and `HEAD` is answered 405, its body plain text:
///
/// ```ernest
/// let request = Http.Request(method = "POST", target = "/", version = Http.http11, headers = []);
/// let #(response, body) =
///     ErnestHttpd.Static.serve(ErnestHttpd.Static.site(Path("site"), Map.empty), request, 1000);
/// #(response.status, response.headers, String.fromUtf8(body))
/// // => #(405, [Http.Header(name = "Allow", value = "GET, HEAD"), Http.Header(name = "Content-Type", value = "text/plain; charset=utf-8")], Some("405 Method Not Allowed\n"))
/// ```

//
// Types
//

/// The site a request for a file is served from: the root its files stand
/// under, and the table of content types by extension, each with its dot.
export type Site = Site(root : Path, contentTypes : Map(String, String))

//
// The site
//

/// The built-in table of content types, by extension with its dot.
///
/// ### Examples
///
/// ```ernest
/// Map.get(ErnestHttpd.Static.contentTypes, ".html")
/// // => Some("text/html; charset=utf-8")
/// ```
export let contentTypes : Map(String, String) =
    Map.fromList([#(".html", "text/html; charset=utf-8"),
                  #(".css", "text/css; charset=utf-8"),
                  #(".js", "text/javascript; charset=utf-8"),
                  #(".json", "application/json"),
                  #(".svg", "image/svg+xml"),
                  #(".png", "image/png"),
                  #(".ico", "image/x-icon"),
                  #(".woff2", "font/woff2"),
                  #(".txt", "text/plain; charset=utf-8"),
                  #(".xml", "application/xml"),
                  #(".wasm", "application/wasm")])

/// The site of the root, its table the built-in one extended by
/// `contentTypes`, whose type wins for an extension both have.
///
/// ### Examples
///
/// ```ernest
/// let site = ErnestHttpd.Static.site(Path("site"), Map.fromList([#(".txt", "text/plain")]));
/// #(Map.get(site.contentTypes, ".txt"), Map.get(site.contentTypes, ".css"))
/// // => #(Some("text/plain"), Some("text/css; charset=utf-8"))
/// ```
export fn site(root : Path, contentTypes : Map(String, String)) : Site =
    Site(=root, contentTypes = Map.merge(Static.contentTypes, contentTypes))

//
// Serving
//

/// The response to the request and its body: the file the target names
/// under the root, a redirect to a directory's path, or an error, each
/// read of the file system bounded by `ms` milliseconds.
///
/// `GET` and `HEAD` are served, and a `HEAD` answers the `GET`'s response
/// with no body and, but for a 304, its body's size as `Content-Length`;
/// any other method answers 405. A file the file system refuses to describe
/// or to read answers 500, and the path and the error are written on
/// standard error.
///
/// ### Examples
///
/// A target of no form a server reads is answered 400:
///
/// ```ernest
/// let request = Http.Request(method = "GET", target = "*", version = Http.http11, headers = []);
/// let #(response, _) =
///     ErnestHttpd.Static.serve(ErnestHttpd.Static.site(Path("site"), Map.empty), request, 1000);
/// response.status
/// // => 400
/// ```
export fn serve(site : Site, request : Http.Request, ms : Int) : #(Http.Response, Bytes) =
    match request.method {
        "GET" -> get(site, request, ms)
      | "HEAD" -> withoutBody(get(site, request, ms))
      | _ -> methodNotAllowed
    }

/// The response to a method other than `GET` and `HEAD`: 405 with
/// `Allow: GET, HEAD`, its body the error's plain text, as `serve` answers
/// any target and the client's path answers it too (design §14).
///
/// ### Examples
///
/// ```ernest
/// let #(response, _) = ErnestHttpd.Static.methodNotAllowed;
/// #(response.status, Http.header(response.headers, "Allow"))
/// // => #(405, Some("GET, HEAD"))
/// ```
export let methodNotAllowed : #(Http.Response, Bytes) = {
    let #(response, body) = plain(405);
    #(Http.Response(..response, headers = header("Allow", "GET, HEAD") :: response.headers), body)
}

/// A `HEAD`'s response of a `GET`'s: its body dropped and, but for a 304,
/// the body's size as its `Content-Length`. The connection drops so the
/// body of a `HEAD` it refuses itself.
///
/// ### Examples
///
/// ```ernest
/// let ok = Http.Response(version = Http.http11, status = 200, headers = []);
/// ErnestHttpd.Static.withoutBody(#(ok, <<104, 105>>))
/// // => #(Http.Response(version = Http.Version(major = 1, minor = 1), status = 200, headers = [Http.Header(name = "Content-Length", value = "2")]), <<>>)
/// ```
export fn withoutBody(#(response, body) : #(Http.Response, Bytes)) : #(Http.Response, Bytes) =
    if response.status == 304 then
        #(response, <<>>)
    else {
        let size = header("Content-Length", Int.toString(Bytes.size(body)));
        #(Http.Response(..response, headers = response.headers <> [size]), <<>>)
    }

fn get(site : Site, request : Http.Request, ms : Int) : #(Http.Response, Bytes) =
    match asked(site, request) {
        Left(status) ->
            error(site, status, ms)
      | Right(Asked(=written, =query, =path, =asksDirectory)) ->
            match Fs.stat(path, ms) {
                Right(Fs.Entry(kind = Fs.Directory)) ->
                    if asksDirectory then
                        index(site, request, path <> Path("index.html"), ms)
                    else
                        #(response(301, [header("Location", location(written, query))]), <<>>)
              | Right(Fs.Entry(kind = Fs.File) as entry) when !asksDirectory ->
                    file(site, request, entry, ms)
              | Right(_) or Left(Io.NotFound) or Left(Io.Invalid) ->
                    error(site, 404, ms)
              | Left(cause) ->
                    refused(path, cause)
            }
    }

// The path of a directory asked for without its `/`: the path as
// Http.target writes it with `/` appended, its leading `/`s made one, since
// two would begin a host's name, then `?` and the query where the target
// has one.
fn location(written : String, query : Optional(String)) : String = {
    let #(_, rest) = List.splitWhile(String.toList(written), fn(char) = char == '/');
    "/" <> String.fromList(rest) <> "/" <> queried(query)
}

// `?` and the query, where there is one.
fn queried(query : Optional(String)) : String =
    Optional.withDefault(Optional.map(query, fn(query) = "?" <> query), "")

// A directory's index file, which is served where it is a regular file.
fn index(site : Site, request : Http.Request, path : Path, ms : Int) : #(Http.Response, Bytes) =
    match Fs.stat(path, ms) {
        Right(Fs.Entry(kind = Fs.File) as entry) -> file(site, request, entry, ms)
      | Right(_) or Left(Io.NotFound) or Left(Io.Invalid) -> error(site, 404, ms)
      | Left(cause) -> refused(path, cause)
    }

// A regular file, answered 304 where the request's If-Modified-Since is at
// or after its modification time, and otherwise read and served.
fn file(site : Site, request : Http.Request, entry : Fs.Entry, ms : Int) : #(Http.Response, Bytes) =
    if isUnmodified(request, entry) then
        #(response(304, []), <<>>)
    else match Fs.read(entry.path, ms) {
        Right(bytes) ->
            #(response(200,
                       [header("Content-Type", contentType(site, entry.path)),
                        header("Last-Modified", Http.date(entry.modified))]),
              bytes)
      | Left(Io.NotFound) or Left(Io.NotAFile) ->
            error(site, 404, ms)
      | Left(cause) ->
            refused(entry.path, cause)
    }

fn isUnmodified(request : Http.Request, entry : Fs.Entry) : Bool =
    match Optional.andThen(Http.header(request.headers, "If-Modified-Since"), Http.parseDate) {
        Some(time) -> entry.modified <= time
      | None -> false
    }

// The file's content type, by its extension with its dot, and
// application/octet-stream where the table has none.
fn contentType(site : Site, path : Path) : String =
    Optional.andThen(Path.extension(path),
                     fn(extension) = Map.get(site.contentTypes, "." <> extension))
        |> Optional.withDefault("application/octet-stream")

// A file the file system refused to describe or to read, or did not answer
// in time: said on standard error, the path's characters that would break
// or turn the line written as their bytes, and answered 500.
fn refused(path : Path, cause : Io.Error) : #(Http.Response, Bytes) = {
    Io.printlnError(escaped(Path.toString(path)) <> ": " <> Io.show(cause));
    plain(500)
}

// The text with each control character, U+0000 to U+001F and U+007F to
// U+009F, and each character that turns or breaks a line written as its
// bytes in UTF-8, `\xHH`, as ern writes a path in a refusal.
fn escaped(text : String) : String =
    String.join(List.map(String.toList(text), escapedChar), "")

fn escapedChar(char : Char) : String =
    if isBreaking(Char.toCodePoint(char)) then
        String.join(List.map(Bytes.toList(String.toUtf8(Char.toString(char))),
                             fn(byte) = "\\x" <> String.toAsciiUpper(Bytes.toHex(<<byte>>))),
                    "")
    else
        Char.toString(char)

// Whether the code point is a control character, or one that turns or
// breaks a line: the marks and the embeddings, overrides and isolates of
// the bidirectional text, and the line and paragraph separators.
fn isBreaking(codePoint : Int) : Bool =
    codePoint <= 0x1F
        || codePoint >= 0x7F && codePoint <= 0x9F
        || codePoint == 0x200E
        || codePoint == 0x200F
        || codePoint >= 0x2028 && codePoint <= 0x202E
        || codePoint >= 0x2066 && codePoint <= 0x2069

//
// The target
//

// What a target asks for: its path and its query as Http.target writes them,
// the characters G.11 names percent-encoded; the path it names under the
// root; and whether it asks for a directory.
type Asked = Asked(written : String, query : Optional(String), path : Path, asksDirectory : Bool)

// The target read and its path placed under the root by Http.filePath, or
// the status it is refused with: 400, or 404 for a segment it places that
// begins with a dot. The form is read first, since Http.filePath places the
// path of an absolute-form target that names userinfo or has no authority.
// The segments read are those under the root, none where the path is the
// root itself, since the root's own may begin with a dot, as the challenge
// site's does (design §9).
fn asked(site : Site, request : Http.Request) : Either(Int, Asked) = {
    let reference <- Either.fromOptional(form(request), 400);
    let written = reference.path;
    let path <- Either.fromOptional(Http.filePath(request, site.root), 400);
    let segments =
        Path.from(path, site.root) |> Optional.map(Path.split) |> Optional.withDefault([]);
    let _ <- if List.any(segments, holdsControl) then Left(400) else Right(Unit);
    let _ <- if List.any(segments, beginsWithDot) then Left(404) else Right(Unit);
    Right(Asked(=written,
                query = reference.query,
                =path,
                asksDirectory = String.endsWith(written, "/") || List.isEmpty(segments)))
}

// Whether a segment holds a control character, U+0001 to U+001F or U+007F;
// Http.filePath refuses one that holds U+0000.
fn holdsControl(segment : String) : Bool =
    List.any(String.toList(segment), isControl)

fn isControl(char : Char) : Bool = {
    let codePoint = Char.toCodePoint(char);
    codePoint < 32 || codePoint == 127
}

// Whether a segment's first code point is `.`, a combining mark after it
// or not.
fn beginsWithDot(segment : String) : Bool =
    match String.toList(segment) {
        '.' :: _ -> true
      | _ -> false
    }

/// The target's path and, where it has a query, `?` and the query, as
/// `Http.target` reads them, which percent-encodes a character RFC 3986
/// does not write and a `%` that begins no encoding, `/` standing for an
/// absolute-form target's empty path; `None` for a target of another form,
/// which `serve` answers 400.
///
/// The target is read by `Http.target`, in origin form, a path that
/// begins with `/`, or in absolute form, a scheme and an authority that
/// names no userinfo.
///
/// ### Examples
///
/// ```ernest
/// let get =
///     fn(target) = Http.Request(method = "GET", =target, version = Http.http11, headers = []);
/// #(ErnestHttpd.Static.pathAndQuery(get("/docs?page=2")),
///   ErnestHttpd.Static.pathAndQuery(get("/?a[]=1")),
///   ErnestHttpd.Static.pathAndQuery(get("http://ernest-lang.org?q=1")),
///   ErnestHttpd.Static.pathAndQuery(get("*")))
/// // => #(Some("/docs?page=2"), Some("/?a%5B%5D=1"), Some("/?q=1"), None)
/// ```
export fn pathAndQuery(request : Http.Request) : Optional(String) =
    Optional.map(form(request), fn(reference) = reference.path <> queried(reference.query))

// The target read by Http.target in origin form, no scheme and no
// authority before a path that begins with `/`, or in absolute form, a
// scheme and an authority that names no userinfo, its path `/` where it is
// empty; None for a target of another form.
fn form(request : Http.Request) : Optional(Uri.Reference) =
    match Http.target(request) {
        Some(Uri.Reference(scheme = None,
                           authority = None,
                           =path) as reference) when String.startsWith(path, "/") ->
            Some(reference)
      | Some(Uri.Reference(scheme = Some(_),
                           authority = Some(Uri.Authority(userinfo = None)),
                           =path) as reference) ->
            Some(Uri.Reference(..reference, path = if path == "" then "/" else path))
      | _ ->
            None
    }

//
// The errors
//

/// The response of the status and its body, plain text naming the status
/// and its phrase, `404 Not Found` and a line feed, `Http.reason`'s and
/// 431's, `Request Header Fields Too Large`, which it names none.
///
/// A 404 answers the root's `404.html` instead, as HTML, where that is a
/// regular file, and 500 where the file system refuses to read it, the path
/// and the error written on standard error.
///
/// ### Examples
///
/// ```ernest
/// let #(response, body) =
///     ErnestHttpd.Static.error(ErnestHttpd.Static.site(Path("site"), Map.empty), 400, 1000);
/// #(response.status, response.headers, String.fromUtf8(body))
/// // => #(400, [Http.Header(name = "Content-Type", value = "text/plain; charset=utf-8")], Some("400 Bad Request\n"))
/// ```
export fn error(site : Site, status : Int, ms : Int) : #(Http.Response, Bytes) =
    if status == 404 then {
        let path = site.root <> Path("404.html");
        match Fs.read(path, ms) {
            Right(bytes) ->
                #(response(404, [header("Content-Type", "text/html; charset=utf-8")]), bytes)
          | Left(Io.NotFound) or Left(Io.NotAFile) ->
                plain(404)
          | Left(cause) ->
                refused(path, cause)
        }
    } else
        plain(status)

// The status's response with its body plain text.
fn plain(status : Int) : #(Http.Response, Bytes) =
    #(response(status, [header("Content-Type", "text/plain; charset=utf-8")]),
      String.toUtf8(Int.toString(status) <> " " <> phrase(status) <> "\n"))

// The status's phrase in an error's body: Http.reason's, RFC 9110's, and
// 431's, RFC 6585's, which Http.reason names none.
fn phrase(status : Int) : String =
    if status == 431 then "Request Header Fields Too Large" else Http.reason(status)

// A response of HTTP/1.1.
fn response(status : Int, headers : List(Http.Header)) : Http.Response =
    Http.Response(version = Http.http11, =status, =headers)

fn header(name : String, value : String) : Http.Header =
    Http.Header(=name, =value)

//
// Tests
//

// The scratch directory the tests write their sites under: `site` with its
// 404.html, served as `withPage`, `bare` without one, `locked` with one no
// one may read, and `.dotted`, a root whose name begins with a dot; and
// `outside`, which `site` links to.
let scratch : String = "build/scratch/static"

// The modification time of every file written, Sun, 06 Nov 1994 08:49:37 GMT.
let modified : Int = 784111777000

fn written(name : String, text : String) : Either(Io.Error, Unit) = {
    let path = Path(scratch <> "/" <> name);
    let _ <- Fs.write(path, String.toUtf8(text), 5000);
    Fs.setModified(path, modified, 5000)
}

fn prepared() : Either(Io.Error, Unit) = {
    let _ <- Fs.makeDir(Path(scratch <> "/site/docs"), 5000);
    let _ <- Fs.makeDir(Path(scratch <> "/site/empty"), 5000);
    let _ <- Fs.makeDir(Path(scratch <> "/bare/empty"), 5000);
    let _ <- Fs.makeDir(Path(scratch <> "/locked"), 5000);
    let _ <- written("site/index.html", "home");
    let _ <- written("site/a.txt", "alpha");
    let _ <- written("site/a b.txt", "space");
    let _ <- written("site/\u{e9}.txt", "e acute");
    let _ <- written("site/a|b.txt", "bar");
    let _ <- written("site/a[b]", "brackets");
    let _ <- written("site/%zz", "percent zz");
    let _ <- written("site/a.txt%4", "percent 4");
    let _ <- written("site/a.txt%", "percent");
    let _ <- Fs.makeDir(Path(scratch <> "/site/[docs]"), 5000);
    let _ <- written("site/[docs]/index.html", "bracketed docs");
    let _ <- written("site/data.bin", "bin");
    let _ <- written("site/.hidden", "hidden");
    let _ <- written("site/docs/index.html", "docs");
    let _ <- written("site/404.html", "<p>none</p>");
    let _ <- written("bare/a.txt", "alpha");
    let _ <- Fs.makeDir(Path(scratch <> "/.dotted"), 5000);
    let _ <- written(".dotted/a.txt", "alpha");
    let _ <- Fs.makeDir(Path(scratch <> "/outside"), 5000);
    let _ <- written("outside/away.txt", "away");
    let _ <- written("outside/index.html", "outer");
    let _ <- linked("site/away.txt", "../outside/away.txt");
    let _ <- linked("site/out", "../outside");
    linked("bare/loop", "loop")
}

// A symbolic link at the name under the scratch directory to the target as
// written; one made before kept.
fn linked(name : String, target : String) : Either(Io.Error, Unit) =
    match Fs.makeSymlink(Path(scratch <> "/" <> name), Path(target), 5000) {
        Right(Unit) or Left(Io.Exists) -> Right(Unit)
      | Left(error) -> Left(error)
    }

let withPage : Site = site(Path(scratch <> "/site"), Map.empty)

let bare : Site = site(Path(scratch <> "/bare"), Map.empty)

let dotted : Site = site(Path(scratch <> "/.dotted"), Map.empty)

// A request to the site, and the answer expected.
type Check = Check(site : Site, request : Http.Request, expected : Answer)

// A response as a test compares it: its status, its headers, and its body
// as text.
type Answer = Answer(status : Int, headers : List(Http.Header), body : Optional(String))

fn request(method : String, target : String, headers : List(Http.Header)) : Http.Request =
    Http.Request(=method, =target, version = Http.http11, =headers)

// A GET of the target, and the answer expected.
fn getting(site : Site, target : String, expected : Answer) : Check =
    Check(=site, request = request("GET", target, []), =expected)

fn compared(#(response, body) : #(Http.Response, Bytes)) : Answer =
    Answer(status = response.status, headers = response.headers, body = String.fromUtf8(body))

// Each check's request served once the scratch sites are prepared, and the
// answers against those expected.
fn served(checks : List(Check)) : Test.Result =
    match prepared() {
        Right(Unit) ->
            Test.equal(List.map(checks,
                                fn(check) = compared(serve(check.site, check.request, 5000))),
                       List.map(checks, fn(check) = check.expected))
      | Left(error) ->
            Test.Failed("cannot prepare " <> scratch <> ": " <> Io.show(error))
    }

// A file's answer: 200, its content type and its modification time, and
// its text.
fn fileAnswer(contentType : String, body : String) : Answer =
    Answer(status = 200,
           headers = [header("Content-Type", contentType),
                      header("Last-Modified", "Sun, 06 Nov 1994 08:49:37 GMT")],
           body = Some(body))

fn textFile(body : String) : Answer =
    fileAnswer("text/plain; charset=utf-8", body)

fn htmlFile(body : String) : Answer =
    fileAnswer("text/html; charset=utf-8", body)

// An error's answer in plain text, and the root's 404.html's.
fn plainError(status : Int) : Answer =
    Answer(=status,
           headers = [header("Content-Type", "text/plain; charset=utf-8")],
           body = Some(Int.toString(status) <> " " <> Http.reason(status) <> "\n"))

let notFoundPage : Answer =
    Answer(status = 404,
           headers = [header("Content-Type", "text/html; charset=utf-8")],
           body = Some("<p>none</p>"))

fn redirect(location : String) : Answer =
    Answer(status = 301, headers = [header("Location", location)], body = Some(""))

// design §5: a regular file is served with its content type by its
// extension, its modification time as RFC 9110's date, and its bytes.
let servesFiles =
    Test.Case(name = "serves a file",
              run = fn() =
                  served([getting(withPage, "/a.txt", textFile("alpha")),
                          getting(withPage, "/index.html", htmlFile("home"))]))

// design §5: a directory asked for is served as its index.html, one asked
// for without its `/` is redirected to it, its leading `/`s made one, and
// its query kept after `?`, as Http.target writes it, an empty one among
// them; one without an index.html is not found; a file asked for as a
// directory is not found either.
let servesDirectories =
    Test.Case(name = "serves a directory",
              run = fn() =
                  served([getting(withPage, "/", htmlFile("home")),
                          getting(withPage, "/docs/", htmlFile("docs")),
                          getting(withPage, "/docs", redirect("/docs/")),
                          getting(withPage, "/docs?page=2", redirect("/docs/?page=2")),
                          getting(withPage, "/docs?", redirect("/docs/?")),
                          getting(withPage, "//docs?x=/y", redirect("/docs/?x=/y")),
                          getting(withPage, "/[docs]?a[]=1", redirect("/%5Bdocs%5D/?a%5B%5D=1")),
                          getting(withPage,
                                  "http://ernest-lang.org/docs?page=2",
                                  redirect("/docs/?page=2")),
                          getting(withPage, "//docs", redirect("/docs/")),
                          getting(bare, "/empty/", plainError(404)),
                          getting(withPage, "/a.txt/", notFoundPage)]))

// design §5: a path that leads nowhere is answered with the root's
// 404.html where there is one, and plain text where there is none: a name
// that is not there, a path through a regular file, a loop of links, and a
// name longer than the host holds; and a segment that is a combining mark,
// written `%CC%81`, is a name under the root.
let answersNotFound =
    Test.Case(name = "answers a path that leads nowhere",
              run = fn() =
                  served([getting(withPage, "/missing.txt", notFoundPage),
                          getting(bare, "/missing.txt", plainError(404)),
                          getting(withPage, "/empty/", notFoundPage),
                          getting(withPage, "/index.html/x", notFoundPage),
                          getting(bare, "/a.txt/b/c.txt", plainError(404)),
                          getting(bare, "/loop", plainError(404)),
                          getting(bare, "/loop/a.txt", plainError(404)),
                          getting(bare, "/" <> String.repeat("a", 300), plainError(404)),
                          getting(bare, "/%CC%81/a.txt", plainError(404))]))

// design §5: links are followed out of the root: a link under the root to
// a file outside it is served, 200 with the file's bytes, and a link to a
// directory outside it serves the directory, its index.html and a file in
// it. A regression test, written after the code: it does not cover a link
// out of the root that leads nowhere, nor one whose target is absolute.
let followsLinksOutOfTheRoot =
    Test.Case(name = "follows a link out of the root",
              run = fn() =
                  served([getting(withPage, "/away.txt", textFile("away")),
                          getting(withPage, "/out/", htmlFile("outer")),
                          getting(withPage, "/out/away.txt", textFile("away"))]))

// design §5: a method other than GET and HEAD answers 405 with Allow,
// methodNotAllowed.
let refusesMethods = Test.Case(name = "refuses a method other than GET and HEAD", run = fn() = {
    let refused =
        Answer(..plainError(405),
               headers = header("Allow", "GET, HEAD") :: plainError(405).headers);
    match served([Check(site = withPage,
                        request = request("POST", "/a.txt", []),
                        expected = refused),
                  Check(site = withPage,
                        request = request("get", "/a.txt", []),
                        expected = refused)]) {
        Test.Passed -> Test.equal(compared(methodNotAllowed), refused)
      | failed -> failed
    }
})

// design §5: a HEAD is answered as the GET with no body and its body's size
// as Content-Length, but for a 304, which has none.
let answersHead = Test.Case(name = "answers a HEAD", run = fn() = {
    fn head(site : Site, target : String, headers : List(Http.Header), expected : Answer) : Check =
        Check(=site, request = request("HEAD", target, headers), =expected);
    fn sized(expected : Answer, size : String) : Answer =
        Answer(..expected,
               headers = expected.headers <> [header("Content-Length", size)],
               body = Some(""));
    served([head(withPage, "/a.txt", [], sized(textFile("alpha"), "5")),
            head(withPage, "/docs", [], sized(redirect("/docs/"), "0")),
            head(bare, "/missing.txt", [], sized(plainError(404), "14")),
            head(withPage,
                 "/a.txt",
                 [header("If-Modified-Since", Http.date(modified))],
                 Answer(status = 304, headers = [], body = Some("")))])
})

// design §5: withoutBody drops a response's body and gives its size as
// Content-Length, but for a 304's, which has none.
let dropsBodies =
    Test.Case(name = "drops a body for a HEAD",
              run = fn() =
                  Test.equal([compared(withoutBody(plain(404))),
                              compared(withoutBody(#(response(304, []), <<>>)))],
                             [Answer(..plainError(404),
                                     headers = plainError(404).headers
                                         <> [header("Content-Length", "14")],
                                     body = Some("")),
                              Answer(status = 304, headers = [], body = Some(""))]))

// design §5: If-Modified-Since at or after the modification time answers
// 304 with no body and no header; one before it, or one Http.parseDate
// cannot read, serves the file.
let answersUnmodified = Test.Case(name = "answers a file not modified since", run = fn() = {
    let unmodified = Answer(status = 304, headers = [], body = Some(""));
    fn since(value : String, expected : Answer) : Check =
        Check(site = withPage,
              request = request("GET", "/a.txt", [header("If-Modified-Since", value)]),
              =expected);
    served([since(Http.date(modified), unmodified),
            since(Http.date(modified + 86400000), unmodified),
            since("Sunday, 06-Nov-94 08:49:37 GMT", unmodified),
            since(Http.date(modified - 1000), textFile("alpha")),
            since("yesterday", textFile("alpha"))])
})

// design §5: the path's rules that answer 400: a target Http.target reads
// as none, one holding a character outside the visible ASCII among them; a
// reference of another form, absolute form without an authority or naming
// userinfo among them; a segment Http.filePath refuses, an encoded `/` in
// either case, U+0000, bytes that are not UTF-8, and `.` and `..`, written
// or encoded in either case; and a segment it places that holds a control
// character. The cases of a character outside the visible ASCII, of
// userinfo, of a scheme without an authority and of a fragment are a
// regression test's, written after the code: they do not cover every
// character Uri.parse refuses, which G.12 owns.
let refusesPaths =
    Test.Case(name = "refuses a bad path with 400",
              run = fn() =
                  served(List.map(["*",
                                   "ernest-lang.org:443",
                                   "a.txt",
                                   "1http://ernest-lang.org/a.txt",
                                   "://ernest-lang.org/a.txt",
                                   "http:/ernest-lang.org/a.txt",
                                   "http:a.txt",
                                   "http://user@ernest-lang.org/a.txt",
                                   "/\u{301}/a.txt",
                                   "/a.txt#top",
                                   "/docs%2Findex.html",
                                   "/docs%2findex.html",
                                   "/%FF.txt",
                                   "/a%00.txt",
                                   "/./docs/index.html",
                                   "/a.txt/.",
                                   "/./",
                                   "/%2E/a.txt",
                                   "/%2e/a.txt",
                                   "/../site/a.txt",
                                   "/docs/../a.txt",
                                   "/%2E%2E/a.txt",
                                   "/a%7F.txt",
                                   "/a%09.txt"],
                                  fn(target) = getting(withPage, target, plainError(400)))))

// design §5: the path and the query are as Http.target reads them, each
// character G.11 names and each `%` not before two hexadecimal digits
// percent-encoded: a segment that holds one is decoded to the name as the
// client wrote it, a query that holds one is ignored, and a directory's 301
// has the path so encoded as its Location, which names the directory.
let readsEncodedTargets =
    Test.Case(name = "reads a target with characters Http.target encodes", run = fn() = {
        let untyped = fn(body) = fileAnswer("application/octet-stream", body);
        served([getting(withPage, "/a|b.txt", textFile("bar")),
                getting(withPage, "/a[b]", untyped("brackets")),
                getting(withPage, "/%zz", untyped("percent zz")),
                getting(withPage, "/a.txt%4", untyped("percent 4")),
                getting(withPage, "/a.txt%", untyped("percent")),
                getting(withPage, "/a.txt?a[]=1", textFile("alpha")),
                getting(withPage, "/?a[]=1", htmlFile("home")),
                getting(withPage, "/[docs]", redirect("/%5Bdocs%5D/")),
                getting(withPage, "/%5Bdocs%5D/", htmlFile("bracketed docs"))])
    })

// design §5: a segment that begins with a dot is not found, though the
// file is there, and `..`, `.` and a control character in another segment
// are answered 400 before it; a root whose name begins with a dot serves
// its files, since only the segments under it are read.
let hidesDotSegments =
    Test.Case(name = "answers a dot segment with 404",
              run = fn() =
                  served([getting(bare, "/.hidden", plainError(404)),
                          getting(bare, "/docs/.git/config", plainError(404)),
                          getting(bare, "/%2Ehidden", plainError(404)),
                          getting(withPage, "/.%CC%81hidden", notFoundPage),
                          getting(bare, "/.hidden/..", plainError(400)),
                          getting(bare, "/.hidden/.", plainError(400)),
                          getting(bare, "/.hidden/a%09.txt", plainError(400)),
                          getting(dotted, "/a.txt", textFile("alpha"))]))

// design §5: empty segments are dropped, the query is ignored, and the path
// is percent-decoded into UTF-8, a `.` written `%2E` within a segment among
// it.
let normalizesPaths =
    Test.Case(name = "reads the path",
              run = fn() =
                  served([getting(withPage, "/docs//index.html", htmlFile("docs")),
                          getting(withPage, "//a.txt", textFile("alpha")),
                          getting(withPage, "/a.txt?x=1&y=/../", textFile("alpha")),
                          getting(withPage, "/a%2Etxt", textFile("alpha")),
                          getting(withPage, "/a%20b.txt", textFile("space")),
                          getting(withPage, "/%C3%A9.txt", textFile("e acute")),
                          getting(withPage, "/%c3%a9.txt", textFile("e acute"))]))

// design §5: a target in absolute form is read after its scheme and its
// authority, `/` where its path is empty.
let readsAbsoluteForm =
    Test.Case(name = "reads a target in absolute form",
              run = fn() =
                  served([getting(withPage, "http://ernest-lang.org/a.txt?q=1", textFile("alpha")),
                          getting(withPage, "http://ernest-lang.org", htmlFile("home")),
                          getting(withPage, "http://ernest-lang.org?q=/a.txt", htmlFile("home")),
                          getting(withPage, "HTTPS://ernest-lang.org:443/docs/", htmlFile("docs")),
                          getting(withPage, "web+x.1-2://ernest-lang.org/a.txt", textFile("alpha")),
                          getting(withPage, "http://ernest-lang.org/docs", redirect("/docs/"))]))

// design §5: pathAndQuery answers the target's path and query as
// Http.target reads them, each character G.11 names and each `%` not before
// two hexadecimal digits percent-encoded: an origin-form target whole, an
// absolute-form one after its scheme and its authority, `/` for its empty
// path, before a query or not; and None for a target of another form, an
// OPTIONS's `*` and an authority that names userinfo among them. Those two
// are a regression test's cases, written after the code.
let readsPathAndQuery =
    Test.Case(name = "reads a target's path and query",
              run = fn() =
                  Test.equal(List.map(["/",
                                       "/docs?page=2",
                                       "//docs/../a.txt?x=/y",
                                       "/a[b]%zz?q={1}|%25",
                                       "http://ernest-lang.org/docs?page=2",
                                       "http://ernest-lang.org",
                                       "http://ernest-lang.org?q=/a.txt",
                                       "HTTPS://ernest-lang.org:443/",
                                       "HTTPS://user@ernest-lang.org:443/",
                                       "*",
                                       "ernest-lang.org:443",
                                       "a.txt",
                                       "1http://ernest-lang.org/a.txt",
                                       "http:/ernest-lang.org/a.txt"],
                                      fn(target) = pathAndQuery(request("GET", target, [])))
                                 <> [pathAndQuery(request("OPTIONS", "*", []))],
                             [Some("/"),
                              Some("/docs?page=2"),
                              Some("//docs/../a.txt?x=/y"),
                              Some("/a%5Bb%5D%25zz?q=%7B1%7D%7C%25"),
                              Some("/docs?page=2"),
                              Some("/"),
                              Some("/?q=/a.txt"),
                              Some("/"),
                              None,
                              None,
                              None,
                              None,
                              None,
                              None,
                              None]))

// design §5: an extension the table lacks is application/octet-stream, and
// the site's own table wins over the built-in one.
let typesFiles = Test.Case(name = "types a file by its extension", run = fn() = {
    let configured =
        site(withPage.root, Map.fromList([#(".txt", "text/x-test"), #(".bin", "font/x-test")]));
    served([getting(withPage, "/data.bin", fileAnswer("application/octet-stream", "bin")),
            getting(configured, "/a.txt", fileAnswer("text/x-test", "alpha")),
            getting(configured, "/data.bin", fileAnswer("font/x-test", "bin")),
            getting(configured, "/index.html", htmlFile("home"))])
})

// design §5: the built-in table.
let holdsTheTable =
    Test.Case(name = "holds the built-in table",
              run = fn() =
                  Test.equal(List.sortBy(Map.toList(contentTypes), fn(#(extension, _)) = extension),
                             [#(".css", "text/css; charset=utf-8"),
                              #(".html", "text/html; charset=utf-8"),
                              #(".ico", "image/x-icon"),
                              #(".js", "text/javascript; charset=utf-8"),
                              #(".json", "application/json"),
                              #(".png", "image/png"),
                              #(".svg", "image/svg+xml"),
                              #(".txt", "text/plain; charset=utf-8"),
                              #(".wasm", "application/wasm"),
                              #(".woff2", "font/woff2"),
                              #(".xml", "application/xml")]))

// design §5: a file the file system refuses to read answers 500, the
// root's 404.html among them, each said on standard error with its path
// and the error. The lines' check is a regression test's, written after
// the code: it holds a read refused, not a description refused or one
// that does not answer in time.
let answersRefused = Test.Case(name = "answers a file it cannot read with 500", run = fn() = {
    let secret = Path(scratch <> "/site/secret.txt");
    let locked = Path(scratch <> "/locked/404.html");
    let _ = Fs.setMode(secret, 0o600, 5000);
    let _ = Fs.setMode(locked, 0o600, 5000);
    let _ = Fs.write(secret, String.toUtf8("secret"), 5000);
    let _ = Fs.write(locked, String.toUtf8("<p>locked</p>"), 5000);
    let _ = Fs.setMode(secret, 0, 5000);
    let _ = Fs.setMode(locked, 0, 5000);
    let #(result, captured) =
        Test.capture(fn() =
                         served([getting(withPage, "/secret.txt", plainError(500)),
                                 getting(site(Path(scratch <> "/locked"), Map.empty),
                                         "/missing.txt",
                                         plainError(500))]));
    let _ = Fs.setMode(secret, 0o600, 5000);
    let _ = Fs.setMode(locked, 0o600, 5000);
    Test.equal(#(result, String.fromUtf8(captured.stderr)),
               #(Test.Passed,
                 Some(Path.toString(secret)
                          <> ": Io.Denied\n"
                          <> Path.toString(locked)
                          <> ": Io.Denied\n")))
})

// design §5: error answers a status's plain text, its phrase Http.reason's
// and 431's, which Http.reason names none, and the root's 404.html for a
// 404.
let writesErrors = Test.Case(name = "writes an error's response", run = fn() = match prepared() {
    Right(Unit) ->
        Test.equal([compared(error(bare, 400, 5000)),
                    compared(error(bare, 431, 5000)),
                    compared(error(bare, 404, 5000)),
                    compared(error(withPage, 404, 5000))],
                   [plainError(400),
                    Answer(..plainError(431), body = Some("431 Request Header Fields Too Large\n")),
                    plainError(404),
                    notFoundPage])
  | Left(cause) ->
        Test.Failed("cannot prepare " <> scratch <> ": " <> Io.show(cause))
})

// design §5: the line a refusal writes on standard error has the path's
// control characters, U+001B, U+007F and U+009B among them, and its
// characters that turn or break a line, U+202E, U+2028 and U+2069 among
// them, each as its bytes in UTF-8, `\xHH`; a backslash and any other
// character past ASCII stand as themselves.
let escapesRefusedPaths = Test.Case(name = "escapes the path a refusal writes", run = fn() = {
    let path =
        Path(scratch
                 <> "/\u{9B}31m\u{202E}txt.exe\u{2028}forged: line\u{1B}\u{7F}\\\u{E9}\u{2069}");
    let #(answer, captured) = Test.capture(fn() = compared(refused(path, Io.Denied)));
    Test.equal(#(answer, String.fromUtf8(captured.stderr)),
               #(plainError(500),
                 Some(scratch
                          <> "/\\xC2\\x9B31m\\xE2\\x80\\xAEtxt.exe\\xE2\\x80\\xA8forged: line"
                          <> "\\x1B\\x7F\\\u{E9}\\xE2\\x81\\xA9: Io.Denied\n")))
})
