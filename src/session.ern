/// One session: a visitor's program under a terminal, kept for the
/// visitor's cookie across the shells that attach to it, and ended with a
/// close code (design §12).
///
/// `serve` is the session's whole life, in a process the sessions spawn. It
/// starts the shell's command under a terminal of the page's size, reads
/// the terminal through a reader of its own, which alone calls `Os.read`,
/// and writes the visitor's keys to it through a writer of its own, which
/// alone calls `Os.write`. The reader reads once for each `Read` the
/// session sends: at an attach, and then once the attached shell has
/// written the last piece of output, its `Written`, so that a page that
/// takes its output slowly, or no page, holds the program back as a full
/// terminal does, and the piece a read answered after a detach is held for
/// the next shell. Keys that come while a write is under way are held,
/// joined, up to `message-limit` bytes, and keys that would pass them
/// dropped whole, so that the session never waits on a program that reads
/// nothing; a write past its deadline is waited out before the next, so
/// that the program's input holds one write at most. One shell is attached
/// at a time: an attach takes the session over, and the shell attached
/// before is told `Ended(4002)`. Each shell attached is told so, `New`
/// where it is the first since the session's start and `Joined` after it.
///
/// The session lives `lifetime` milliseconds from its start, its last key or
/// its last `Extend`, kept by one alarm at a time, and the attached shell is
/// told `Warning` `warning` milliseconds before the end. It ends with a
/// close code: 4001 at its deadline, 4004 at its program's exit or the
/// visitor's `Stop`, 4003 where its program cannot start, 1011 where its
/// reader or its writer ends first, and the code an `End` gives. As its end
/// begins it calls the sessions, `Ending`, which answer once its cookie
/// names it no more; then it ends its writer, hangs its terminal up, reads
/// on until its program exits or `hangup` milliseconds pass, kills the
/// program where it has not exited, and tells every shell whose attach has
/// reached it the end's code.

//
// Types
//

/// What a shell is told by a session or by the sessions: it is attached,
/// with the session's address and whether it is the session's first shell;
/// no session is to be had; the program's output; a warning, with the
/// seconds left; and the session's end, with the close code.
export type Told =
    Attached(session : Address(SessionMsg), attachment : Attachment)
  | Unavailable
  | Output(Bytes)
  | Warning(Int)
  | Ended(Int)

/// Whether a shell attached is the first attached to the session since its
/// start, `New`, or one after it, `Joined`.
export type Attachment = New | Joined

/// What a session takes: a shell's attach and its detach, the attached
/// shell's end, the visitor's keys, a shell's word that it has written a
/// piece of output, a resize of the terminal, an extension of the deadline,
/// the visitor's stop and an end with a close code, which the sessions
/// send; what its reader's read answered and the reader's end; its writer's
/// word that a write is done and the writer's end; and the deadline's alarm.
export type SessionMsg =
    Attach(Address(Told))
  | Detach(Address(Told))
  | ShellEnded(Down)
  | Keys(Bytes)
  | Written(Address(Told))
  | Resize(Terminal.Size)
  | Extend
  | Stop
  | End(Int)
  | Answered(Either(Io.Error, Os.Output))
  | ReaderEnded(Down)
  | Wrote
  | WriterEnded(Down)
  | Alarm(Int)

/// What the reader takes: the request to read the terminal once.
export type ReaderMsg = Read

/// What the writer takes: the request to write the keys to the program.
export type WriterMsg = Write(Bytes)

/// The call a session makes of the sessions as its end begins, with its own
/// process, which the sessions answer once its cookie names it no more.
export type Ending = Ending(process : Process, reply : Reply(Unit))

// What a session holds for its life: the shell's configuration, the
// deadlines, the sessions' address its end is told to, its program, its
// reader and its writer.
type Started =
    Started(shell : Config.Shell,
            timeouts : Config.Timeouts,
            sessions : Address(Ending),
            program : Address(Os.ProgramMsg),
            reader : Address(ReaderMsg),
            writer : Address(WriterMsg))

// What a session holds as it serves: the shell attached, what the next
// shell attached is told it is, the piece of output held for it, whether a
// read is under way, the pieces the attached shell has been told and has
// not said it has written, whether a write is under way, the keys held for
// the next write, the time of the last key or Extend, whether the attached
// shell has been warned, and the time the alarm is set for, as
// Clock.monotonic counts.
type Serving =
    Serving(attached : Optional(Address(Told)),
            attachment : Attachment,
            held : Optional(Bytes),
            reading : Bool,
            unwritten : Int,
            writing : Bool,
            keys : Bytes,
            last : Int,
            warned : Bool,
            alarmAt : Int)

//
// Serving
//

/// The session's life: the shell's command started under a terminal of the
/// size, the first word the program and the rest its arguments, served to
/// the shells that attach until its end with a close code, at whose
/// beginning it calls `sessions`; then it returns. A command that cannot
/// start is said on standard error, and the session ends with 4003 at its
/// attach.
export fn serve(shell : Config.Shell,
                timeouts : Config.Timeouts,
                size : Terminal.Size,
                sessions : Address(Ending)) : Unit receiving SessionMsg = {
    // an empty command, which design §4 refuses, is the program "", which
    // the host does not find
    let #(name, arguments) = match shell.command {
        first :: rest -> #(first, rest)
      | [] -> #("", [])
    };
    match Os.startTerminal(Os.command(name, arguments), size) {
        Right(program) -> {
            let me = self();
            let idle = timeouts.idle;
            let write = timeouts.write;
            let reader = spawnMonitored(fn() = reading(program, me, idle), ReaderEnded);
            let writer = spawnMonitored(fn() = writing(program, me, write), WriterEnded);
            let state =
                Serving(attached = None,
                        attachment = New,
                        held = None,
                        reading = false,
                        unwritten = 0,
                        writing = false,
                        keys = <<>>,
                        last = Clock.monotonic(),
                        warned = false,
                        alarmAt = 0);
            serving(Started(=shell, =timeouts, =sessions, =program, =reader, =writer),
                    alarmed(state, shell, false))
        }
      | Left(error) -> {
            Io.printlnError("cannot start " <> name <> ": " <> Io.show(error));
            unstarted(sessions, shell.hangup)
        }
    }
}

// The reader: the terminal read once for each Read, within the idle
// deadline, and what the read answered told to the session.
fn reading(program : Address(Os.ProgramMsg),
           session : Address(SessionMsg),
           idle : Int) : Unit receiving ReaderMsg =
    receive {
        Read -> {
            send(session, Answered(Os.read(program, idle)));
            reading(program, session, idle)
        }
    }

// The writer: the keys of each Write written to the program within the
// write deadline, waited out, and the session told the write is done.
fn writing(program : Address(Os.ProgramMsg),
           session : Address(SessionMsg),
           write : Int) : Unit receiving WriterMsg =
    receive {
        Write(bytes) -> {
            waitedOut(program, Os.write(program, bytes, write), write);
            send(session, Wrote);
            writing(program, session, write)
        }
    }

// A write waited out: one that did not end within the deadline is not
// undone (report Appendix E.23), so an empty write, which waits behind it,
// is made within the deadline again until one answers otherwise, and the
// program's input holds one write at most. A write that fails otherwise is
// dropped: the program has exited, and its Exited is read.
fn waitedOut(program : Address(Os.ProgramMsg),
             outcome : Either(Io.Error, Unit),
             write : Int) : Unit =
    match outcome {
        Left(Io.Timeout) -> waitedOut(program, Os.write(program, <<>>, write), write)
      | _ -> Unit
    }

// A session whose program did not start: at its attach its end begins,
// the sessions called, and the shell is told 4003; then what waits after
// it.
fn unstarted(sessions : Address(Ending), hangup : Int) : Unit receiving SessionMsg =
    receive {
        Attach(shell) -> {
            calledEnding(sessions, hangup);
            send(shell, Ended(4003));
            drained(4003)
        }
    }

// The session waiting on its mailbox: each message taken as it comes,
// until its end.
fn serving(started : Started, state : Serving) : Unit receiving SessionMsg =
    receive {
        Attach(shell) ->
            serving(started, attached(started, state, shell))
      | Detach(shell) ->
            serving(started, detached(state, Process.fromAddress(shell)))
      | ShellEnded(down) ->
            serving(started, detached(state, down.process))
      | Keys(bytes) ->
            serving(started, typed(started, Serving(..state, last = Clock.monotonic()), bytes))
      | Wrote ->
            serving(started, wrote(started, state))
      | Written(shell) ->
            serving(started, writtenBy(started, state, Process.fromAddress(shell)))
      | Resize(size) -> {
            let _ = Os.resize(started.program, size);
            serving(started, state)
        }
      | Extend ->
            serving(started, Serving(..state, last = Clock.monotonic()))
      | Stop ->
            ended(started, state, 4004)
      | End(code) ->
            ended(started, state, code)
      | Answered(Right(Os.Exited(_))) -> {
            begun(started, state, 4004);
            kill(Process.fromAddress(started.writer));
            writerEnded();
            stopped(started, 4004, true)
        }
      | Answered(Right(Os.Stdout(bytes))) or Answered(Right(Os.Stderr(bytes))) ->
            // a terminal merges the two, so its read answers Stdout alone
            // (report Appendix E.23)
            serving(started, output(state, bytes))
      | Answered(Left(_)) ->
            serving(started, readNext(started, Serving(..state, reading = false)))
      | ReaderEnded(_) -> {
            // a read that faulted: the terminal is read no more, and the
            // program is killed at once
            begun(started, state, 1011);
            kill(Process.fromAddress(started.writer));
            writerEnded();
            kill(Process.fromAddress(started.program));
            drained(1011)
        }
      | WriterEnded(_) -> {
            // a write that faulted: the program is killed at once
            begun(started, state, 1011);
            kill(Process.fromAddress(started.reader));
            readerEnded(1011);
            kill(Process.fromAddress(started.program));
            drained(1011)
        }
      | Alarm(_) ->
            rang(started, state)
    }

// A shell attached: the one attached before told it is taken over, the new
// one monitored, told it is attached, `New` where it is the session's first
// and `Joined` after, and written the output held, and a read sent where
// none is under way.
fn attached(started : Started,
            state : Serving,
            shell : Address(Told)) : Serving receiving SessionMsg = {
    match state.attached {
        Some(before) -> {
            send(before, Ended(4002));
            demonitor(Process.fromAddress(before))
        }
      | None ->
            Unit
    };
    monitor(Process.fromAddress(shell), ShellEnded);
    send(shell, Attached(session = self(), attachment = state.attachment));
    let unwritten = match state.held {
        Some(bytes) -> {
            send(shell, Output(bytes));
            1
        }
      | None ->
            0
    };
    readNext(started,
             Serving(..state, attached = Some(shell), attachment = Joined, held = None, =unwritten))
}

// The attached shell detached, by its Detach or by its end; another
// shell's is dropped.
fn detached(state : Serving, process : Process) : Serving =
    match state.attached {
        Some(shell) when Process.fromAddress(shell) == process -> {
            demonitor(process);
            Serving(..state, attached = None, unwritten = 0)
        }
      | _ ->
            state
    }

// A piece of the program's output: written to the attached shell, whose
// Written then sends the next read, or held for the next shell attached.
fn output(state : Serving, bytes : Bytes) : Serving = {
    let read = Serving(..state, reading = false);
    match state.attached {
        Some(shell) -> {
            send(shell, Output(bytes));
            Serving(..read, unwritten = state.unwritten + 1)
        }
      | None ->
            Serving(..read, held = Some(bytes))
    }
}

// A piece written by the attached shell: the next read sent once the shell
// has written every piece it was told; a Written from a shell no longer
// attached is dropped.
fn writtenBy(started : Started, state : Serving, process : Process) : Serving =
    match state.attached {
        Some(shell) when Process.fromAddress(shell) == process && state.unwritten > 0 -> {
            let unwritten = state.unwritten - 1;
            let written = Serving(..state, =unwritten);
            if unwritten == 0 then readNext(started, written) else written
        }
      | _ ->
            state
    }

// The next read sent where a shell is attached and none is under way.
fn readNext(started : Started, state : Serving) : Serving =
    match state.attached {
        Some(_) when !state.reading -> {
            send(started.reader, Read);
            Serving(..state, reading = true)
        }
      | _ ->
            state
    }

// The keys given to the writer where no write is under way; otherwise held
// for its Wrote, joined to the keys held where together they come to no
// more than the message limit, and dropped where they would pass it.
fn typed(started : Started, state : Serving, bytes : Bytes) : Serving =
    if !state.writing then {
        send(started.writer, Write(bytes));
        Serving(..state, writing = true)
    } else if Bytes.size(state.keys) + Bytes.size(bytes) <= started.shell.messageLimit then
        Serving(..state, keys = state.keys <> bytes)
    else
        state

// A write done: the keys held given to the writer where there are any.
fn wrote(started : Started, state : Serving) : Serving =
    if Bytes.isEmpty(state.keys) then
        Serving(..state, writing = false)
    else {
        send(started.writer, Write(state.keys));
        Serving(..state, keys = <<>>)
    }

fn told(state : Serving, message : Told) : Unit =
    match state.attached {
        Some(shell) -> send(shell, message)
      | None -> Unit
    }

//
// The deadline
//

// The alarm set for the warning's time, `lifetime - warning` after the last
// key or Extend, or once warned for the end's time, `lifetime` after it.
fn alarmed(state : Serving, shell : Config.Shell, warned : Bool) : Serving receiving SessionMsg = {
    let time = due(state, shell, warned);
    let _ = Clock.alarm(Int.max(0, time - Clock.monotonic()), Alarm);
    Serving(..state, =warned, alarmAt = time)
}

fn due(state : Serving, shell : Config.Shell, warned : Bool) : Int =
    if warned then state.last + shell.lifetime else state.last + shell.lifetime - shell.warning

// The alarm fired: before its time, the time having moved, it is set again
// for the warning's time; at the warning's time the attached shell is told
// the seconds left and the alarm set for the end's; at the end's time the
// session ends with 4001.
fn rang(started : Started, state : Serving) : Unit receiving SessionMsg = {
    let shell = started.shell;
    if state.alarmAt < due(state, shell, state.warned) then
        serving(started, alarmed(state, shell, false))
    else if state.warned then
        ended(started, state, 4001)
    else {
        told(state, Warning(shell.warning / 1000));
        serving(started, alarmed(state, shell, true))
    }
}

//
// The end
//

// The end with the close code: the sessions called and the attached shell
// told, and the writer ended; then, the program not having exited, its
// terminal hung up and read through the reader until its Exited or the
// hangup's end, a read already under way reading on.
fn ended(started : Started, state : Serving, code : Int) : Unit receiving SessionMsg = {
    begun(started, state, code);
    kill(Process.fromAddress(started.writer));
    writerEnded();
    Os.closeInput(started.program);
    if state.reading then Unit else send(started.reader, Read);
    hungUp(started, code, Clock.monotonic() + started.shell.hangup)
}

// The end begun with the close code: the sessions called, so that the
// session's cookie names it no more and every attach they passed it stands
// in its mailbox, and the attached shell told the code.
fn begun(started : Started, state : Serving, code : Int) : Unit = {
    calledEnding(started.sessions, started.shell.hangup);
    told(state, Ended(code))
}

// The sessions called Ending with the session's process, within the
// hangup's milliseconds; a call that fails or is not answered in time is
// gone past, and the end goes on.
fn calledEnding(sessions : Address(Ending), hangup : Int) : Unit = {
    let _ = Address.call(sessions, fn(reply) = Ending(process = Process.current(), =reply), hangup);
    Unit
}

// The wait for the writer's end; what comes meanwhile waits in the
// mailbox for the end's next step, a read's answer among it.
fn writerEnded() : Unit receiving SessionMsg =
    receive {
        WriterEnded(_) -> Unit
    }

// The hung-up terminal read through the reader, a Read after each answer,
// until a read answers the program's Exited or the time passes, as
// Clock.monotonic counts; a reader that ends meanwhile leaves the program
// to be killed. A shell's attach meanwhile is told the end's code, and the
// rest is dropped.
fn hungUp(started : Started, code : Int, time : Int) : Unit receiving SessionMsg =
    receive {
        Answered(Right(Os.Exited(_))) ->
            stopped(started, code, true)
      | Answered(_) -> {
            send(started.reader, Read);
            hungUp(started, code, time)
        }
      | ReaderEnded(_) -> {
            kill(Process.fromAddress(started.program));
            drained(code)
        }
      | Attach(shell) -> {
            send(shell, Ended(code));
            hungUp(started, code, time)
        }
      | _ ->
            hungUp(started, code, time)
      | after Int.max(0, time - Clock.monotonic()) ->
            stopped(started, code, false)
    }

// The reader ended and waited for, and the program killed where it has not
// exited; then what waits in the mailbox taken, and the session returns.
fn stopped(started : Started, code : Int, exited : Bool) : Unit receiving SessionMsg = {
    kill(Process.fromAddress(started.reader));
    readerEnded(code);
    if exited then Unit else kill(Process.fromAddress(started.program));
    drained(code)
}

// The wait for the reader's end; a shell's attach meanwhile is told the
// end's code, and the rest is dropped.
fn readerEnded(code : Int) : Unit receiving SessionMsg =
    receive {
        ReaderEnded(_) ->
            Unit
      | Attach(shell) -> {
            send(shell, Ended(code));
            readerEnded(code)
        }
      | _ ->
            readerEnded(code)
    }

// What waits in the mailbox at the end, every attach the sessions passed
// before they answered the end's call among it: a shell's attach told the
// end's code, and the rest dropped.
fn drained(code : Int) : Unit receiving SessionMsg =
    receive {
        Attach(shell) -> {
            send(shell, Ended(code));
            drained(code)
        }
      | _ ->
            drained(code)
      | after 0 ->
            Unit
    }

//
// Tests
//

// What a test's process takes: what a shell is told, by the shell's name;
// the sessions' stand-in's word that a session called Ending, with its
// process; a session's call of Ending, where the test answers it; a
// session's end; and what a writer tells the test's process in its
// session's place.
type Seen =
    Heard(shell : String, told : Told)
  | EndingTold(Process)
  | EndingCalled(Ending)
  | SessionEnded(Down)
  | FromWriter(SessionMsg)

let timeouts : Config.Timeouts =
    Config.Timeouts(head = 5000, idle = 60000, write = 5000, file = 5000)

fn size(rows : Int, columns : Int) : Terminal.Size =
    Terminal.Size(=rows, =columns)

// The shell's configuration of the command with the lifetime, the warning
// and the hangup given.
fn configured(command : List(String), lifetime : Int, warning : Int, hangup : Int) : Config.Shell =
    Config.Shell(path = "/shell",
                 client = "/shell/client.js",
                 origins = ["http://localhost"],
                 =command,
                 mostAtOnce = 4,
                 starts = Config.Starts(count = 4, within = 60000),
                 =lifetime,
                 =warning,
                 messageLimit = 65536,
                 =hangup)

// A session of the command with the lifetime, the warning and the hangup
// given, under a terminal of 24 rows and 80 columns, spawned and monitored
// by the test's process, its Ending answered at once by a stand-in.
fn started(command : List(String),
           lifetime : Int,
           warning : Int,
           hangup : Int) : Address(SessionMsg) receiving Seen =
    startedUnder(configured(command, lifetime, warning, hangup), answering())

// A session of the shell's configuration, which calls Ending of the
// sessions given, spawned and monitored by the test's process.
fn startedUnder(shell : Config.Shell,
                sessions : Address(Ending)) : Address(SessionMsg) receiving Seen =
    spawnMonitored(fn() = serve(shell, timeouts, size(24, 80), sessions), SessionEnded)

// A stand-in for the sessions of one session, which answers its Ending at
// once and tells the test's process of it.
fn answering() : Address(Ending) receiving Seen = {
    let me = self();
    spawn(fn() = receive {
        Ending(=process, =reply) -> {
            answer(reply, Unit);
            send(me, EndingTold(process))
        }
    })
}

// A cat whose deadline is far.
fn cat() : Address(SessionMsg) receiving Seen =
    started(["cat"], 60000, 30000, 5000)

// A shell of the test's process, told what it is told under the name, which
// tells the session nothing of what it has written.
fn named(name : String) : Address(Told) receiving Seen =
    adapted(self(), fn(told) = Heard(shell = name, =told))

// A shell of a process of its own, which tells the test's process what it
// is told under the name, until it is ended, and tells the session nothing
// of what it has written.
fn standIn(name : String) : Address(Told) receiving Seen = {
    let me = self();
    spawn(fn() = forwarding(me, name))
}

fn forwarding(test : Address(Seen), name : String) : Unit receiving Told =
    receive {
        told -> {
            send(test, Heard(shell = name, =told));
            forwarding(test, name)
        }
    }

// A shell of a process of its own, which tells the test's process what it
// is told under the name and tells its session Written after each Output,
// as a shell does once the output is on its socket, until it is told Ended.
fn shell(name : String) : Address(Told) receiving Seen = {
    let me = self();
    spawn(fn() = writingShell(me, name, None))
}

fn writingShell(test : Address(Seen),
                name : String,
                session : Optional(Address(SessionMsg))) : Unit receiving Told =
    receive {
        Attached(session = attachedTo) as told -> {
            send(test, Heard(shell = name, =told));
            writingShell(test, name, Some(attachedTo))
        }
      | Output(_) as told -> {
            send(test, Heard(shell = name, =told));
            match session {
                Some(attachedTo) -> send(attachedTo, Written(self()))
              | None -> Unit
            };
            writingShell(test, name, session)
        }
      | Ended(_) as told ->
            send(test, Heard(shell = name, =told))
      | told -> {
            send(test, Heard(shell = name, =told));
            writingShell(test, name, session)
        }
    }

fn shown(told : Told) : String =
    match told {
        Attached(attachment = New) -> "Attached(New)"
      | Attached(attachment = Joined) -> "Attached(Joined)"
      | Unavailable -> "Unavailable"
      | Output(bytes) -> "Output(" <> Optional.withDefault(String.fromUtf8(bytes), "?") <> ")"
      | Warning(seconds) -> "Warning(" <> Int.toString(seconds) <> ")"
      | Ended(code) -> "Ended(" <> Int.toString(code) <> ")"
    }

// The next message the named shell is told, within 5000 milliseconds.
fn next(name : String) : String receiving Seen =
    receive {
        Heard(shell = from, =told) when from == name -> shown(told)
      | after 5000 -> "nothing"
    }

// The output the named shell is told, as text, until it holds the text,
// within 5000 milliseconds of each piece.
fn heard(name : String, text : String, acc : String) : String receiving Seen =
    if String.contains(acc, text) then
        acc
    else receive {
        Heard(shell = from, told = Output(bytes)) when from == name ->
            heard(name, text, acc <> Optional.withDefault(String.fromUtf8(bytes), "?"))
      | after 5000 ->
            acc <> " and nothing more"
    }

// What the named shell is told but output until its Ended, within 5000
// milliseconds of each.
fn messages(name : String) : List(String) receiving Seen =
    receive {
        Heard(shell = from, told = Output(_)) when from == name -> messages(name)
      | Heard(shell = from, told = Ended(code)) when from == name -> [shown(Ended(code))]
      | Heard(shell = from, told = message) when from == name -> shown(message) :: messages(name)
      | after 5000 -> ["nothing"]
    }

// The pieces of output the named shell is told before its Ended, which
// comes after every piece the session told it (report §6.4), and the
// Ended; within 5000 milliseconds of each.
fn outputsBefore(name : String, count : Int) : #(Int, String) receiving Seen =
    receive {
        Heard(shell = from, told = Output(_)) when from == name -> outputsBefore(name, count + 1)
      | Heard(shell = from, told = Ended(code)) when from == name -> #(count, shown(Ended(code)))
      | after 5000 -> #(count, "nothing")
    }

// The session's end, within 5000 milliseconds, and whether it called the
// sessions Ending, with its own process; the two come in no order (report
// §6.9).
fn sessionEnded() : String receiving Seen =
    receive {
        SessionEnded(down) ->
            receive {
                EndingTold(process) when process == down.process -> Io.show(down.reason)
              | after 5000 -> Io.show(down.reason) <> ", Ending untold"
            }
      | after 5000 ->
            "no end"
    }

// Whether the named shell has been told any output so far.
fn toldOutput(name : String) : Bool receiving Seen =
    receive {
        Heard(shell = from, told = Output(_)) when from == name -> true
      | after 0 -> false
    }

fn keys(text : String) : SessionMsg =
    Keys(String.toUtf8(text))

// The lines of the character, 400 of 79 and a line feed, 32000 bytes, more
// than a terminal whose program reads nothing takes, about 19000 bytes on
// the host the tests were written on, so that a write of them waits.
fn lines(char : String) : String =
    String.repeat(String.repeat(char, 79) <> "\n", 400)

// The live processes a session spawned in serve, its reader and its writer,
// doing the activity.
fn spawnedInServe(activity : Process.Activity) : List(Process) =
    List.filter(Process.live(), fn(process) = match Process.status(process) {
        Some(Process.Status(=site, activity = doing)) ->
            String.startsWith(site, "Session.serve:") && doing == activity
      | None ->
            false
    })

// Whether the session has taken what came and its reader waits for its
// next Read: the session, its reader and its writer each waiting with
// nothing in its mailbox, neither of the two in a read or a write.
fn readerWaits(session : Address(SessionMsg)) : Test.Result = {
    let idle = fn(process) = match Process.status(process) {
        Some(Process.Status(queued = 0, activity = Process.Receiving)) -> true
      | _ -> false
    };
    let helpers = spawnedInServe(Process.Receiving);
    if idle(Process.fromAddress(session)) && List.size(helpers) == 2 && List.all(helpers, idle) then
        Test.Passed
    else
        Test.Failed("the reader reads")
}

// Whether the session's reader waits in its read and its writer in its
// write: both of them calling.
fn writerWaits() : Test.Result =
    if List.size(spawnedInServe(Process.Calling)) == 2 then
        Test.Passed
    else
        Test.Failed("the writer does not wait in its write")

// design §12: the program's output is written to the attached shell, keys
// echoed; a shell detached is written nothing more, and the piece a read
// answered after the detach is held and written to the next shell attached,
// before what follows it.
let holdsForTheNext =
    Test.Case(name = "writes the output to the attached shell alone", run = fn() = {
        let session = cat();
        let one = shell("one");
        send(session, Attach(one));
        let attached = next("one");
        send(session, keys("alpha\n"));
        let echoed = heard("one", "alpha\r\nalpha\r\n", "");
        send(session, Detach(one));
        send(session, keys("beta\n"));
        let held = Test.until(fn() = readerWaits(session), 5000);
        let two = shell("two");
        send(session, Attach(two));
        let reattached = next("two");
        let first = next("two");
        let rest =
            heard("two",
                  "beta\r\nbeta\r\n",
                  String.replace(String.replace(first, "Output(", ""), ")", ""));
        let detachedOutput = toldOutput("one");
        send(session, End(1000));
        let end = next("two");
        kill(Process.fromAddress(one));
        Test.equal(#(attached,
                     echoed,
                     held,
                     reattached,
                     String.startsWith(first, "Output(beta"),
                     rest,
                     detachedOutput,
                     end,
                     sessionEnded()),
                   #("Attached(New)",
                     "alpha\r\nalpha\r\n",
                     Test.Passed,
                     "Attached(Joined)",
                     true,
                     "beta\r\nbeta\r\n",
                     false,
                     "Ended(1000)",
                     "Returned"))
    })

// design §12: the brake on reading: under `yes`, a shell attached that has
// not said it has written its output is told no second piece, the reader
// waiting for its next Read, and a Written from a shell no longer attached,
// one taken over, is dropped; the Ended the shell is told at a take-over
// comes after every piece the session told it, so none came. The attach
// sends a read at once, and the attached shell's Written the next.
let waitsForWritten = Test.Case(name = "reads on once its shell has written", run = fn() = {
    let session = started(["yes"], 60000, 30000, 5000);
    let first = standIn("first");
    send(session, Attach(first));
    let attachedFirst = next("first");
    let firstOutput = String.startsWith(next("first"), "Output(");
    let second = named("second");
    send(session, Attach(second));
    let takenOver = next("first");
    let attachedSecond = next("second");
    let secondOutput = String.startsWith(next("second"), "Output(");
    send(session, Written(first));
    let braked = Test.until(fn() = readerWaits(session), 5000);
    let third = named("third");
    send(session, Attach(third));
    let secondMore = outputsBefore("second", 0);
    let attachedThird = next("third");
    let thirdOutput = String.startsWith(next("third"), "Output(");
    send(session, Written(third));
    let readOn = String.startsWith(next("third"), "Output(");
    send(session, End(1000));
    let end = messages("third");
    kill(Process.fromAddress(first));
    Test.equal(#(attachedFirst,
                 firstOutput,
                 takenOver,
                 attachedSecond,
                 secondOutput,
                 braked,
                 secondMore,
                 attachedThird,
                 thirdOutput,
                 readOn,
                 end,
                 sessionEnded()),
               #("Attached(New)",
                 true,
                 "Ended(4002)",
                 "Attached(Joined)",
                 true,
                 Test.Passed,
                 #(0, "Ended(4002)"),
                 "Attached(Joined)",
                 true,
                 true,
                 ["Ended(1000)"],
                 "Returned"))
})

// design §12: keys are written to the program, and a resize resizes its
// terminal, which `stty size` under `sh -c` shows.
let writesAndResizes = Test.Case(name = "writes keys and resizes the terminal", run = fn() = {
    let session = started(["sh", "-c", "stty size; read line; stty size; cat"], 60000, 30000, 5000);
    send(session, Attach(shell("shell")));
    let attached = next("shell");
    let before = heard("shell", "24 80\r\n", "");
    send(session, Resize(size(30, 100)));
    send(session, keys("\n"));
    let resized = heard("shell", "30 100\r\n", "");
    send(session, keys("gamma\n"));
    let typed = heard("shell", "gamma\r\ngamma\r\n", "");
    send(session, End(1000));
    Test.equal(#(attached, before, resized, typed, next("shell"), sessionEnded()),
               #("Attached(New)",
                 "24 80\r\n",
                 "\r\n30 100\r\n",
                 "gamma\r\ngamma\r\n",
                 "Ended(1000)",
                 "Returned"))
})

// A program that reads nothing until its terminal is resized, and then
// copies what it reads, its terminal echoing nothing.
let readsAtResize : String =
    "stty -echo; trap 'kill $!; exec cat' WINCH; echo ready; sleep 30 & wait"

// What the program writes, read until it holds the text, within 5000
// milliseconds of each piece.
fn readUntil(program : Address(Os.ProgramMsg), text : String, acc : String) : String =
    if String.contains(acc, text) then
        acc
    else match Os.read(program, 5000) {
        Right(Os.Stdout(bytes)) ->
            readUntil(program, text, acc <> Optional.withDefault(String.fromUtf8(bytes), "?"))
      | other ->
            acc <> " then " <> Io.show(other)
    }

// design §12: a write that does not end within the deadline is not undone,
// so the writer waits for it, writing nothing, and tells Wrote only once
// the program has taken it: under a program that reads nothing until its
// terminal is resized, a write of 32000 bytes within 100 milliseconds is
// told no Wrote within four of them, and once the resize lets the program
// read, Wrote comes and the program has read the keys once; the next write
// is written and told as any.
let waitsOutATimedOutWrite = Test.Case(name = "waits out a write past its deadline", run = fn() = {
    let command = Os.command("sh", ["-c", readsAtResize]);
    match Os.startTerminal(command, size(24, 80)) {
        Right(program) -> {
            let ready = readUntil(program, "ready\r\n", "");
            let session = adapted(self(), FromWriter);
            let writer = spawn(fn() = writing(program, session, 100));
            let wrote = fn(ms) = receive {
                FromWriter(Wrote) -> "Wrote"
              | after ms -> "nothing"
            };
            send(writer, Write(String.toUtf8(lines("a"))));
            let early = wrote(400);
            let _ = Os.resize(program, size(30, 100));
            let late = wrote(5000);
            let a = String.replace(lines("a"), "\n", "\r\n");
            let read = readUntil(program, a, "");
            send(writer, Write(String.toUtf8("beta\n")));
            let again = wrote(5000);
            let beta = readUntil(program, "beta\r\n", "");
            kill(Process.fromAddress(writer));
            kill(Process.fromAddress(program));
            Test.equal(#(ready, early, late, read == a, again, beta),
                       #("ready\r\n", "nothing", "Wrote", true, "Wrote", "beta\r\n"))
        }
      | Left(error) ->
            Test.Failed(Io.show(error))
    }
})

// design §12: keys that come while a write is under way are held, joined,
// up to the message limit, given at its Wrote, and keys past the limit are
// dropped: under a program that reads nothing until its terminal is
// resized, a first write of 32000 bytes waits, keys of 32000 more are held
// at the limit of 32000 and keys after them dropped; the resize lets the
// program read, which then writes the first two and not the third, and
// keys after them are written.
let dropsKeysPastTheLimit =
    Test.Case(name = "holds keys while a write waits and drops them past the limit", run = fn() = {
        let session =
            startedUnder(Config.Shell(..configured(["sh", "-c", readsAtResize], 60000, 30000, 5000),
                                      messageLimit = 32000),
                         answering());
        send(session, Attach(shell("shell")));
        let attached = next("shell");
        let ready = heard("shell", "ready\r\n", "");
        send(session, keys(lines("a")));
        let waiting = Test.until(writerWaits, 5000);
        send(session, keys(lines("b")));
        send(session, keys("gamma\n"));
        send(session, Resize(size(30, 100)));
        let both = String.replace(lines("a") <> lines("b"), "\n", "\r\n");
        let written = heard("shell", both, "");
        send(session, keys("delta\n"));
        let typed = heard("shell", "delta\r\n", written);
        send(session, End(1000));
        Test.equal(#(attached,
                     ready,
                     waiting,
                     typed == both <> "delta\r\n",
                     next("shell"),
                     sessionEnded()),
                   #("Attached(New)", "ready\r\n", Test.Passed, true, "Ended(1000)", "Returned"))
    })

// design §12: the session's mailbox never waits on the program: under a
// program that reads nothing, keys of 32000 bytes keep the writer waiting
// in its write, and an End is taken at once, the writer ended, and the
// session ends well within the write deadline of 5000 milliseconds.
let endsWhileAWriteWaits = Test.Case(name = "ends at once while a write waits", run = fn() = {
    let session =
        started(["sh", "-c", "stty -echo; echo ready; exec sleep 30"], 60000, 30000, 5000);
    send(session, Attach(shell("shell")));
    let attached = next("shell");
    let ready = heard("shell", "ready\r\n", "");
    send(session, keys(lines("a")));
    let waiting = Test.until(writerWaits, 5000);
    let start = Clock.monotonic();
    send(session, End(1001));
    let end = next("shell");
    let ended = sessionEnded();
    let took = Clock.monotonic() - start;
    Test.equal(#(attached, ready, waiting, end, ended, took < 2000),
               #("Attached(New)", "ready\r\n", Test.Passed, "Ended(1001)", "Returned", true))
})

// design §12: an attach takes the session over: the shell attached before
// is told Ended with 4002, the new one Attached, and the output is written
// to the new one alone; a Detach from the one taken over is dropped.
let takesOver = Test.Case(name = "is taken over by a second shell", run = fn() = {
    let session = cat();
    let first = shell("first");
    send(session, Attach(first));
    let attachedFirst = next("first");
    let second = shell("second");
    send(session, Attach(second));
    let takenOver = next("first");
    let attachedSecond = next("second");
    send(session, Detach(first));
    send(session, keys("delta\n"));
    let typed = heard("second", "delta\r\ndelta\r\n", "");
    let firstOutput = toldOutput("first");
    send(session, End(1000));
    let end = next("second");
    Test.equal(#(attachedFirst, takenOver, attachedSecond, typed, firstOutput, end, sessionEnded()),
               #("Attached(New)",
                 "Ended(4002)",
                 "Attached(Joined)",
                 "delta\r\ndelta\r\n",
                 false,
                 "Ended(1000)",
                 "Returned"))
})

// design §12: an attach tells the shell Attached with New where no shell
// was attached to the session before, and with Joined otherwise: after the
// first shell's detach, and at a take-over.
let tellsTheAttachment =
    Test.Case(name = "tells its first shell New and the rest Joined", run = fn() = {
        let session = cat();
        let one = shell("one");
        send(session, Attach(one));
        let first = next("one");
        send(session, Detach(one));
        let two = shell("two");
        send(session, Attach(two));
        let second = next("two");
        send(session, Attach(shell("three")));
        let third = next("three");
        send(session, End(1000));
        kill(Process.fromAddress(one));
        Test.equal(#(first, second, next("two"), third, next("three"), sessionEnded()),
                   #("Attached(New)",
                     "Attached(Joined)",
                     "Ended(4002)",
                     "Attached(Joined)",
                     "Ended(1000)",
                     "Returned"))
    })

// design §12: the session ends with a close code, which the attached shell
// is told before the session returns: the visitor's Stop with 4004, the
// program's exit with 4004, its output written first, and an End with its
// code; each end, here and in every test, calls the sessions Ending with
// the session's process.
let endsWithCodes = Test.Case(name = "ends with a close code", run = fn() = {
    fn ending(command : List(String),
              message : Optional(SessionMsg)) : #(List(String), String) receiving Seen = {
        let session = started(command, 60000, 30000, 5000);
        send(session, Attach(shell("shell")));
        let attached = next("shell");
        match message {
            Some(sent) -> send(session, sent)
          | None -> Unit
        };
        #(attached :: messages("shell"), sessionEnded())
    };
    let exited = {
        let session = started(["sh", "-c", "echo bye"], 60000, 30000, 5000);
        send(session, Attach(shell("shell")));
        let attached = next("shell");
        let output = heard("shell", "bye\r\n", "");
        #([attached, output] <> messages("shell"), sessionEnded())
    };
    Test.equal([ending(["cat"], Some(Stop)), exited, ending(["cat"], Some(End(1001)))],
               [#(["Attached(New)", "Ended(4004)"], "Returned"),
                #(["Attached(New)", "bye\r\n", "Ended(4004)"], "Returned"),
                #(["Attached(New)", "Ended(1001)"], "Returned")])
})

// design §12: the end's call: an attach the sessions pass a session after
// its end has begun, before they answer its call, is told Ended with the
// end's code, not lost; a call that fails, its sessions having ended, is
// gone past at once, and one not answered within the hangup is gone past
// once the hangup has passed, the end going on in both.
let callsItsEnd = Test.Case(name = "tells an attach passed as its end begins", run = fn() = {
    let calling = adapted(self(), EndingCalled);
    let passed = {
        let session = startedUnder(configured(["true"], 60000, 30000, 5000), calling);
        send(session, Attach(shell("first")));
        let attached = next("first");
        let called = receive {
            EndingCalled(Ending(=process, =reply)) -> {
                send(session, Attach(shell("late")));
                answer(reply, Unit);
                process == Process.fromAddress(session)
            }
          | after 5000 ->
                false
        };
        #(attached, called, next("first"), next("late"), endOf())
    };
    fn gonePast(sessions : Address(Ending),
                hangup : Int) : #(String, String, Int) receiving Seen = {
        let session = startedUnder(configured(["true"], 60000, 30000, hangup), sessions);
        let start = Clock.monotonic();
        send(session, Attach(shell("past")));
        let attached = next("past");
        let end = next("past");
        let ended = endOf();
        #(attached <> " " <> end, ended, Clock.monotonic() - start)
    };
    let #(failedTold, failedEnd, failedTook) = gonePast(spawn(gone), 5000);
    let #(unansweredTold, unansweredEnd, unansweredTook) = gonePast(calling, 300);
    Test.equal(#(passed,
                 #(failedTold, failedEnd, failedTook < 2000),
                 #(unansweredTold, unansweredEnd, unansweredTook >= 300 && unansweredTook < 5000)),
               #(#("Attached(New)", true, "Ended(4004)", "Ended(4004)", "Returned"),
                 #("Attached(New) Ended(4004)", "Returned", true),
                 #("Attached(New) Ended(4004)", "Returned", true)))
})

// Sessions that have ended, or end before they answer.
fn gone() : Unit receiving Ending =
    Unit

// The session's end, within 5000 milliseconds, where the test's process
// itself was its sessions.
fn endOf() : String receiving Seen =
    receive {
        SessionEnded(down) -> Io.show(down.reason)
      | after 5000 -> "no end"
    }

// design §12: the deadline, by one alarm at a time: the attached shell is
// warned with the seconds left `lifetime - warning` after the start, and
// the session ends with 4001 `lifetime` after it; a key after the warning
// moves the time, and so does an Extend, so that the alarm at the end's old
// time is set again, the shell is warned again, and the end comes a
// lifetime after the key or the Extend.
let keepsTheDeadline = Test.Case(name = "warns and ends at its deadline", run = fn() = {
    let still = started(["cat"], 1100, 1000, 5000);
    send(still, Attach(shell("still")));
    let moved = started(["cat"], 700, 500, 5000);
    send(moved, Attach(shell("moved")));
    let extended = started(["cat"], 700, 500, 5000);
    send(extended, Attach(shell("extended")));
    let attached = #(next("still"), next("moved"), next("extended"));
    let warned = #(next("moved"), next("extended"));
    let key = Clock.monotonic();
    send(moved, keys("k"));
    send(extended, Extend);
    let movedTold = messages("moved");
    let afterKey = Clock.monotonic() - key;
    let extendedTold = messages("extended");
    let afterExtend = Clock.monotonic() - key;
    let stillTold = messages("still");
    Test.equal(#(attached,
                 warned,
                 movedTold,
                 afterKey >= 700,
                 extendedTold,
                 afterExtend >= 700,
                 stillTold,
                 List.map([1, 2, 3], fn(_) = sessionEnded())),
               #(#("Attached(New)", "Attached(New)", "Attached(New)"),
                 #("Warning(0)", "Warning(0)"),
                 ["Warning(0)", "Ended(4001)"],
                 true,
                 ["Warning(0)", "Ended(4001)"],
                 true,
                 ["Warning(1)", "Ended(4001)"],
                 ["Returned", "Returned", "Returned"]))
})

// design §12: a command that cannot start is said on standard error, and
// the session ends with 4003 at its attach.
let refusesAnUnstartedCommand =
    Test.Case(name = "ends with 4003 where its command cannot start", run = fn() = {
        let session = started(["no-such-program-of-ernest-httpd"], 60000, 30000, 5000);
        send(session, Attach(shell("shell")));
        Test.equal(#(next("shell"), sessionEnded()), #("Ended(4003)", "Returned"))
    })

// design §12: at the end a program that does not exit at the hangup of its
// terminal is given the hangup's milliseconds and then killed.
let killsAtTheHangup = Test.Case(name = "kills a program that outlives the hangup", run = fn() = {
    let session = started(["sh", "-c", "trap '' HUP; echo ready; sleep 30"], 60000, 30000, 300);
    send(session, Attach(shell("shell")));
    let attached = next("shell");
    let ready = heard("shell", "ready\r\n", "");
    let start = Clock.monotonic();
    send(session, End(1000));
    let end = next("shell");
    let ended = sessionEnded();
    let took = Clock.monotonic() - start;
    Test.equal(#(attached, ready, end, ended, took >= 300 && took < 5000),
               #("Attached(New)", "ready\r\n", "Ended(1000)", "Returned", true))
})

// design §12: a reader that ends before the end, its read having faulted,
// ends the session with 1011, and so does a writer: of a session of `cat`,
// the reader waits in its read and the writer for its next write.
let endsWithItsHelpers =
    Test.Case(name = "ends with 1011 when its reader or its writer ends", run = fn() = {
        fn ending(activity : Process.Activity) : #(String, String, String) receiving Seen = {
            let session = cat();
            send(session, Attach(shell("shell")));
            let attached = next("shell");
            let settled =
                Test.until(fn() =
                               if List.size(spawnedInServe(Process.Calling)) == 1
                                   && List.size(spawnedInServe(Process.Receiving)) == 1 then
                                   Test.Passed
                               else
                                   Test.Failed("the reader does not wait in its read"),
                           5000);
            List.forEach(spawnedInServe(activity), kill);
            #(attached <> " " <> Io.show(settled), next("shell"), sessionEnded())
        };
        Test.equal([ending(Process.Calling), ending(Process.Receiving)],
                   [#("Attached(New) Test.Passed", "Ended(1011)", "Returned"),
                    #("Attached(New) Test.Passed", "Ended(1011)", "Returned")])
    })

// design §12: a write that fails is dropped, its Exited being read: keys
// written as the program exits end nothing but the session, with 4004. A
// regression test, written after Ernest made such a write answer
// Left(Closed); it cannot tell a write that lands before the exit from one
// after it, and asserts the session's end alone.
let dropsKeysAtTheExit = Test.Case(name = "drops keys written as its program exits", run = fn() = {
    let session = started(["sh", "-c", "read line; exit 0"], 60000, 30000, 5000);
    send(session, Attach(shell("shell")));
    let attached = next("shell");
    send(session, keys("go\n"));
    send(session, keys("late"));
    Test.equal(#(attached, messages("shell"), sessionEnded()),
               #("Attached(New)", ["Ended(4004)"], "Returned"))
})
