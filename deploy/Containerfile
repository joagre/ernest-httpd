# The shell's image, ernest-shell (docs/design.md §13): the Erlang image of
# the OTP release Ernest runs on, 29, with Ernest installed from its release
# archive, given to the build as ern.tar.gz beside this file, a user shell,
# whose home is where a session's nodes start, the two nodes' configuration
# directories, and the shell's start, shell-start.sh beside this file, as
# its command. It holds nothing secret; the session's command runs it with
# no network.
#
#   podman build -t ernest-shell .    in a directory of this file,
#                                     shell-start.sh and ern.tar.gz

FROM docker.io/library/erlang:29.1.2.0-slim

# make install from the unpacked archive, under /usr/local: `ern` on PATH,
# the standard library, Ernest's libraries and share/doc/ernest, its
# examples among it. make and a C compiler build the helper Os.run runs a
# program through, and go once it is built.
RUN --mount=type=bind,source=ern.tar.gz,target=/tmp/ern.tar.gz \
    apt-get update \
 && apt-get install -y --no-install-recommends make gcc libc6-dev \
 && mkdir /tmp/ern \
 && tar -xzf /tmp/ern.tar.gz -C /tmp/ern --strip-components=1 \
 && make -C /tmp/ern install PREFIX=/usr/local \
 && apt-get purge -y --auto-remove make gcc libc6-dev \
 && rm -rf /tmp/ern /var/lib/apt/lists/*

# The user, and the directory its two nodes' configurations stand in, its
# own, so that the nodes take them.
RUN useradd --create-home --home-dir /home/shell --shell /bin/sh shell \
 && install -d -o shell -g shell -m 0755 /usr/local/share/ernest-shell

COPY --chmod=0755 shell-start.sh /usr/local/bin/shell-start

USER shell
WORKDIR /home/shell

# The two nodes, a, which only dials, and foo, listening on the loopback,
# each listing the other, and each holding the limits that fit two in the
# container's memory, written in at the object's opening line, the image
# having sed and no JSON tool.
RUN cd /usr/local/share/ernest-shell \
 && ern config --config-dir a > /dev/null \
 && ern config --config-dir foo --listen 127.0.0.1:8655 > /dev/null \
 && ern config --config-dir a --peer-dir foo \
 && ern config --config-dir foo --peer-dir a \
 && for node in a foo; do \
        sed -i '1s/^{$/&\n  "limits": {"processes": 65536, "ports": 4096},/' "$node/ernest.conf" \
     && grep -q '^  "limits": {"processes": 65536, "ports": 4096},$' "$node/ernest.conf" \
     || exit 1; \
    done

CMD ["shell-start"]
